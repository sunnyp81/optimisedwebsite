---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import GrowthChart from '../components/GrowthChart.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { portfolio } from '../data/portfolio';

const chartColors = ['#10b981', '#7c3aed', '#3b82f6', '#f59e0b', '#ef4444'];

const schemaNodes = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/portfolio/#page`,
    name: 'Portfolio: SEO Websites We Have Built',
    description: 'Examples of SEO-optimised websites built by OptimisedWebsite. Each site features topical authority architecture, per-page schema, and technical SEO foundations.',
    url: `${site.url}/portfolio/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: portfolio.length,
      itemListElement: portfolio.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: item.name,
          url: item.url,
          description: item.description,
          creator: { '@id': `${site.url}/#organization` }
        }
      }))
    }
  }
];
---
<Base
  title="Portfolio: SEO Websites We Have Built | OptimisedWebsite"
  description="Examples of SEO-optimised websites built by OptimisedWebsite. Each site features topical authority architecture, per-page schema, and technical SEO foundations."
  canonicalPath="/portfolio/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Portfolio', href: '/portfolio/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">Portfolio</div>
      <h1 class="section-title">SEO Websites We Have Built</h1>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink-2);">
        Every site below was built from the ground up with keyword research, topical mapping, and per-page schema markup. These are not redesigns or template installs — each one is a purpose-built SEO asset constructed to rank in its niche.
      </p>
    </section>

    <section class="pb-16">
      <div class="grid gap-6 md:grid-cols-2">
        {portfolio.map((item, i) => (
          <div>
            <PortfolioCard item={item} />
            <div class="mt-[-1px] mx-1 rounded-b-[16px] p-4" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule); border-top: none;">
              <GrowthChart data={item.growth} label={`${item.name} — impressions (k/mo)`} color={chartColors[i % chartColors.length]} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="py-12 text-center">
      <p class="mb-6 text-lg" style="color: var(--color-ink-2);">Ready to add your site to this list?</p>
      <CTA href="/order/" label="Order Your SEO Website" />
    </section>
  </div>
</Base>

<script>
  document.querySelectorAll('.growth-chart-wrap').forEach(wrap => {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add('drawn');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.3 });
    obs.observe(wrap);
  });
</script>
