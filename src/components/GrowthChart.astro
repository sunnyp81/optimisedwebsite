---
// Monthly impressions line: monotone curve that draws in, a lit dot on the latest month,
// the peak marked when it is not the latest month, and a pointer readout. Final values are in the HTML.
import { growthMonths } from '../data/portfolio';

interface Props {
  data: number[];
  label: string;
  color?: string;
  height?: number;
  months?: string[];
}
const { data, label, color = '#7c3aed', height = 120, months = growthMonths } = Astro.props;

const n = data.length;
const w = 320;
const h = Math.max(96, height);
const pad = { top: 28, right: 16, bottom: 10, left: 8 };
const cw = w - pad.left - pad.right;
const ch = h - pad.top - pad.bottom;
const max = Math.max(...data, 1) * 1.08;

const xs = data.map((_, i) => pad.left + (n > 1 ? (i / (n - 1)) * cw : cw / 2));
const ys = data.map((v) => pad.top + ch - (v / max) * ch);

// Steffen monotone tangents: the curve never overshoots, so the top of the line is the highest month.
const step = n > 1 ? cw / (n - 1) : 1;
const sl = ys.slice(0, -1).map((y, i) => (ys[i + 1] - y) / step);
const tan = ys.map((_, i) => {
  if (i === 0) return sl[0] ?? 0;
  if (i === n - 1) return sl[n - 2] ?? 0;
  const a = sl[i - 1], b = sl[i];
  return (Math.sign(a) + Math.sign(b)) * Math.min(Math.abs(a), Math.abs(b), 0.5 * Math.abs(a + b));
});
const f = (v: number) => v.toFixed(1);
let line = `M${f(xs[0])},${f(ys[0])}`;
for (let i = 0; i < n - 1; i++) {
  const d = step / 3;
  line += ` C${f(xs[i] + d)},${f(ys[i] + tan[i] * d)} ${f(xs[i + 1] - d)},${f(ys[i + 1] - tan[i + 1] * d)} ${f(xs[i + 1])},${f(ys[i + 1])}`;
}
const base = pad.top + ch;
const area = `${line} L${f(xs[n - 1])},${base} L${f(xs[0])},${base} Z`;

const fmt = (v: number) => (v >= 1000 ? `${(v / 1000).toFixed(v >= 100000 ? 0 : 1)}k` : v.toLocaleString('en-GB'));
const monthName = (ym: string, long = false) =>
  new Date(`${ym}-01T12:00:00Z`).toLocaleDateString('en-GB', { month: long ? 'long' : 'short', year: 'numeric', timeZone: 'UTC' });

const last = n - 1;
const peak = data.indexOf(Math.max(...data));
const showPeak = peak !== last && data[peak] > data[last] * 1.1;
const uid = `gc-${Math.random().toString(36).slice(2, 8)}`;
const points = data.map((v, i) => ({ x: xs[i], y: ys[i], v: fmt(v), m: monthName(months[i] ?? '') }));
---
<figure class="gc" style={`--c: ${color};`} data-gc data-points={JSON.stringify(points)} data-w={w}>
  <div class="gc-head">
    <span class="gc-val" data-target={data[last]}>{fmt(data[last])}</span>
    <span class="gc-cap">{label}, {monthName(months[last] ?? '')}</span>
  </div>
  <div class="gc-plot">
    <svg viewBox={`0 0 ${w} ${h}`} aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={`${uid}-area`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color={color} stop-opacity="0.26" />
          <stop offset="1" stop-color={color} stop-opacity="0" />
        </linearGradient>
        <linearGradient id={`${uid}-line`} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color={color} stop-opacity="0.35" />
          <stop offset="0.7" stop-color={color} stop-opacity="0.85" />
          <stop offset="1" stop-color={color} stop-opacity="1" />
        </linearGradient>
      </defs>
      {[0.25, 0.5, 0.75].map((t) => (
        <line x1={pad.left} x2={w - pad.right} y1={f(pad.top + ch * t)} y2={f(pad.top + ch * t)} class="gc-grid" />
      ))}
      {xs.map((x) => <line x1={f(x)} x2={f(x)} y1={pad.top} y2={base} class="gc-grid gc-grid-v" />)}
      <path d={area} fill={`url(#${uid}-area)`} class="gc-area" />
      <path d={line} class="gc-glow" stroke={color} pathLength="1" />
      <path d={line} class="gc-line" stroke={`url(#${uid}-line)`} pathLength="1" />
      <line class="gc-guide" x1="0" x2="0" y1={pad.top} y2={base} />
    </svg>
    {showPeak && (
      <span class="gc-peak" style={`left: ${((xs[peak] / w) * 100).toFixed(2)}%; top: ${((ys[peak] / h) * 100).toFixed(2)}%;`}>
        <span class="gc-peak-label">Peak {fmt(data[peak])}, {monthName(months[peak] ?? '').split(' ')[0]}</span>
      </span>
    )}
    <span class="gc-dot" style={`left: ${((xs[last] / w) * 100).toFixed(2)}%; top: ${((ys[last] / h) * 100).toFixed(2)}%;`}></span>
    <span class="gc-hover" aria-hidden="true"></span>
    <span class="gc-read" aria-hidden="true"><b></b> <i></i></span>
  </div>
  <div class="gc-axis" aria-hidden="true">
    <span>{monthName(months[0] ?? '')}</span>
    <span>{monthName(months[last] ?? '')}</span>
  </div>
  <table class="sr-only">
    <caption>{label}</caption>
    <tbody>
      {points.map((p, i) => (
        <tr><th scope="row">{p.m}</th><td>{data[i].toLocaleString('en-GB')}</td></tr>
      ))}
    </tbody>
  </table>
</figure>

<style>
  .gc {
    position: relative;
    margin: 0.75rem 0 0;
    width: 100%;
    --c-soft: color-mix(in srgb, var(--c) 14%, transparent);
  }
  .gc-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .gc-val {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .gc-cap {
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--color-ink-2);
  }
  .gc-plot {
    position: relative;
    border-radius: 14px;
    overflow: visible;
    background:
      radial-gradient(70% 90% at 96% 8%, color-mix(in srgb, var(--c) 16%, transparent), transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--c) 5%, var(--color-paper)), var(--color-paper));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 18%, var(--color-rule));
    touch-action: pan-y;
    cursor: crosshair;
  }
  .gc-plot svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .gc-grid {
    stroke: color-mix(in srgb, var(--c) 22%, var(--color-rule));
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
    opacity: 0.45;
  }
  .gc-grid-v { opacity: 0.22; }
  .gc-line, .gc-glow {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .gc-line { stroke-width: 2.4; }
  .gc-glow { stroke-width: 8; opacity: 0.2; filter: blur(3px); }
  .gc-area { opacity: 0; }
  .gc-guide {
    stroke: color-mix(in srgb, var(--c) 55%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  .gc-dot, .gc-hover {
    position: absolute;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 0 0 2.5px var(--c), 0 0 0 7px var(--c-soft), 0 0 18px 4px color-mix(in srgb, var(--c) 45%, transparent);
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
  }
  .gc-dot::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--c);
    opacity: 0;
  }
  .gc-hover { z-index: 2; }
  .gc-peak {
    position: absolute;
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 0 0 1.5px var(--c);
    opacity: 0;
    pointer-events: none;
  }
  .gc-peak-label {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-ink-2);
    background: color-mix(in srgb, var(--color-paper) 85%, transparent);
    padding: 1px 6px;
    border-radius: 999px;
  }
  .gc-read {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-size: 0.72rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 12px));
  }
  .gc-read b { font-weight: 700; font-variant-numeric: tabular-nums; }
  .gc-read i { font-style: normal; opacity: 0.75; }
  .gc-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.35rem;
    font-size: 0.7rem;
    color: var(--color-ink-3);
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* Drawn state (added on scroll, or straight away without motion). */
  .gc.drawn .gc-line, .gc.drawn .gc-glow {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .gc.drawn .gc-area { opacity: 1; transition: opacity 0.9s ease 0.6s; }
  .gc.drawn .gc-dot {
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.25s ease 1.45s, transform 0.5s cubic-bezier(0.34, 1.8, 0.5, 1) 1.45s;
  }
  .gc.drawn .gc-dot::after { animation: gc-ping 1.1s ease-out 1.7s 1 both; }
  .gc.drawn .gc-peak { opacity: 1; transition: opacity 0.4s ease 1.2s; }
  @keyframes gc-ping {
    0% { opacity: 0.7; transform: scale(1); }
    100% { opacity: 0; transform: scale(3.2); }
  }
  .gc.hovering .gc-hover, .gc.hovering .gc-read, .gc.hovering .gc-guide { opacity: 1; }
  .gc.hovering .gc-hover { transform: scale(1); }
  .gc.hovering .gc-dot { opacity: 0.35; }

  @media (prefers-reduced-motion: reduce) {
    .gc .gc-line, .gc .gc-glow { stroke-dashoffset: 0; transition: none; }
    .gc .gc-area, .gc .gc-peak { opacity: 1; transition: none; }
    .gc .gc-dot { opacity: 1; transform: none; transition: none; }
    .gc .gc-dot::after { animation: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (v: number) => (v >= 1000 ? `${(v / 1000).toFixed(v >= 100000 ? 0 : 1)}k` : Math.round(v).toLocaleString('en-GB'));
  document.querySelectorAll<HTMLElement>('[data-gc]:not([data-gc-bound])').forEach((fig) => {
    fig.setAttribute('data-gc-bound', '');
    const val = fig.querySelector<HTMLElement>('.gc-val');
    const target = Number(val?.dataset.target ?? 0);
    const draw = () => {
      fig.classList.add('drawn');
      if (reduce || !val || !target) return;
      const t0 = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / 1500);
        val.textContent = fmt(target * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(tick);
        else val.textContent = fmt(target);
      };
      requestAnimationFrame(tick);
    };
    if (reduce || !('IntersectionObserver' in window)) draw();
    else {
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { draw(); io.disconnect(); }
      }, { threshold: 0.35 });
      io.observe(fig);
    }

    const plot = fig.querySelector<HTMLElement>('.gc-plot');
    const hover = fig.querySelector<HTMLElement>('.gc-hover');
    const read = fig.querySelector<HTMLElement>('.gc-read');
    const guide = fig.querySelector<SVGLineElement>('.gc-guide');
    const pts: { x: number; y: number; v: string; m: string }[] = JSON.parse(fig.dataset.points || '[]');
    const W = Number(fig.dataset.w || 320);
    const svg = plot?.querySelector('svg');
    if (!plot || !hover || !read || !guide || !svg || !pts.length) return;
    const H = svg.viewBox.baseVal.height;
    const move = (e: PointerEvent) => {
      const r = plot.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width) * W;
      let i = 0;
      for (let k = 1; k < pts.length; k++) if (Math.abs(pts[k].x - x) < Math.abs(pts[i].x - x)) i = k;
      const p = pts[i];
      const lx = `${(p.x / W) * 100}%`, ty = `${(p.y / H) * 100}%`;
      hover.style.left = lx; hover.style.top = ty;
      read.style.left = lx; read.style.top = ty;
      read.querySelector('b')!.textContent = p.v;
      read.querySelector('i')!.textContent = p.m;
      guide.setAttribute('x1', String(p.x)); guide.setAttribute('x2', String(p.x));
      fig.classList.add('hovering');
    };
    plot.addEventListener('pointermove', move);
    plot.addEventListener('pointerdown', move);
    plot.addEventListener('pointerleave', () => fig.classList.remove('hovering'));
  });
</script>
