---
interface Props {
  faqs: { q: string; a: string }[];
}

const { faqs } = Astro.props;
---
<section class="py-12">
  <h2 class="text-2xl font-bold text-brand mb-6">Frequently Asked Questions</h2>
  <dl class="space-y-6">
    {faqs.map((faq) => (
      <div>
        <dt class="text-lg font-semibold text-text">{faq.q}</dt>
        <dd class="mt-2 text-text-muted leading-relaxed">{faq.a}</dd>
      </div>
    ))}
  </dl>
</section>
