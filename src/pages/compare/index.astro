---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const articles = await getCollection('compare');
articles.sort((a, b) => a.data.title.localeCompare(b.data.title));

const schemaNodes = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/compare/#webpage`,
    name: 'Compare SEO Website Options',
    description: 'Side-by-side comparisons of SEO website approaches, platforms, and build options for UK businesses.',
    url: `${site.url}/compare/`,
    isPartOf: { '@id': `${site.url}/#website` },
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'ItemList',
    '@id': `${site.url}/compare/#itemlist`,
    name: 'SEO Website Comparisons',
    numberOfItems: articles.length,
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.data.title,
      url: `${site.url}/compare/${a.id}/`,
    })),
  },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compare', href: '/compare/' },
];
---
<Base
  title="Compare SEO Website Options | OptimisedWebsite"
  description="Side-by-side comparisons of SEO website approaches, platforms, and build options for UK businesses."
  canonicalPath="/compare/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <section class="py-12">
      <div class="section-tag">Compare</div>
      <h1 class="section-title">Compare SEO Website Options</h1>
      <p class="section-desc max-w-3xl">
        Honest comparisons between different approaches to building an SEO-optimised website. We break down platforms, build methods, and cost structures so you can pick the right path for your business.
      </p>
    </section>

    <!-- Quick comparison table -->
    <section class="pb-12 reveal">
      <div class="card overflow-hidden" style="padding: 0;">
        <div class="overflow-x-auto">
          <table class="w-full text-[14px] min-w-[600px]">
            <thead>
              <tr style="border-bottom: 1px solid var(--color-rule); background: var(--color-bg-2);">
                <th class="text-left px-6 py-4 font-medium" style="color: var(--color-ink-3); width: 35%;">Feature</th>
                <th class="px-6 py-4 font-semibold text-center" style="color: var(--color-accent-2); background: rgba(124,58,237,0.04);">OptimisedWebsite</th>
                <th class="px-6 py-4 font-medium text-center" style="color: var(--color-ink-3);">DIY builders</th>
                <th class="px-6 py-4 font-medium text-center" style="color: var(--color-ink-3);">Traditional agency</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--color-rule);">
                <td class="px-6 py-3.5 font-medium" style="color: var(--color-ink-2);">Performance QA before handover</td>
                <td class="px-6 py-3.5 text-center font-semibold" style="color: var(--color-accent-2);">Included</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Self-managed</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Depends on provider</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--color-rule); background: var(--color-bg-2);">
                <td class="px-6 py-3.5 font-medium" style="color: var(--color-ink-2);">Page output</td>
                <td class="px-6 py-3.5 text-center font-semibold" style="color: var(--color-accent-2);">Static HTML by default</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Platform-dependent</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Stack-dependent</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--color-rule);">
                <td class="px-6 py-3.5 font-medium" style="color: var(--color-ink-2);">Delivery time</td>
                <td class="px-6 py-3.5 text-center font-semibold" style="color: var(--color-accent-2);">7 days</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Self-managed</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Depends on scope</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--color-rule); background: var(--color-bg-2);">
                <td class="px-6 py-3.5 font-medium" style="color: var(--color-ink-2);">Cost</td>
                <td class="px-6 py-3.5 text-center font-semibold" style="color: var(--color-accent-2);">£1,500–£3,000</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">£0 + your time</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Quote-based</td>
              </tr>
              <tr style="border-bottom: 1px solid var(--color-rule);">
                <td class="px-6 py-3.5 font-medium" style="color: var(--color-ink-2);">You own the code</td>
                <td class="px-6 py-3.5 text-center font-semibold" style="color: #10b981;">Yes</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Usually platform-bound</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Depends on contract</td>
              </tr>
              <tr>
                <td class="px-6 py-3.5 font-medium" style="color: var(--color-ink-2);">SEO architecture included</td>
                <td class="px-6 py-3.5 text-center font-semibold" style="color: #10b981;">Yes</td>
                <td class="px-6 py-3.5 text-center" style="color: #ef4444;">No</td>
                <td class="px-6 py-3.5 text-center" style="color: var(--color-ink-3);">Sometimes</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <h2 class="text-xl font-bold mb-6" style="color: var(--color-ink);">Detailed comparisons</h2>

    <section class="pb-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 reveal">
      {articles.map((article) => (
        <a
          href={`/compare/${article.id}/`}
          class="block rounded-[16px] p-6 no-underline transition-all duration-300"
          style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);"
          onmouseover="this.style.boxShadow='inset 0 0 0 1px rgba(124,58,237,0.3), 0 4px 16px rgba(30,41,59,0.1)'; this.style.transform='translateY(-2px)';"
          onmouseout="this.style.boxShadow='inset 0 0 0 1px var(--color-rule), 0 1px 3px rgba(30,41,59,0.08)'; this.style.transform='';"
        >
          <h2 class="text-lg font-bold mb-2" style="color: var(--color-ink);">{article.data.title}</h2>
          <p class="text-sm" style="color: var(--color-ink-2);">{article.data.metaDescription}</p>
        </a>
      ))}
    </section>

    <div class="py-8 flex flex-wrap gap-3">
      <CTA href="/free-website-growth-review/" label="Get a Free Growth Review" analyticsEvent="cta_click" analyticsLabel="compare-hub" />
      <CTA href="/learn/" label="Learn About SEO" variant="secondary" />
    </div>
  </div>
</Base>
