---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';

const schemaNodes = [
  {
    '@type': 'Service',
    '@id': `${site.url}/order/#service`,
    name: 'SEO Website Build — Order',
    description: 'Order an SEO-optimised website build. Fill in your brief and we will confirm scope within 24 hours.',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United Kingdom' }
  }
];
---
<Base
  title="Order Your SEO Website | OptimisedWebsite"
  description="Fill in your brief to order an SEO-optimised website. We confirm scope within 24 hours and deliver within 5-7 working days."
  canonicalPath="/order/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[700px] mx-auto px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Order', href: '/order/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">Order</div>
      <h1 class="section-title">Order Your SEO Website</h1>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink-2);">
        Fill in the brief below. We review every submission manually and confirm scope, timeline, and price within 24 hours. No payment is taken until you approve the plan.
      </p>
    </section>

    <section class="py-10" id="order-form-section">
      <form id="order-form" class="space-y-6" novalidate>
        <div>
          <label for="name" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Name <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Email <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="phone" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Phone <span class="font-normal" style="color: var(--color-ink-2);">(optional)</span></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="niche" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Niche / Industry <span class="text-red-500">*</span></label>
          <input type="text" id="niche" name="niche" required placeholder="e.g. Home insurance, Personal training, SaaS" class="w-full rounded-[12px] px-4 py-3 placeholder:text-text-dimmer focus:outline-none focus:ring-2 focus:ring-brand" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="audience" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Target Audience <span class="font-normal" style="color: var(--color-ink-2);">(optional)</span></label>
          <input type="text" id="audience" name="audience" placeholder="e.g. UK homeowners, B2B decision makers" class="w-full rounded-[12px] px-4 py-3 placeholder:text-text-dimmer focus:outline-none focus:ring-2 focus:ring-brand" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="domain" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Domain <span class="font-normal" style="color: var(--color-ink-2);">(optional)</span></label>
          <input type="text" id="domain" name="domain" placeholder="e.g. example.co.uk" class="w-full rounded-[12px] px-4 py-3 placeholder:text-text-dimmer focus:outline-none focus:ring-2 focus:ring-brand" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="competitors" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Competitors <span class="font-normal" style="color: var(--color-ink-2);">(optional)</span></label>
          <textarea id="competitors" name="competitors" rows="3" placeholder="List competitor websites, one per line" class="w-full rounded-[12px] px-4 py-3 placeholder:text-text-dimmer focus:outline-none focus:ring-2 focus:ring-brand" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);"></textarea>
        </div>

        <div>
          <label for="budget" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Budget</label>
          <select id="budget" name="budget" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);">
            <option value="1500-2000">&pound;1,500 &ndash; &pound;2,000</option>
            <option value="2000-2500">&pound;2,000 &ndash; &pound;2,500</option>
            <option value="2500-3000">&pound;2,500 &ndash; &pound;3,000</option>
          </select>
        </div>

        <input type="hidden" name="source" value="optimisedwebsite.com" />

        <!-- Honeypot -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn-glow">
          Submit Brief
        </button>
      </form>

      <div id="order-success" class="hidden py-10">
        <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Brief received</h2>
        <p class="leading-relaxed" style="color: var(--color-ink-2);">We will review your brief and reply within 24 hours to confirm scope, timeline, and price. Check your inbox (and spam folder) for our response.</p>
      </div>
    </section>
  </div>
</Base>

<script>
  const form = document.getElementById('order-form') as HTMLFormElement;
  const successDiv = document.getElementById('order-success') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    // Honeypot check
    if (data.get('website')) return;

    const body: Record<string, string> = {};
    data.forEach((v, k) => { if (k !== 'website') body[k] = v as string; });

    try {
      const res = await fetch('https://aaa-intake.sunnypat81.workers.dev', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(`${res.status}`);
      form.classList.add('hidden');
      successDiv.classList.remove('hidden');
    } catch {
      alert('Something went wrong. Please email hello@optimisedwebsite.com directly.');
    }
  });
</script>
