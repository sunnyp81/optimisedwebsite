---
interface Bucket {
  label: string;
  count: number;
  color: string;
}
interface Props {
  buckets: Bucket[];
  title?: string;
}
const { buckets, title = 'Ranking keywords by position' } = Astro.props;

const total = buckets.reduce((sum, b) => sum + b.count, 0);
const W = 320;
const barH = 26;
const gap = 1.5;

// Pre-compute each segment's x offset and width within the bar.
let cursor = 0;
const segments = buckets.map((b) => {
  const w = (b.count / total) * W;
  const seg = { ...b, x: cursor, w: Math.max(w - gap, 0) };
  cursor += w;
  return seg;
});

const gid = `rb-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="rank-breakdown" id={gid}>
  <div class="rb-head">
    <h4 class="rb-title">{title}</h4>
    <div class="rb-total">
      <span class="rb-total-num" data-target={total}>0</span>
      <span class="rb-total-label">keywords</span>
    </div>
  </div>

  <svg viewBox={`0 0 ${W} ${barH}`} class="rb-bar" preserveAspectRatio="none" role="img" aria-label={`${title}: ${total} keywords total`}>
    <defs>
      <clipPath id={`${gid}-round`}>
        <rect x="0" y="0" width={W} height={barH} rx={barH / 2} />
      </clipPath>
    </defs>
    <g clip-path={`url(#${gid}-round)`}>
      <rect x="0" y="0" width={W} height={barH} fill="var(--color-rule)" />
      {segments.map((s) => (
        <rect class="rb-seg" x={s.x} y="0" width={s.w} height={barH} fill={s.color} />
      ))}
    </g>
  </svg>

  <div class="rb-legend">
    {buckets.map((b) => (
      <div class="rb-leg-item">
        <span class="rb-dot" style={`background: ${b.color};`}></span>
        <span class="rb-leg-label">{b.label}</span>
        <span class="rb-leg-count" data-target={b.count}>0</span>
      </div>
    ))}
  </div>
</div>

<style>
  .rank-breakdown {
    padding: 1.5rem;
    border-radius: 16px;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);
  }
  .rb-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .rb-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }
  .rb-total {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .rb-total-num {
    font-family: var(--font-display), serif;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .rb-total-label {
    font-family: var(--font-mono), monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-3);
  }
  .rb-bar {
    width: 100%;
    height: 26px;
    display: block;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rank-breakdown.animated .rb-bar {
    transform: scaleX(1);
  }
  .rb-legend {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 1.25rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-rule);
  }
  .rb-leg-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
  }
  .rb-dot {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .rb-leg-label {
    color: var(--color-ink-2);
    flex: 1;
  }
  .rb-leg-count {
    font-family: var(--font-mono), monospace;
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
</style>

<script define:vars={{ gid }}>
  const el = document.getElementById(gid);
  if (el) {
    const nums = el.querySelectorAll('.rb-total-num, .rb-leg-count');
    let fired = false;
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !fired) {
          fired = true;
          el.classList.add('animated');
          nums.forEach((n) => {
            const target = parseFloat(n.dataset.target || '0');
            const duration = 1400;
            const start = performance.now();
            const tick = (now) => {
              const progress = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              n.textContent = Math.round(eased * target).toLocaleString();
              if (progress < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
          obs.disconnect();
        }
      });
    }, { threshold: 0.3 });
    obs.observe(el);
  }
</script>
