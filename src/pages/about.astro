---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';

const schemaNodes = [
  {
    '@type': 'AboutPage',
    '@id': `${site.url}/about/#page`,
    name: 'About OptimisedWebsite',
    description: 'OptimisedWebsite is a specialist studio that builds SEO-first websites for UK businesses. Every site is constructed from keyword research and topical authority architecture.',
    url: `${site.url}/about/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${site.url}/#organization` }
  }
];
---
<Base
  title="About OptimisedWebsite | SEO-First Website Studio"
  description="OptimisedWebsite is a specialist studio that builds SEO-first websites for UK businesses. Every site is constructed from keyword research and topical authority architecture."
  canonicalPath="/about/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">About</div>
      <h1 class="section-title">About OptimisedWebsite</h1>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink-2);">
        OptimisedWebsite is a specialist studio that builds websites designed to rank. Not redesigns, not template installs, not WordPress themes with a few plugins bolted on. Every site we deliver is constructed from the ground up using keyword research, topical authority architecture, and per-page schema markup.
      </p>
    </section>

    <section class="py-10">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Why SEO-First Matters</h2>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        Most websites retrofit SEO after design is complete — adding meta tags, fixing headings, writing alt text. The result looks polished but lacks the structural foundations search engines need to rank content properly.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        SEO-first reverses that sequence. Keyword research, topical mapping, internal linking architecture, and schema planning all happen before a single line of HTML is written. Every URL, every heading, and every internal link exists because the data justified it. Design serves the structure.
      </p>
    </section>

    <section class="py-10">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">How Topical Authority Works</h2>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        Search engines rank websites that demonstrate deep coverage of a subject. A single "vibration plates" page loses to a site with dedicated pages for reviews, comparisons, buying guides, exercise routines, and health benefits — all interlinked through a hub-and-spoke structure.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        Topical authority is not about publishing more pages. It is about publishing the right pages, targeting the right keywords, and connecting them with the right internal links. Our topical maps typically contain 15-50 pages organised into 3-7 clusters, each covering a subtopic within your niche at sufficient depth that search engines treat your site as the go-to resource.
      </p>
    </section>

    <section class="py-10">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">What Makes Our Builds Different</h2>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        Three things separate our builds from a typical web agency deliverable. First, every page carries its own JSON-LD schema block within a site-wide @graph — Organisation, WebSite, Service, Article, FAQPage, HowTo, and BreadcrumbList types are deployed where the data supports them, cross-referenced through @id for entity coherence.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        Second, we build on Astro and deploy to CDN edge networks (Cloudflare Pages or Vercel). Static HTML ships with zero server-side rendering overhead. Sub-second page loads. Core Web Vitals scores that beat WordPress competitors still loading jQuery and twelve plugins.
      </p>
      <p class="leading-relaxed" style="color: var(--color-ink-2);">
        Third, you own everything. The GitHub repository, the domain, the hosting account, and the content. No proprietary CMS. No vendor lock-in. No recurring platform fee. Walk away and manage the site yourself — we hand over a complete codebase with documentation.
      </p>
    </section>

    <section class="py-12 text-center">
      <div class="flex flex-wrap gap-3 justify-center">
        <CTA href="/portfolio/" label="View Our Portfolio" />
        <CTA href="/order/" label="Order a Build" variant="secondary" />
      </div>
    </section>
  </div>
</Base>
