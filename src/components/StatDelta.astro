---
interface Stat {
  label: string;
  value: number;
  suffix?: string;
  prefix?: string;
  decimals?: number;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
const gid = `sd-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="stat-delta" id={gid}>
  {stats.map((s) => (
    <div class="sd-item">
      <div class="sd-value">
        {s.prefix && <span class="sd-affix">{s.prefix}</span>}
        <span class="sd-num" data-target={s.value} data-decimals={s.decimals ?? 0}>0</span>
        {s.suffix && <span class="sd-affix">{s.suffix}</span>}
      </div>
      <div class="sd-label">{s.label}</div>
    </div>
  ))}
</div>

<style>
  .stat-delta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-rule);
    box-shadow: inset 0 0 0 1px var(--color-rule);
  }
  @media (max-width: 640px) {
    .stat-delta { grid-template-columns: repeat(2, 1fr); }
  }
  .sd-item {
    background: var(--color-paper);
    padding: 1.5rem 1.25rem;
    text-align: center;
  }
  .sd-value {
    font-family: var(--font-display), serif;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    gap: 1px;
  }
  .sd-affix {
    font-size: 0.6em;
    color: var(--color-accent-2);
    font-weight: 600;
  }
  .sd-label {
    font-family: var(--font-mono), monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-3);
    margin-top: 0.6rem;
    line-height: 1.3;
  }
</style>

<script define:vars={{ gid }}>
  const el = document.getElementById(gid);
  if (el) {
    const nums = el.querySelectorAll('.sd-num');
    let fired = false;
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !fired) {
          fired = true;
          nums.forEach((n) => {
            const target = parseFloat(n.dataset.target || '0');
            const decimals = parseInt(n.dataset.decimals || '0', 10);
            const duration = 1600;
            const start = performance.now();
            const tick = (now) => {
              const progress = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = eased * target;
              n.textContent = decimals > 0
                ? current.toFixed(decimals)
                : Math.round(current).toLocaleString();
              if (progress < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
          obs.disconnect();
        }
      });
    }, { threshold: 0.3 });
    obs.observe(el);
  }
</script>
