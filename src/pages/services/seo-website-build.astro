---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubNav from '../../components/HubNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';
import { services } from '../../data/services';

const current = services.find(s => s.slug === 'seo-website-build')!;
const siblings = services.filter(s => s.slug !== current.slug).slice(0, 3);
const hubItems = services.map(s => ({ label: s.title, href: `/services/${s.slug}/` }));

const deliverables = [
  { title: 'Keyword research document', desc: '50-200 terms clustered by intent with search volume, keyword difficulty, and SERP feature data for your niche.' },
  { title: 'Topical map', desc: 'Hub-and-spoke architecture showing page connections, cluster assignments, and the internal linking blueprint.' },
  { title: '15-50 fully written pages', desc: 'Each targeting a specific keyword with correct heading hierarchy, unique meta title and description, and at least 500 words of original content.' },
  { title: 'Per-page JSON-LD schema', desc: 'Organisation, WebSite, Service, Article, FAQPage, HowTo, and BreadcrumbList types all cross-referenced through @id within an @graph.' },
  { title: 'Technical SEO setup', desc: 'Canonical URLs, XML sitemap, robots.txt, heading validation, image alt attributes, and Core Web Vitals optimisation.' },
  { title: 'Deployment and submission', desc: 'Live deployment to Cloudflare Pages, sitemap submission to Google Search Console and Bing Webmaster Tools.' },
];

const steps = [
  { title: 'Brief and niche analysis', desc: 'You tell us about your business, target audience, and competitors. We analyse the SERPs to identify ranking opportunities.' },
  { title: 'Keyword research', desc: 'We pull 50-200 keywords from Ahrefs, cluster them by search intent, and identify head terms and long-tail variations for your page targets.' },
  { title: 'Topical mapping', desc: 'Keywords are organised into hub-and-spoke clusters. Each hub becomes a pillar page; each spoke targets a supporting keyword.' },
  { title: 'Content writing', desc: 'Every page is written from scratch against its target keyword. Single H1, logical H2/H3 nesting, unique meta titles under 60 characters.' },
  { title: 'Schema markup', desc: 'Each page receives its own JSON-LD block within an @graph connecting to site-wide Organisation and WebSite entities.' },
  { title: 'Technical SEO', desc: 'Canonical URLs, XML sitemap, robots.txt, heading hierarchy validation, image optimisation, Core Web Vitals testing.' },
  { title: 'Deployment and submission', desc: 'Deployed to your hosting platform, sitemap submitted to Search Console and Bing, indexing verified.' },
];

const faqs = [
  { q: 'What is included in an SEO website build?', a: 'Every build includes keyword research, topical mapping, content architecture, content writing for all pages, per-page JSON-LD schema markup, technical SEO setup, and deployment to your hosting platform. You receive a fully live, ranking-ready website.' },
  { q: 'Do I need to provide content for the website?', a: 'No. We research and write all content based on keyword data and search intent analysis. You provide your business details, service descriptions, and messaging preferences. We handle everything else.' },
  { q: 'Can I choose my own CMS or hosting platform?', a: 'Yes. We build on Astro by default for maximum performance. We can also deliver on WordPress, Next.js, or any static site generator. Hosting is typically Cloudflare Pages or Vercel.' },
  { q: 'What happens after the website is delivered?', a: 'You own the site outright — no ongoing fees or retainers. We provide a handover document covering how to update content, add pages, and maintain your schema.' },
];

const schemaNodes = [
  {
    '@type': 'ProfessionalService',
    '@id': `${site.url}/services/seo-website-build/#service`,
    name: current.h1,
    description: current.metaDescription,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'GBP',
      price: '1500',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: '1500', maxPrice: '3000', priceCurrency: 'GBP' }
    }
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/services/seo-website-build/#faq`,
    mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } }))
  }
];
---
<Base
  title={current.metaTitle}
  description={current.metaDescription}
  canonicalPath="/services/seo-website-build/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services/' },
      { label: current.title, href: '/services/seo-website-build/' }
    ]} />
    <HubNav items={hubItems} currentPath="/services/seo-website-build/" />

    <section class="py-12">
      <h1 class="section-title">{current.h1}</h1>
      <p class="text-[17px] leading-relaxed max-w-3xl mt-4" style="color: var(--color-ink-2);">
        An SEO website build is not a redesign bolted onto an existing site. Every decision — URL structure, heading hierarchy, internal linking — follows keyword research and search intent data. The result is a website architecturally designed to rank.
      </p>
    </section>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-8" style="color: var(--color-ink);">What You Receive</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {deliverables.map((d, i) => (
          <div class="rounded-[16px] p-7 transition-all duration-300" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);">
            <div class="flex items-start gap-4">
              <span class="font-extrabold text-lg mt-0.5" style="color: var(--color-accent-2);">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-bold mb-1.5" style="color: var(--color-ink);">{d.title}</h3>
                <p class="text-[14px] leading-relaxed" style="color: var(--color-ink-2);">{d.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-8" style="color: var(--color-ink);">How the Build Works</h2>
      <div class="space-y-4">
        {steps.map((s, i) => (
          <div class="flex gap-5 items-start">
            <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm shrink-0 mt-0.5" style="background: rgba(124,58,237,0.1); border: 1px solid rgba(124,58,237,0.25); color: var(--color-accent-2);">
              {i + 1}
            </div>
            <div>
              <h3 class="font-bold mb-1" style="color: var(--color-ink);">{s.title}</h3>
              <p class="text-[14px] leading-relaxed" style="color: var(--color-ink-2);">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="py-12 reveal">
      <div class="rounded-[20px] p-10 relative overflow-hidden" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px rgba(124,58,237,0.25), var(--shadow-lg);">
        <div class="absolute -top-[40%] right-[-20%] w-[400px] h-[400px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(124,58,237,0.06), transparent 55%);"></div>
        <div class="relative">
          <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4" style="color: var(--color-ink);">Pricing</h2>
          <p class="leading-relaxed max-w-2xl" style="color: var(--color-ink-2);">
            SEO website builds start at <strong style="color: var(--color-ink);">£1,500</strong> for a 15-page site and scale up to <strong style="color: var(--color-ink);">£3,000</strong> for a 50-page build with full topical authority architecture. Every build includes keyword research, content writing, schema markup, technical SEO, and deployment — no hidden fees.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <CTA href="/order/" label="Order Your Build" />
            <CTA href="/pricing/" label="See Full Pricing" variant="secondary" />
          </div>
        </div>
      </div>
    </section>

    <FAQSection faqs={faqs} />

    <section class="py-10 reveal" style="border-top: 1px solid var(--color-rule);">
      <h2 class="text-xl font-bold tracking-[-0.02em] mb-5" style="color: var(--color-ink);">Related Services</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {siblings.map(s => (
          <a
            href={`/services/${s.slug}/`}
            class="block rounded-[16px] p-6 no-underline transition-all duration-300"
            style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);"
            onmouseover="this.style.boxShadow='inset 0 0 0 1px rgba(124,58,237,0.3), 0 4px 16px rgba(30,41,59,0.1)'; this.style.transform='translateY(-2px)';"
            onmouseout="this.style.boxShadow='inset 0 0 0 1px var(--color-rule), 0 1px 3px rgba(30,41,59,0.08)'; this.style.transform='';"
          >
            <h3 class="font-bold mb-1.5" style="color: var(--color-ink);">{s.title}</h3>
            <p class="text-[13px]" style="color: var(--color-ink-2);">{s.shortDescription}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
