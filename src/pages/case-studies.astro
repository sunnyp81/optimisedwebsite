---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTA from '../components/CTA.astro';
import GrowthChart from '../components/GrowthChart.astro';
import StatDelta from '../components/StatDelta.astro';
import RankingBreakdown from '../components/RankingBreakdown.astro';
import { site } from '../data/site';
import { caseStudies } from '../data/caseStudies';

const chartColors = ['#10b981', '#7c3aed', '#3b82f6', '#f59e0b', '#ef4444'];

const schemaNodes = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/case-studies/#page`,
    name: 'SEO Website Case Studies',
    description: 'Detailed case studies of SEO-optimised websites built by OptimisedWebsite. Architecture decisions, schema implementation, and measurable results.',
    url: `${site.url}/case-studies/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: caseStudies.length,
      itemListElement: caseStudies.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: item.name,
          url: item.url,
          description: item.description,
          creator: { '@id': `${site.url}/#organization` },
        },
      })),
    },
  },
];
---
<Base
  title="SEO Website Case Studies | OptimisedWebsite"
  description="Detailed case studies of SEO-optimised websites built by OptimisedWebsite. Architecture decisions, schema implementation, and measurable results."
  canonicalPath="/case-studies/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Case Studies', href: '/case-studies/' },
    ]} />

    <section class="py-10">
      <div class="section-tag">Case Studies</div>
      <h1 class="section-title">SEO Website <span class="gradient-text">Case Studies</span></h1>
      <p class="section-desc">
        Five live builds, each grown from a standing start. Every breakdown below covers the challenge, the architecture and schema we shipped, and the verified Search Console numbers that followed.
      </p>

      <nav class="flex flex-wrap gap-2 mt-7" aria-label="Jump to case study">
        {caseStudies.map((study) => (
          <a href={`#${study.slug}`} class="chip no-underline" style="transition: box-shadow 0.2s, color 0.2s;" onmouseover="this.style.color='var(--color-accent-2)'; this.style.boxShadow='inset 0 0 0 1px var(--color-accent-2)';" onmouseout="this.style.color='var(--color-ink-2)'; this.style.boxShadow='inset 0 0 0 1px var(--color-rule)';">{study.name}</a>
        ))}
      </nav>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    {caseStudies.map((study, i) => (
      <section id={study.slug} class="py-10 reveal scroll-mt-24">
        <header class="flex flex-wrap items-end justify-between gap-4 mb-8">
          <div>
            <div class="mono text-[12px] mb-2" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Case study {String(i + 1).padStart(2, '0')} / {study.niche}</div>
            <h2 class="text-2xl md:text-[34px] font-bold leading-tight" style="color: var(--color-ink);">{study.name}</h2>
            <a href={study.url} target="_blank" rel="noopener noreferrer" class="inline-block mt-1.5 text-sm transition-colors" style="color: var(--color-accent-2);">{study.url.replace('https://', '')} &rarr;</a>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="chip">{study.pageCount} pages</span>
            <span class="chip chip-ok">{study.metric}</span>
            <span class="chip chip-violet">Lighthouse {study.lighthouse}</span>
          </div>
        </header>

        <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] items-stretch mb-6">
          <div class="card !p-7 flex flex-col gap-5">
            {[
              { tag: 'Challenge', body: study.challenge, color: 'var(--color-warn)' },
              { tag: 'Approach', body: study.approach, color: 'var(--color-accent-2)' },
              { tag: 'Result', body: study.result, color: 'var(--color-ok)' },
            ].map((block) => (
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="w-1.5 h-1.5 rounded-full" style={`background: ${block.color};`}></span>
                  <h3 class="text-[11px] font-bold uppercase tracking-wider" style="color: var(--color-ink-3);">{block.tag}</h3>
                </div>
                <p class="text-sm leading-relaxed" style="color: var(--color-ink-2);">{block.body}</p>
              </div>
            ))}
          </div>

          <div class="card !p-7 flex flex-col">
            <div class="mono text-[11px] uppercase mb-1" style="color: var(--color-ink-3); letter-spacing: 0.08em;">12-month growth</div>
            <div class="text-[15px] font-semibold mb-3" style="color: var(--color-ink);">Climbing from zero to {study.metric}</div>
            <div class="flex-1 flex items-center">
              <GrowthChart data={study.growth} label={study.growthLabel} color={chartColors[i % chartColors.length]} height={150} />
            </div>
          </div>
        </div>

        <div class="mb-6">
          <StatDelta stats={study.stats} />
        </div>

        <div class="grid gap-6 lg:grid-cols-2 items-start">
          <RankingBreakdown buckets={study.ranks} />

          <div class="card !p-7">
            <h3 class="text-[11px] font-bold uppercase tracking-wider mb-3" style="color: var(--color-ink-3);">Architecture</h3>
            <p class="text-sm leading-relaxed mb-5" style="color: var(--color-ink-2);">{study.architecture}</p>
            <h3 class="text-[11px] font-bold uppercase tracking-wider mb-3" style="color: var(--color-ink-3);">Schema graph</h3>
            <div class="flex flex-wrap gap-1.5">
              {study.schemaTypes.map((type) => (
                <span class="text-xs font-medium px-2 py-0.5 rounded" style="background: rgba(124,58,237,0.1); border: 1px solid rgba(124,58,237,0.25); color: var(--color-accent-2);">{type}</span>
              ))}
            </div>
          </div>
        </div>

        {i < caseStudies.length - 1 && (
          <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>
        )}
      </section>
    ))}

    <section class="py-16 text-center">
      <p class="mb-4" style="color: var(--color-ink-2);">Ready to become the next case study?</p>
      <CTA href="/order/" label="Order Your SEO Website" />
    </section>
  </div>
</Base>
