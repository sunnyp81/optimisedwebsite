---
interface Stat {
  label: string;
  value: number;
  suffix?: string;
  prefix?: string;
  decimals?: number;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;

const formatValue = (value: number, decimals = 0) =>
  decimals > 0 ? value.toFixed(decimals) : Math.round(value).toLocaleString();
---
<div class="stat-delta">
  {stats.map((s) => (
    <div class="sd-item">
      <div class="sd-value">
        {s.prefix && <span class="sd-affix">{s.prefix}</span>}
        <span class="sd-num">{formatValue(s.value, s.decimals ?? 0)}</span>
        {s.suffix && <span class="sd-affix">{s.suffix}</span>}
      </div>
      <div class="sd-label">{s.label}</div>
    </div>
  ))}
</div>

<style>
  .stat-delta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-rule);
    box-shadow: inset 0 0 0 1px var(--color-rule);
  }
  @media (max-width: 640px) {
    .stat-delta { grid-template-columns: repeat(2, 1fr); }
  }
  .sd-item {
    background: var(--color-paper);
    padding: 1.5rem 1.25rem;
    text-align: center;
  }
  .sd-value {
    font-family: var(--font-display), serif;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    gap: 1px;
  }
  .sd-affix {
    font-size: 0.6em;
    color: var(--violet-text);
    font-weight: 600;
  }
  .sd-label {
    font-family: var(--font-mono), monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-3);
    margin-top: 0.6rem;
    line-height: 1.3;
  }
</style>
