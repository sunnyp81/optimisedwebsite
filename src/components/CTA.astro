---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
  size?: 'default' | 'large';
  fullWidth?: boolean;
  analyticsEvent?: string;
  analyticsLabel?: string;
}

const { href, label, variant = 'primary', size = 'default', fullWidth = false, analyticsEvent, analyticsLabel } = Astro.props;

const sizeClasses = size === 'large' ? 'px-7 py-3.5 text-base' : 'px-5 py-3 text-[15px]';
const widthClass = fullWidth ? 'w-full justify-center' : '';

const styles = variant === 'primary'
  ? `btn-glow rounded-full tracking-tight ${sizeClasses} ${widthClass}`
  : `btn-glass rounded-full tracking-tight ${sizeClasses} ${widthClass}`;
---
<a
  href={href}
  class={`inline-flex items-center gap-2 no-underline ${styles}`}
  data-analytics-event={analyticsEvent}
  data-analytics-label={analyticsLabel}
>
  {label}
  {variant === 'primary' && <span class="arr">&rarr;</span>}
</a>
