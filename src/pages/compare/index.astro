---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const articles = await getCollection('compare');
articles.sort((a, b) => a.data.title.localeCompare(b.data.title));

const schemaNodes = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/compare/#webpage`,
    name: 'Compare SEO Website Options',
    description: 'Side-by-side comparisons of SEO website approaches, platforms, and build options for UK businesses.',
    url: `${site.url}/compare/`,
    isPartOf: { '@id': `${site.url}/#website` },
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'ItemList',
    '@id': `${site.url}/compare/#itemlist`,
    name: 'SEO Website Comparisons',
    numberOfItems: articles.length,
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.data.title,
      url: `${site.url}/compare/${a.id}/`,
    })),
  },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compare', href: '/compare/' },
];
---
<Base
  title="Compare SEO Website Options | OptimisedWebsite"
  description="Side-by-side comparisons of SEO website approaches, platforms, and build options for UK businesses."
  canonicalPath="/compare/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-10 pt-28 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <section class="py-12">
      <div class="section-tag">Compare</div>
      <h1 class="section-title">Compare SEO Website Options</h1>
      <p class="section-desc max-w-3xl">
        Honest comparisons between different approaches to building an SEO-optimised website. We break down platforms, build methods, and cost structures so you can pick the right path for your business.
      </p>
    </section>

    <section class="pb-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 reveal">
      {articles.map((article) => (
        <a
          href={`/compare/${article.id}/`}
          class="block bg-bg-2 border border-line rounded-[16px] p-6 hover:border-brand-border transition-all duration-300"
        >
          <h2 class="text-lg font-bold text-text mb-2">{article.data.title}</h2>
          <p class="text-sm text-text-muted">{article.data.metaDescription}</p>
        </a>
      ))}
    </section>

    <div class="py-8 flex flex-wrap gap-3">
      <CTA href="/order/" label="Order Your SEO Website" />
      <CTA href="/learn/" label="Learn About SEO" variant="secondary" />
    </div>
  </div>
</Base>
