---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTA from '../components/CTA.astro';
import AnimatedCounters from '../components/AnimatedCounters.astro';
import GrowthChart from '../components/GrowthChart.astro';
import RankingBreakdown from '../components/RankingBreakdown.astro';
import StatDelta from '../components/StatDelta.astro';
import { site } from '../data/site';
import {
  headlineCounters,
  networkSites,
  networkPages,
  networkClicks,
  networkImpressionsK,
  totalRankingKeywords,
  top10Keywords,
  avgLighthouse,
  minLighthouse,
  indexingCurves,
  rankingDistribution,
  schemaCoverage,
  methodology,
} from '../data/stateOfSeo';

const chartColors = ['#10b981', '#7c3aed', '#3b82f6', '#f59e0b', '#ef4444'];

const pageUrl = `${site.url}/state-of-seo-websites/`;

// Headline stats for the StatDelta strip, all derived from the network data.
const headlineStats = [
  { label: 'Live sites', value: networkSites },
  { label: 'Pages built', value: networkPages },
  { label: 'Clicks, 28 days to 25 Sep 2026', value: networkClicks },
  { label: 'Impressions, 28 days to 25 Sep 2026', value: networkImpressionsK, suffix: 'k', decimals: 1 },
];

const schemaNodes = [
  {
    '@type': 'Article',
    '@id': `${pageUrl}#article`,
    headline: 'The State of SEO Websites 2026',
    description:
      'An original-data report on how purpose-built SEO websites index, rank and perform, drawn from a five-site live network covering 568 pages and 2,466 ranking keywords.',
    url: pageUrl,
    datePublished: '2026-06-05',
    dateModified: methodology.lastReviewed,
    inLanguage: 'en-GB',
    isPartOf: { '@id': `${site.url}/#website` },
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
    about: [
      'Search Engine Optimisation',
      'Indexing',
      'Core Web Vitals',
      'Structured Data',
    ],
  },
  {
    '@type': 'Dataset',
    '@id': `${pageUrl}#dataset`,
    name: 'OptimisedWebsite SEO network performance dataset',
    description:
      'Aggregated Google Search Console performance for a five-site network: 568 pages, 2,466 tracked ranking keywords, monthly clicks and impressions, and Lighthouse scores by site.',
    url: pageUrl,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    creator: { '@id': `${site.url}/#organization` },
    isPartOf: { '@id': `${site.url}/#website` },
    keywords: [
      'SEO',
      'indexing speed',
      'Lighthouse',
      'ranking distribution',
      'organic clicks',
      'organic impressions',
    ],
    variableMeasured: [
      'Pages built',
      'Monthly organic clicks',
      'Monthly organic impressions',
      'Ranking keywords by position bucket',
      'Lighthouse performance score',
    ],
    temporalCoverage: '2025/2026',
    spatialCoverage: { '@type': 'Country', name: 'United Kingdom' },
  },
];
---
<Base
  title="The State of SEO Websites 2026 | OptimisedWebsite"
  description="Original-data report: how purpose-built SEO websites index, rank and perform. Five live sites, 568 pages, 2,466 ranking keywords, and the benchmarks behind them."
  canonicalPath="/state-of-seo-websites/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'The State of SEO Websites', href: '/state-of-seo-websites/' },
    ]} />

    <!-- HERO -->
    <header class="py-10">
      <div class="section-tag">Original data report</div>
      <h1 class="section-title">The State of <span class="gradient-text">SEO Websites</span> 2026</h1>
      <p class="section-desc" style="max-width: 640px;">
        How do purpose-built SEO websites actually index, rank and perform? We pulled the numbers from our own
        live network of {networkSites} sites, {networkPages} pages and {totalRankingKeywords.toLocaleString()} tracked
        keywords. The methodology below shows which figures were re-checked in September 2026 and which were not.
      </p>
      <div class="flex flex-wrap gap-2 mt-7">
        <span class="chip">{networkSites} live sites</span>
        <span class="chip chip-ok">{networkPages} pages built</span>
        <span class="chip chip-violet">Avg Lighthouse {avgLighthouse}</span>
        <span class="chip chip-accent">CC BY 4.0 data</span>
      </div>
    </header>
  </div>

  <!-- HEADLINE COUNTERS (full-bleed strip) -->
  <AnimatedCounters counters={headlineCounters} />

  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pb-20">
    <!-- KEY FINDINGS -->
    <section class="py-12 reveal">
      <div class="section-tag">Key findings</div>
      <h2 class="text-2xl md:text-[34px] font-bold leading-tight mb-6" style="color: var(--color-ink);">What the network tells us</h2>
      <div class="grid gap-5 md:grid-cols-3">
        {[
          {
            stat: `${networkImpressionsK}k`,
            label: 'organic impressions in 28 days',
            body: `Across ${networkPages} pages, the network earned ${networkImpressionsK}k impressions and ${networkClicks.toLocaleString()} clicks in the 28 days to 25 September 2026.`,
          },
          {
            stat: `${top10Keywords.toLocaleString()}`,
            label: 'keywords in the top 10',
            body: `Of ${totalRankingKeywords.toLocaleString()} tracked keywords, ${top10Keywords.toLocaleString()} sat on page one when last recorded. These bucket counts have not been re-checked since the September 2026 review.`,
          },
          {
            stat: `${avgLighthouse}`,
            label: 'average Lighthouse score',
            body: `Each case study recorded a Lighthouse performance score of ${minLighthouse} or higher at build. These scores have not been re-measured since.`,
          },
        ].map((f) => (
          <div class="card !p-7">
            <div class="font-display text-4xl font-bold mb-1" style="color: var(--color-ink); letter-spacing: -0.03em;">{f.stat}</div>
            <div class="mono text-[11px] uppercase mb-3" style="color: var(--color-ink-3); letter-spacing: 0.08em;">{f.label}</div>
            <p class="text-sm leading-relaxed" style="color: var(--color-ink-2);">{f.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-8">
        <StatDelta stats={headlineStats} />
      </div>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <!-- 1. INDEXING TIMELINE BENCHMARK -->
    <section class="py-12 reveal">
      <div class="section-tag">Benchmark 01</div>
      <h2 class="text-2xl md:text-[34px] font-bold leading-tight mb-4" style="color: var(--color-ink);">How fast do new SEO sites gain traction?</h2>
      <p class="text-base leading-relaxed mb-8" style="color: var(--color-ink-2); max-width: 680px;">
        The curves track monthly organic impressions across the first twelve
        months. The pattern is consistent: a slow first quarter while pages index, then a compounding climb as the long tail
        matures.
      </p>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {indexingCurves.map((curve, i) => (
          <div class="card !p-6 flex flex-col">
            <div class="flex items-baseline justify-between mb-1">
              <div class="text-[15px] font-semibold" style="color: var(--color-ink);">{curve.name}</div>
              <span class="mono text-[11px]" style="color: var(--color-ink-3);">{curve.pageCount}p</span>
            </div>
            <div class="mono text-[11px] uppercase mb-2" style="color: var(--color-ink-3); letter-spacing: 0.06em;">{curve.niche}</div>
            <div class="flex-1 flex items-center">
              <GrowthChart data={curve.series} label="Impressions / month (thousands)" color={chartColors[i % chartColors.length]} height={140} />
            </div>
          </div>
        ))}
      </div>
      <p class="mono text-[11px] mt-5" style="color: var(--color-ink-3);">
        Source: Google Search Console impressions, first 12 months per site, as recorded at the time. Not re-checked against a dated export in the September 2026 review.
      </p>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <!-- 4. RANKING DISTRIBUTION -->
    <section class="py-12 reveal">
      <div class="section-tag">Benchmark 02</div>
      <h2 class="text-2xl md:text-[34px] font-bold leading-tight mb-4" style="color: var(--color-ink);">Where the tracked keywords ranked</h2>
      <p class="text-base leading-relaxed mb-8" style="color: var(--color-ink-2); max-width: 680px;">
        These position buckets were recorded on each case study and have not been re-checked against a full keyword export
        since the September 2026 review. The full breakdowns sit in the
        <a href="/case-studies/" class="underline" style="color: var(--violet-text);">case studies</a>.
      </p>
      <div class="grid gap-6 lg:grid-cols-[1fr_0.9fr] items-start">
        <RankingBreakdown buckets={rankingDistribution} title="All network keywords by position" />
        <div class="card !p-7">
          <h3 class="text-[11px] font-bold uppercase tracking-wider mb-3" style="color: var(--color-ink-3);">Schema coverage</h3>
          <p class="text-sm leading-relaxed mb-5" style="color: var(--color-ink-2);">
            Every case-study site reports {schemaCoverage.ourNetwork}% of pages carrying structured data. This figure was
            not re-audited in the September 2026 review. Learn how we build the
            <a href="/services/schema-markup/" class="underline" style="color: var(--violet-text);">schema graph</a>.
          </p>
          <div class="font-display text-4xl font-bold" style="color: var(--color-ok);">{schemaCoverage.ourNetwork}%</div>
          <div class="mono text-[11px] uppercase mt-1" style="color: var(--color-ink-3);">Our network</div>
        </div>
      </div>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <!-- METHODOLOGY -->
    <section class="py-12 reveal">
      <div class="section-tag">Methodology</div>
      <h2 class="text-2xl md:text-[34px] font-bold leading-tight mb-4" style="color: var(--color-ink);">How we measured this</h2>
      <p class="text-base leading-relaxed mb-8" style="color: var(--color-ink-2); max-width: 680px;">{methodology.windowDescription}</p>
      <div class="grid gap-6 md:grid-cols-2 items-start">
        <div class="card !p-7">
          <h3 class="text-[11px] font-bold uppercase tracking-wider mb-3" style="color: var(--color-ok);">Measured from our data</h3>
          <ul class="flex flex-col gap-3">
            {methodology.derivedSources.map((s) => (
              <li class="text-sm leading-relaxed flex gap-2" style="color: var(--color-ink-2);">
                <span aria-hidden="true" style="color: var(--color-ok);">+</span><span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card !p-7">
          <h3 class="text-[11px] font-bold uppercase tracking-wider mb-3" style="color: var(--color-warn);">Estimates to confirm</h3>
          <ul class="flex flex-col gap-3">
            {methodology.placeholderSources.map((s) => (
              <li class="text-sm leading-relaxed flex gap-2" style="color: var(--color-ink-2);">
                <span aria-hidden="true" style="color: var(--color-warn);">?</span><span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="text-sm leading-relaxed mt-6" style="color: var(--color-ink-3); max-width: 680px;">{methodology.honestyNote}</p>
      <p class="mono text-[11px] mt-3" style="color: var(--color-ink-3);">Last reviewed: {methodology.lastReviewed}. Dataset licensed CC BY 4.0; cite OptimisedWebsite with a link.</p>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <!-- CTA -->
    <section class="py-16 text-center">
      <h2 class="text-2xl md:text-[30px] font-bold leading-tight mb-3" style="color: var(--color-ink);">Want a site that ranks like these?</h2>
      <p class="mb-6" style="color: var(--color-ink-2);">
        See the full <a href="/case-studies/" class="underline" style="color: var(--violet-text);">case studies</a>, browse the{' '}
        <a href="/services/" class="underline" style="color: var(--violet-text);">services</a>, or check the{' '}
        <a href="/pricing/" class="underline" style="color: var(--violet-text);">pricing</a>.
      </p>
      <CTA href="/order/" label="Order Your SEO Website" />
    </section>
  </div>
</Base>
