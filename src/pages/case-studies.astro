---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { portfolio } from '../data/portfolio';

const caseStudies = [
  {
    ...portfolio[0],
    architecture: 'Hub-and-spoke model with product review hubs linking to individual reviews, comparison pages, and buying guides. Astro 5 static build on Cloudflare Pages.',
    schemaTypes: ['Article', 'FAQPage', 'BreadcrumbList', 'Product', 'ItemList', 'Organization', 'WebSite'],
    contentStructure: 'Each review page has a BuyBox component with affiliate CTA, spec table, pros/cons, and related product links. 6 comparison pages cross-link between product categories.',
    lighthouse: 100,
    schemaCoverage: '100%',
    indexing: '135/135 pages indexed in Google Search Console. Sitemap and IndexNow submitted.',
  },
  {
    ...portfolio[1],
    architecture: 'County-level pages auto-generated from water hardness dataset. Flat URL structure: /county-name/. Astro 5 on Cloudflare Pages.',
    schemaTypes: ['Article', 'FAQPage', 'BreadcrumbList', 'Organization', 'WebSite'],
    contentStructure: 'Each county page includes hardness data, soft-water CTA, direct ASIN affiliate links, and FAQ section. Homepage targets head term "water hardness UK".',
    lighthouse: 99,
    schemaCoverage: '100%',
    indexing: '49/49 county pages indexed. 1,191 clicks/28 days at position 7.2 average.',
  },
  {
    ...portfolio[2],
    architecture: 'Single-page calculator apps with unique content per tool. Astro 5 static site. Each calculator has its own H2, worked examples, and UK-specific data.',
    schemaTypes: ['HowTo', 'FAQPage', 'BreadcrumbList', 'WebApplication', 'Organization', 'WebSite'],
    contentStructure: '450 unique H2 headings across 60 pages (no templated duplication). 15 content rewrites with case studies. Meta titles rewritten for CTR.',
    lighthouse: 98,
    schemaCoverage: '100%',
    indexing: 'Recovering from March 2026 core update. IndexNow + Bing submission completed.',
  },
  {
    ...portfolio[3],
    architecture: 'Large-scale vehicle database trimmed from 14,487 to 832 indexable pages. Quality gate removed thin pages via noindex. Astro 5 on Cloudflare Pages.',
    schemaTypes: ['Article', 'BreadcrumbList', 'Vehicle', 'Organization', 'WebSite'],
    contentStructure: 'Make > Model > Trim hierarchy. Each vehicle page has towing capacity data, payload figures, and related vehicle links. Thin stubs noindexed.',
    lighthouse: 97,
    schemaCoverage: '100%',
    indexing: '832 indexable pages with sitemap submitted. Thin pages (14,487 - 832 = 13,655) set to noindex,follow.',
  },
  {
    ...portfolio[4],
    architecture: 'Error code reference site spanning 11 services (AWS, Docker, Git, etc.) plus HTTP status codes. Astro 5 static build. AI crawler rules configured via llms.txt and ai.txt.',
    schemaTypes: ['TechArticle', 'HowTo', 'FAQPage', 'BreadcrumbList', 'Organization', 'WebSite'],
    contentStructure: '33 curated error pages with 700+ words each. Each page has cause, fix steps, and related errors. 50 HTTP code pages and 2 comparison guides.',
    lighthouse: 100,
    schemaCoverage: '100%',
    indexing: '125 pages with sitemap and IndexNow. AI crawler rules allow GPTBot, ClaudeBot, and PerplexityBot.',
  },
];

const schemaNodes = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/case-studies/#page`,
    name: 'SEO Website Case Studies',
    description: 'Detailed case studies of SEO-optimised websites built by OptimisedWebsite. Architecture decisions, schema implementation, and measurable results.',
    url: `${site.url}/case-studies/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: caseStudies.length,
      itemListElement: caseStudies.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: item.name,
          url: item.url,
          description: item.description,
          creator: { '@id': `${site.url}/#organization` },
        },
      })),
    },
  },
];
---
<Base
  title="SEO Website Case Studies | OptimisedWebsite"
  description="Detailed case studies of SEO-optimised websites built by OptimisedWebsite. Architecture decisions, schema implementation, and measurable results."
  canonicalPath="/case-studies/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-4">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Case Studies', href: '/case-studies/' },
    ]} />

    <section class="py-10">
      <p class="section-tag">Case Studies</p>
      <h1 class="section-title">SEO Website <span class="gradient-text">Case Studies</span></h1>
      <p class="section-desc">
        Each site below was built as a purpose-built SEO asset. These breakdowns cover architecture decisions, schema implementation, content structure, and measurable outcomes.
      </p>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    {caseStudies.map((study, i) => (
      <section class="py-10 reveal">
        <article class="work-card">
          <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
            <div>
              <h2 class="text-2xl md:text-3xl font-bold text-text">{study.name}</h2>
              <p class="text-text-muted mt-1">{study.niche} &middot; <a href={study.url} target="_blank" rel="noopener noreferrer" class="text-brand hover:text-brand-bright transition-colors">{study.url.replace('https://', '')}</a></p>
            </div>
            <div class="flex gap-3">
              <span class="text-xs font-bold bg-brand/10 text-brand px-3 py-1.5 rounded-lg">{study.pageCount} pages</span>
              <span class="text-xs font-bold bg-blue/10 text-blue px-3 py-1.5 rounded-lg">{study.metric}</span>
            </div>
          </div>

          <p class="text-text-muted leading-relaxed mb-8">{study.description}</p>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 mb-6">
            <div class="feat-card !p-6">
              <h3 class="text-xs font-bold uppercase tracking-wider text-brand mb-3">Architecture</h3>
              <p class="text-sm text-text-muted leading-relaxed">{study.architecture}</p>
            </div>

            <div class="feat-card !p-6">
              <h3 class="text-xs font-bold uppercase tracking-wider text-brand mb-3">Schema Types</h3>
              <div class="flex flex-wrap gap-1.5">
                {study.schemaTypes.map(type => (
                  <span class="text-xs font-medium bg-brand-dim text-brand-bright px-2 py-0.5 rounded border border-brand-border">{type}</span>
                ))}
              </div>
            </div>

            <div class="feat-card !p-6">
              <h3 class="text-xs font-bold uppercase tracking-wider text-brand mb-3">Content Structure</h3>
              <p class="text-sm text-text-muted leading-relaxed">{study.contentStructure}</p>
            </div>

            <div class="feat-card !p-6">
              <h3 class="text-xs font-bold uppercase tracking-wider text-brand mb-3">Results</h3>
              <ul class="text-sm text-text-muted space-y-2">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-brand shrink-0"></span>
                  Lighthouse: {study.lighthouse}/100
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-cyan shrink-0"></span>
                  Schema: {study.schemaCoverage}
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-blue shrink-0"></span>
                  {study.indexing}
                </li>
              </ul>
            </div>
          </div>
        </article>

        {i < caseStudies.length - 1 && (
          <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>
        )}
      </section>
    ))}

    <section class="py-16 text-center">
      <p class="text-text-muted mb-4">Ready to become the next case study?</p>
      <CTA href="/order/" label="Order Your SEO Website" />
    </section>
  </div>
</Base>
