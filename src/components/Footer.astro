---
import { site } from '../data/site';
import { footerNav } from '../data/navigation';

const year = new Date().getFullYear();
---
<footer class="relative z-[2]" style="background: var(--color-ink); color: var(--color-bg);">
  <div class="footer-glow" style="background: radial-gradient(ellipse, rgba(251,191,36,0.08) 0%, transparent 60%);"></div>

  <div class="wrap pt-16 pb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr] gap-10 pb-14" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 no-underline mb-4">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="24" height="24" rx="6" fill="#fbbf24"/>
            <polyline points="7,19 12,14 16,16 21,9" stroke="#7c3aed" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span class="text-[15px] font-semibold tracking-[-0.025em]" style="color: var(--color-bg);">{site.name}</span>
        </a>
        <p class="text-sm leading-relaxed max-w-[260px]" style="color: rgba(248,250,252,0.5);">
          SEO-optimised websites for UK businesses. Built in Astro, deployed on Cloudflare, structured to rank from day one.
        </p>
        <p class="text-[11px] font-mono mt-4" style="color: rgba(248,250,252,0.3); letter-spacing: 0.06em; text-transform: uppercase;">Built in Britain &middot; From £1,500</p>
      </div>

      <div>
        <h4 class="text-[10px] font-mono font-semibold uppercase mb-4" style="color: rgba(248,250,252,0.3); letter-spacing: 0.12em;">Services</h4>
        <ul class="space-y-2.5">
          {footerNav.services.map((item) => (
            <li>
              <a href={item.href} class="text-sm no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.55);" onmouseover="this.style.color='rgba(248,250,252,0.9)'" onmouseout="this.style.color='rgba(248,250,252,0.55)'">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-[10px] font-mono font-semibold uppercase mb-4" style="color: rgba(248,250,252,0.3); letter-spacing: 0.12em;">Learn</h4>
        <ul class="space-y-2.5">
          {footerNav.learn.map((item) => (
            <li>
              <a href={item.href} class="text-sm no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.55);" onmouseover="this.style.color='rgba(248,250,252,0.9)'" onmouseout="this.style.color='rgba(248,250,252,0.55)'">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-[10px] font-mono font-semibold uppercase mb-4" style="color: rgba(248,250,252,0.3); letter-spacing: 0.12em;">Company</h4>
        <ul class="space-y-2.5">
          {footerNav.company.map((item) => (
            <li>
              <a href={item.href} class="text-sm no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.55);" onmouseover="this.style.color='rgba(248,250,252,0.9)'" onmouseout="this.style.color='rgba(248,250,252,0.55)'">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="pt-6 flex flex-wrap justify-between items-center gap-3">
      <div class="text-[13px]" style="color: rgba(248,250,252,0.35);">&copy; {year} {site.name}. All rights reserved.</div>
      <div class="flex gap-5">
        <a href="/privacy/" class="text-[13px] no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.35);" onmouseover="this.style.color='rgba(248,250,252,0.7)'" onmouseout="this.style.color='rgba(248,250,252,0.35)'">Privacy</a>
        <a href="/terms/" class="text-[13px] no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.35);" onmouseover="this.style.color='rgba(248,250,252,0.7)'" onmouseout="this.style.color='rgba(248,250,252,0.35)'">Terms</a>
      </div>
    </div>
  </div>
</footer>
