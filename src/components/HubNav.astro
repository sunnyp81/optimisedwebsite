---
interface Props {
  items: { label: string; href: string }[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;
---
<nav aria-label="Service pages" class="flex flex-wrap gap-2 py-4">
  {items.map((item) => {
    const isCurrent = item.href === currentPath;
    return (
      <a
        href={item.href}
        class={`text-sm px-3.5 py-1.5 rounded-full border transition-all duration-200 ${isCurrent ? 'bg-brand text-bg border-brand font-semibold' : 'border-line text-text-muted hover:border-brand-border hover:text-brand'}`}
        {...(isCurrent ? { 'aria-current': 'page' } : {})}
      >
        {item.label}
      </a>
    );
  })}
</nav>
