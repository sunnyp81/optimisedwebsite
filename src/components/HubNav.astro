---
interface Props {
  items: { label: string; href: string }[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;
---
<nav aria-label="Service pages" class="flex flex-wrap gap-2 py-4">
  {items.map((item) => {
    const isCurrent = item.href === currentPath;
    return (
      <a
        href={item.href}
        class="text-[13px] px-3.5 py-1.5 rounded-full no-underline transition-all duration-200"
        style={isCurrent
          ? `background: var(--color-accent-2); color: #fff; font-weight: 600;`
          : `background: transparent; color: var(--color-ink-2); box-shadow: inset 0 0 0 1px var(--color-rule);`
        }
        {...(isCurrent ? { 'aria-current': 'page' } : {})}
      >
        {item.label}
      </a>
    );
  })}
</nav>
