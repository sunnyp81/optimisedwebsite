---
interface Racer {
  name: string;
  loadTime: number;
  color: string;
  icon: string;
}
interface Props {
  racers?: Racer[];
}
const { racers = [
  { name: 'Astro (our stack)', loadTime: 0.4, color: '#10b981', icon: '⟡' },
  { name: 'Next.js', loadTime: 1.2, color: '#3b82f6', icon: '▲' },
  { name: 'WordPress', loadTime: 3.8, color: '#7c3aed', icon: 'W' },
  { name: 'Squarespace', loadTime: 4.2, color: '#f59e0b', icon: '■' },
  { name: 'Wix', loadTime: 5.1, color: '#ef4444', icon: '✦' },
] } = Astro.props;

const maxTime = Math.max(...racers.map(r => r.loadTime));
---
<div class="speed-race" id="speedRace">
  <div class="sr-header">
    <h3 class="sr-title">Page Load Speed Race</h3>
    <button class="sr-replay" id="srReplay" aria-label="Replay animation">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
      Replay
    </button>
  </div>
  <div class="sr-track-area">
    <div class="sr-finish-line" aria-hidden="true"></div>
    {racers.map((racer, i) => (
      <div class="sr-lane" data-lane={i}>
        <div class="sr-racer" style={`--race-pct: ${(racer.loadTime / maxTime) * 100}%; --race-delay: ${i * 0.08}s; --race-color: ${racer.color};`}>
          <span class="sr-icon" style={`background: ${racer.color};`}>{racer.icon}</span>
          <div class="sr-info">
            <span class="sr-name">{racer.name}</span>
            <span class="sr-time">{racer.loadTime}s</span>
          </div>
          <div class="sr-bar">
            <div class="sr-bar-fill"></div>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="sr-scale">
    <span>0s</span>
    <span>{(maxTime / 4).toFixed(1)}s</span>
    <span>{(maxTime / 2).toFixed(1)}s</span>
    <span>{(maxTime * 3 / 4).toFixed(1)}s</span>
    <span>{maxTime.toFixed(1)}s</span>
  </div>
  <p class="sr-footnote">First Contentful Paint — median of 10 runs via WebPageTest on 4G throttled connection. Lower is better.</p>
</div>

<style>
  .speed-race {
    padding: 1.5rem;
    border-radius: 16px;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);
  }
  :global(.section-dark) .speed-race {
    background: rgba(255,255,255,0.04);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
  }
  :global(.section-dark) .sr-title { color: var(--color-bg); }
  :global(.section-dark) .sr-name { color: rgba(248,250,252,0.85); }
  :global(.section-dark) .sr-replay { border-color: rgba(255,255,255,0.12); color: rgba(248,250,252,0.5); background: rgba(255,255,255,0.04); }
  :global(.section-dark) .sr-replay:hover { border-color: var(--color-accent); color: rgba(248,250,252,0.85); }
  :global(.section-dark) .sr-bar { background: rgba(255,255,255,0.08); }
  :global(.section-dark) .sr-scale { border-top-color: rgba(255,255,255,0.08); color: rgba(248,250,252,0.35); }
  :global(.section-dark) .sr-footnote { color: rgba(248,250,252,0.35); }
  :global(.section-dark) .sr-time { color: rgba(248,250,252,0.45); }
  :global(.section-dark) .sr-header { border-bottom-color: rgba(255,255,255,0.08); }
  .sr-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .sr-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }
  .sr-replay {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    background: var(--color-bg-2);
    font-family: var(--font-mono), monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-3);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .sr-replay:hover {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }
  .sr-track-area {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sr-finish-line {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: repeating-linear-gradient(180deg, var(--color-ink-3) 0, var(--color-ink-3) 4px, transparent 4px, transparent 8px);
    opacity: 0.3;
  }
  .sr-lane {
    position: relative;
  }
  .sr-racer {
    display: grid;
    grid-template-columns: 28px 1fr;
    grid-template-rows: auto auto;
    gap: 2px 8px;
    align-items: center;
  }
  .sr-icon {
    grid-row: 1 / 3;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: white;
    font-weight: 700;
    flex-shrink: 0;
  }
  .sr-info {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .sr-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .sr-time {
    font-family: var(--font-mono), monospace;
    font-size: 0.7rem;
    color: var(--color-ink-3);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .speed-race.racing .sr-time {
    opacity: 1;
    transition-delay: calc(var(--race-delay) + 1s);
  }
  .sr-bar {
    height: 6px;
    border-radius: 3px;
    background: var(--color-rule);
    overflow: hidden;
  }
  .sr-bar-fill {
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--race-color), color-mix(in srgb, var(--race-color) 70%, white));
    width: 0%;
    transition: width 1.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--race-delay);
  }
  .speed-race.racing .sr-bar-fill {
    width: var(--race-pct);
  }
  .sr-scale {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-mono), monospace;
    font-size: 0.6rem;
    color: var(--color-ink-3);
  }
  .sr-footnote {
    font-size: 0.7rem;
    color: var(--color-ink-3);
    margin-top: 0.75rem;
    line-height: 1.5;
    font-style: italic;
  }
</style>

<script>
  const race = document.getElementById('speedRace');
  const replay = document.getElementById('srReplay');
  if (race) {
    const startRace = () => {
      race.classList.remove('racing');
      void race.offsetWidth;
      race.classList.add('racing');
    };

    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          startRace();
          obs.disconnect();
        }
      });
    }, { threshold: 0.3 });
    obs.observe(race);

    if (replay) {
      replay.addEventListener('click', startRace);
    }
  }
</script>
