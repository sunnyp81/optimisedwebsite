---
// Testimonials / Reviews section.
// Renders ONLY reviews flagged published: true in src/data/reviews.ts.
// Placeholder entries ship unpublished, so this component renders nothing until
// the owner adds genuine reviews. See src/data/reviews.ts for instructions.
import { publishedReviews } from '../data/reviews';

interface Props {
  /** Optional eyebrow label above the heading. */
  eyebrow?: string;
  /** Optional heading. */
  heading?: string;
}

const { eyebrow = 'Client feedback', heading = 'What clients say' } = Astro.props;

const items = publishedReviews();
// Whole + half star breakdown per review, clamped to the 0 to 5 range.
const starState = (rating: number) => {
  const clamped = Math.max(0, Math.min(5, rating));
  return Array.from({ length: 5 }, (_, i) => {
    if (clamped >= i + 1) return 'full';
    if (clamped >= i + 0.5) return 'half';
    return 'empty';
  });
};
---
{items.length > 0 && (
  <section class="reviews" aria-labelledby="reviewsHeading">
    <div class="wrap">
      <span class="eyebrow violet">{eyebrow}</span>
      <h2 id="reviewsHeading" class="reviews-title">{heading}</h2>
      <div class="reviews-grid">
        {items.map((r) => (
          <figure class="card review-card">
            <div class="review-stars" role="img" aria-label={`${r.rating} out of 5 stars`}>
              {starState(r.rating).map((state) => (
                <svg
                  class={`review-star review-star-${state}`}
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  {state === 'half' && (
                    <defs>
                      <linearGradient id={`half-${r.id}`}>
                        <stop offset="50%" stop-color="currentColor" />
                        <stop offset="50%" stop-color="transparent" />
                      </linearGradient>
                    </defs>
                  )}
                  <path
                    d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.5l-5.8 3.05 1.1-6.46-4.69-4.58 6.49-.94L12 2.5z"
                    fill={state === 'half' ? `url(#half-${r.id})` : 'currentColor'}
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linejoin="round"
                  />
                </svg>
              ))}
            </div>
            <blockquote class="review-quote">{r.quote}</blockquote>
            <figcaption class="review-meta">
              <span class="review-author">{r.author}</span>
              {r.role && <span class="review-role">{r.role}</span>}
              <span class="chip review-source">{r.source}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .reviews {
    padding: 5rem 0;
    position: relative;
  }
  .reviews-title {
    font-family: var(--font-display), serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1.1;
    margin-bottom: 2.5rem;
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .review-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }
  .review-stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-accent);
  }
  /* Empty stars stay visible but muted so contrast holds in both themes. */
  .review-star-empty {
    color: var(--color-rule-2);
  }
  .review-quote {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0;
    font-style: italic;
  }
  .review-quote::before { content: '\201C'; }
  .review-quote::after { content: '\201D'; }
  .review-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-rule);
  }
  .review-author {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-ink);
  }
  .review-role {
    font-family: var(--font-mono), monospace;
    font-size: 0.72rem;
    color: var(--color-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .review-source {
    margin-left: auto;
    height: 22px;
    font-size: 10px;
  }
</style>
