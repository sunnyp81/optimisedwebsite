---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---
<a
  href={href}
  class="block rounded-[20px] p-8 no-underline transition-all duration-300 group"
  style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);"
  onmouseover="this.style.boxShadow='inset 0 0 0 1px rgba(124,58,237,0.3), 0 8px 32px rgba(30,41,59,0.1)'; this.style.transform='translateY(-3px)';"
  onmouseout="this.style.boxShadow='inset 0 0 0 1px var(--color-rule), 0 1px 3px rgba(30,41,59,0.08)'; this.style.transform='';"
>
  <h2 class="text-[17px] font-bold tracking-[-0.02em]" style="color: var(--color-ink);">{title}</h2>
  <p class="mt-2.5 text-[14px] leading-relaxed" style="color: var(--color-ink-2);">{description}</p>
  <span class="inline-flex items-center gap-1.5 mt-4 text-[13px] font-semibold opacity-0 group-hover:opacity-100 transition-opacity duration-200" style="color: var(--color-accent-2);">
    Learn more <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
  </span>
</a>
