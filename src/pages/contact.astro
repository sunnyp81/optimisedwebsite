---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';

const schemaNodes = [
  {
    '@type': 'ContactPage',
    '@id': `${site.url}/contact/#page`,
    name: 'Contact OptimisedWebsite',
    url: `${site.url}/contact/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@id': `${site.url}/#organization`,
      contactPoint: {
        '@type': 'ContactPoint',
        email: site.email,
        contactType: 'customer service',
        availableLanguage: 'English'
      }
    }
  }
];
---
<Base
  title="Contact Us | OptimisedWebsite"
  description="Get in touch with OptimisedWebsite. Email hello@optimisedwebsite.com or use the contact form below."
  canonicalPath="/contact/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[700px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Contact', href: '/contact/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">Contact</div>
      <h1 class="section-title">Contact Us</h1>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink-2);">
        Have a question about our builds, pricing, or process? Send us a message below or email <a href={`mailto:${site.email}`} class="font-medium" style="color: var(--color-accent-2);">{site.email}</a> directly. We reply within 24 hours on working days.
      </p>
    </section>

    <section class="py-10" id="contact-form-section">
      <form id="contact-form" class="space-y-6" novalidate>
        <div>
          <label for="contact-name" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Name <span class="text-red-500">*</span></label>
          <input type="text" id="contact-name" name="name" required autocomplete="name" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="contact-email" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Email <span class="text-red-500">*</span></label>
          <input type="email" id="contact-email" name="email" required autocomplete="email" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="contact-message" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Message <span class="text-red-500">*</span></label>
          <textarea id="contact-message" name="message" rows="5" required class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);"></textarea>
        </div>

        <input type="hidden" name="source" value="optimisedwebsite.com" />

        <!-- Honeypot (FormSubmit drops submissions where _honey is filled) -->
        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input type="text" id="contact-website" name="_honey" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn-glow">
          Send Message
        </button>

        <div id="contact-error" class="hidden mt-4 p-4 rounded-xl text-[14px]" role="alert" style="background: rgba(239,68,68,0.08); box-shadow: inset 0 0 0 1px rgba(239,68,68,0.25); color: var(--color-ink-2);">
          Something went wrong sending your message. Please email <a href={`mailto:${site.email}`} class="font-semibold" style="color: var(--color-accent-2);">{site.email}</a> directly.
        </div>
      </form>

      <div id="contact-success" class="hidden py-10">
        <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Message sent</h2>
        <p class="leading-relaxed" style="color: var(--color-ink-2);">We will reply within 24 hours. Check your inbox (and spam folder) for our response.</p>
      </div>
    </section>
  </div>
</Base>

<script define:vars={{ endpoint: site.formEndpoint }}>
  const form = document.getElementById('contact-form');
  const successDiv = document.getElementById('contact-success');
  const errorDiv = document.getElementById('contact-error');
  const btn = form?.querySelector('button[type="submit"]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    // Honeypot: bail silently if the hidden field was filled
    if (data.get('_honey')) return;

    errorDiv?.classList.add('hidden');
    if (btn) { btn.disabled = true; btn.textContent = 'Sending...'; }

    const body = {
      _subject: 'New contact message: optimisedwebsite.com',
      _template: 'table',
      _captcha: 'false',
    };
    data.forEach((v, k) => { if (k !== '_honey') body[k] = v; });

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || json.success === 'false' || json.success === false) throw new Error('send failed');
      form.classList.add('hidden');
      successDiv?.classList.remove('hidden');
    } catch {
      if (btn) { btn.disabled = false; btn.textContent = 'Send Message'; }
      errorDiv?.classList.remove('hidden');
    }
  });
</script>
