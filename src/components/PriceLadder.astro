---
import { priceLevels } from '../data/pricing';

interface Props {
  headingTag?: 'h2' | 'h3';
}
const { headingTag: H = 'h3' } = Astro.props;
---
<div class="ladder">
  {priceLevels.map((l, i) => {
    const dark = i === priceLevels.length - 1;
    return (
      <article class:list={['ladder-card', dark ? 'pricing-card-dark' : 'pricing-card-wrap']} id={`level-${l.id}`}>
        <p class="ladder-level">{l.level}</p>
        <H class="ladder-name">{l.name}</H>
        <p class="ladder-price tnum">{l.price}</p>
        <p class="ladder-fits">{l.fits}</p>

        <dl class="ladder-facts">
          <div><dt>Size</dt><dd>{l.pages}</dd></div>
          <div><dt>Timescale</dt><dd>{l.timescale}</dd></div>
          <div><dt>Payment</dt><dd>{l.payment}</dd></div>
        </dl>

        <ul class="ladder-list">
          {l.included.map((item) => (
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={dark ? '#fbbf24' : '#10b981'} stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <p class="ladder-up">{l.movesUp}</p>

        <a href="/order/" class:list={['btn w-full justify-center', dark ? 'btn-accent' : 'btn-ghost']} data-analytics-event="cta_click" data-analytics-label={`ladder-${l.id}`}>
          {dark ? 'Request a scoped quote' : 'Get a free build plan'}
        </a>
      </article>
    );
  })}
</div>

<style>
  .ladder {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
    align-items: stretch;
  }
  @media (min-width: 960px) {
    .ladder { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .ladder-card {
    text-align: left;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 640px) {
    .ladder-card { padding: 28px 22px; }
  }
  .ladder-level {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink-3);
    margin-bottom: 6px;
  }
  .ladder-name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
    margin-bottom: 14px;
  }
  .ladder-price {
    font-size: clamp(28px, 2.6vw, 34px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--color-ink);
    margin-bottom: 12px;
  }
  .ladder-fits {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-2);
    margin-bottom: 20px;
    min-height: 3em;
  }
  .ladder-facts {
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    padding: 14px 0;
    margin-bottom: 20px;
    display: grid;
    gap: 8px;
  }
  .ladder-facts div {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 12px;
    font-size: 14px;
    line-height: 1.45;
  }
  .ladder-facts dt { color: var(--color-ink-3); }
  .ladder-facts dd { color: var(--color-ink); font-weight: 500; margin: 0; }
  .ladder-list {
    display: grid;
    gap: 10px;
    margin-bottom: 20px;
  }
  .ladder-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .ladder-list svg { flex-shrink: 0; margin-top: 3px; }
  .ladder-up {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ink-3);
    margin-top: auto;
    margin-bottom: 20px;
    padding-top: 4px;
  }

  /* Dark card: fixed light-on-dark colours in both themes */
  .pricing-card-dark .ladder-level { color: #fcd34d; }
  .pricing-card-dark .ladder-name,
  .pricing-card-dark .ladder-price,
  .pricing-card-dark .ladder-facts dd { color: #f8fafc; }
  .pricing-card-dark .ladder-fits,
  .pricing-card-dark .ladder-list li { color: rgba(248,250,252,0.78); }
  .pricing-card-dark .ladder-facts { border-color: rgba(255,255,255,0.12); }
  .pricing-card-dark .ladder-facts dt,
  .pricing-card-dark .ladder-up { color: rgba(248,250,252,0.62); }
</style>
