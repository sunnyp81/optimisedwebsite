---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import AnimatedCounters from '../components/AnimatedCounters.astro';
import InteractiveTimeline from '../components/InteractiveTimeline.astro';
import PageAnatomy from '../components/PageAnatomy.astro';
import SpeedRace from '../components/SpeedRace.astro';
import GrowthChart from '../components/GrowthChart.astro';
import { site } from '../data/site';
import { caseStudies } from '../data/caseStudies';

const chartColors = ['#10b981', '#7c3aed', '#3b82f6', '#f59e0b', '#ef4444'];

const faqs = [
  {
    q: 'Why Astro and not WordPress?',
    a: 'Astro outputs static HTML by default, with no database or plugin chain to maintain. We performance-test each build before handover and add client-side JavaScript only where it has a clear purpose.'
  },
  {
    q: 'Do you offer ongoing SEO retainers?',
    a: 'No. We build the foundation: architecture, schema, content, technical SEO, then hand it over. Structured to rank without agency fees.'
  },
  {
    q: 'What if I already have a domain?',
    a: 'We deploy to it. You keep DNS, hosting, and source code. Nothing locked to us.'
  },
  {
    q: 'Do you write the content?',
    a: 'Yes, included. We research your niche, map topic clusters, and write every page. You review on staging before launch.'
  },
  {
    q: 'What do I need to provide?',
    a: 'Your niche, location, and services. A ten-minute brief. We handle everything else.'
  },
  {
    q: 'How long does delivery actually take?',
    a: 'Seven days from brief to live. For Pro builds (50 pages), up to fourteen days. We set a deadline before work starts and hit it.'
  },
  {
    q: 'What if I\'m not happy with the result?',
    a: 'You get a live staging link to review before launch. Revisions are included: 30 days for Essential, 90 days for Pro. If the final site doesn\'t meet the brief, we rebuild the pages in question at no extra cost.'
  }
];

const marqueItems = [
  'Performance-tested at launch', 'Sub-second load target', 'AVIF + WebP fallbacks',
  'Edge-cached globally', 'Zero JS by default', 'WCAG 2.2 AA',
  'Core Web Vitals optimised', 'Cloudflare edge hosting', 'From £1,500',
  '7-day delivery', 'Source code yours forever'
];

const essentialItems = [
  'Up to 15 pages', '5 service hubs', 'Bespoke design system',
  'Launch performance audit', 'All copywriting included', 'Entity-linked JSON-LD schema',
  'Cloudflare edge hosting', '7-day delivery', '30 days of polish'
];

const proItems = [
  'Up to 50 pages', 'Full topical authority map', 'CMS integration',
  'Multi-locale support', 'Custom SVG illustrations', 'Cloudflare hosting',
  '90 days polish included', '1 free redesign at 12 months', 'Priority support'
];

const testimonials = [
  {
    scoreBefore: 42,
    scoreAfter: 100,
    quote: "1,082 organic clicks/month and 60.8k impressions across 49 area pages. Position 8.0 average, ranking for 'water hardness' queries in every UK region. No backlinks, no ads.",
    author: "WaterHard.uk",
    role: "Home & Utilities, 49 pages"
  },
  {
    scoreBefore: 0,
    scoreAfter: 100,
    quote: "437 clicks/month from 36.2k impressions. Top page ranks position 7.0 for 'dead hang time by age' with 22.8k impressions alone. 53 pages, all indexing within weeks.",
    author: "DeadHangs.com",
    role: "Health & Fitness, 53 pages"
  },
  {
    scoreBefore: 0,
    scoreAfter: 100,
    quote: "85.8k impressions/month across 211 pages, the largest impression volume in our network. 512 clicks/month ranking for hundreds of long-tail Slimming World queries.",
    author: "SheCooksSheEats.co.uk",
    role: "Food & Diet, 211 pages"
  }
];

const techStack = [
  { name: 'Astro', desc: 'Static-first output', icon: '⟡' },
  { name: 'Tailwind 4', desc: 'Utility-first CSS', icon: '◈' },
  { name: 'Cloudflare Pages', desc: 'Global edge delivery', icon: '☁' },
  { name: 'JSON-LD Schema', desc: '7 to 12 entity types per site', icon: '{}' },
  { name: 'AVIF / WebP', desc: 'Next-gen image formats', icon: '◉' },
  { name: 'Plausible', desc: 'Privacy-first analytics', icon: '~' }
];

const trustNames = [
  'WaterHard.uk', 'SheCooksSheEats', 'DeadHangs.com', 'RentalYield.uk',
  'BestVibrationPlates', 'HeatPumpChecker', 'SolarHQ.uk', 'KnotweedCheck'
];

const schemaNodes = [
  {
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#service`,
    name: site.name,
    description: site.description,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    priceRange: site.priceRange
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a }
    }))
  }
];
---
<Base
  title={`${site.name}: SEO-Optimised Website Builds for UK Businesses`}
  description={site.description}
  canonicalPath="/"
  schemaNodes={schemaNodes}
>

  <!-- ===== HERO ===== -->
  <section class="relative min-h-screen flex items-center pt-[80px] pb-[60px] overflow-hidden">
    <!-- Dotted grid bg -->
    <div class="grid-bg"></div>
    <!-- Ambient blobs -->
    <div class="hero-blob hero-blob-amber" aria-hidden="true"></div>
    <div class="hero-blob hero-blob-violet" aria-hidden="true"></div>

    <div class="wrap relative z-[2] w-full">
      <div class="grid md:grid-cols-[1.05fr_1fr] gap-16 items-center">
        <!-- Left: text -->
        <div>
          <div class="eyebrow animate-fade-up">Built in Britain &middot; Shipping in 7 days</div>

          <h1 class="animate-fade-up mb-6" style="animation-delay: 0.1s;">
            SEO Websites That<br>
            <span class="gradient-text-hero">Get Found.</span>
          </h1>

          <p class="text-[18px] leading-[1.6] mb-8 max-w-[480px] animate-fade-up" style="color: var(--color-ink-2); animation-delay: 0.2s;">
            Websites built to rank — not just look good. Static-first performance, lean pages, and SEO architecture designed to turn search traffic into enquiries. From £1,500. Live in one week.
          </p>

          <div class="flex gap-3 flex-wrap animate-fade-up" style="animation-delay: 0.3s;">
            <a href="/order/" class="btn btn-primary">Get your free build plan &rarr;</a>
            <a href="#processTrack" class="btn btn-ghost">See how it works</a>
          </div>

          <!-- Stats row -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 pt-10 animate-fade-up" style="border-top: 1px solid var(--color-rule); animation-delay: 0.4s;">
            <div>
              <div class="text-[28px] font-semibold tracking-[-0.04em] tnum" style="color: var(--color-ink);">100</div>
              <div class="mono text-[10px] uppercase mt-1" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Lighthouse target</div>
            </div>
            <div>
              <div class="text-[28px] font-semibold tracking-[-0.04em] tnum" style="color: var(--color-ink);">&lt;1s</div>
              <div class="mono text-[10px] uppercase mt-1" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Load target</div>
            </div>
            <div>
              <div class="text-[28px] font-semibold tracking-[-0.04em] tnum" style="color: var(--color-ink);">&lt;100kb</div>
              <div class="mono text-[10px] uppercase mt-1" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Page target</div>
            </div>
            <div>
              <div class="text-[28px] font-semibold tracking-[-0.04em] tnum" style="color: var(--color-ink);">7 days</div>
              <div class="mono text-[10px] uppercase mt-1" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Delivered</div>
            </div>
          </div>
        </div>

        <!-- Right: Lighthouse gauge card -->
        <div class="hidden md:block animate-fade-up" style="animation-delay: 0.35s;">
          <div class="card p-8 relative hero-gauge-card" style="box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-xl);">
            <!-- Browser chrome -->
            <div class="flex items-center gap-1.5 mb-6 pb-5" style="border-bottom: 1px solid var(--color-rule);">
              <span class="w-2.5 h-2.5 rounded-full" style="background:#ff5f57;"></span>
              <span class="w-2.5 h-2.5 rounded-full" style="background:#febc2e;"></span>
              <span class="w-2.5 h-2.5 rounded-full" style="background:#28c840;"></span>
              <div class="flex-1 mx-3 rounded-md px-3 py-1.5 mono text-[11px]" style="background: var(--color-bg-2); color: var(--color-ink-3); border: 1px solid var(--color-rule);">
                lighthouse report &middot; your-site.co.uk
              </div>
            </div>

            <!-- 4 gauges -->
            <div class="grid grid-cols-4 gap-3 mb-6">
              {[
                { label: 'Performance', score: 100, color: '#10b981' },
                { label: 'Accessibility', score: 100, color: '#10b981' },
                { label: 'Best Practices', score: 100, color: '#10b981' },
                { label: 'SEO', score: 100, color: '#10b981' }
              ].map((gauge) => (
                <div class="text-center">
                  <svg width="60" height="60" viewBox="0 0 60 60" class="mx-auto mb-2">
                    <circle cx="30" cy="30" r="24" fill="none" stroke="var(--color-rule)" stroke-width="4"/>
                    <circle
                      cx="30" cy="30" r="24" fill="none"
                      stroke={gauge.color} stroke-width="4"
                      stroke-dasharray={`${(gauge.score / 100) * 150.8} 150.8`}
                      stroke-linecap="round"
                      transform="rotate(-90 30 30)"
                      class="gauge-ring"
                    />
                    <text x="30" y="35" text-anchor="middle" font-size="14" font-weight="600" fill={gauge.color} font-family="Geist Mono, monospace">{gauge.score}</text>
                  </svg>
                  <div class="mono text-[10px] uppercase" style="color: var(--color-ink-3); letter-spacing: 0.05em;">{gauge.label}</div>
                </div>
              ))}
            </div>

            <!-- CWV metrics -->
            <div class="rounded-xl p-4" style="background: var(--color-bg); border: 1px solid var(--color-rule);">
              <div class="mono text-[10px] uppercase mb-3" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Core Web Vitals</div>
              <div class="space-y-2">
                {[
                  { label: 'LCP', value: '0.8s', ok: true },
                  { label: 'FID', value: '12ms', ok: true },
                  { label: 'CLS', value: '0.00', ok: true }
                ].map((m) => (
                  <div class="flex justify-between items-center">
                    <span class="mono text-[11px]" style="color: var(--color-ink-2);">{m.label}</span>
                    <span class={m.ok ? 'chip chip-ok' : 'chip chip-warn'}>{m.value}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PERFORMANCE MARQUEE (dark strip) ===== -->
  <div class="section-dark py-5 overflow-hidden relative z-[2]" style="border-top: 1px solid rgba(251,191,36,0.1); border-bottom: 1px solid rgba(251,191,36,0.1);">
    <div class="ticker-track">
      {[...marqueItems, ...marqueItems].map((item, i) => (
        <div class="flex items-center gap-2.5 whitespace-nowrap mono text-[12px] font-medium" style="color: rgba(248,250,252,0.7);">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style={`background: ${i % 3 === 0 ? 'var(--color-accent)' : i % 3 === 1 ? 'var(--color-ok)' : 'var(--color-accent-2)'};`}></span>
          {item}
        </div>
      ))}
    </div>
  </div>

  <!-- ===== NETWORK STATS (animated counters) ===== -->
  <AnimatedCounters counters={[
    { value: 568, suffix: '+', label: 'Pages built' },
    { value: 227, suffix: 'k', label: 'Monthly impressions' },
    { value: 2129, suffix: '+', label: 'Monthly clicks' },
    { value: 44, suffix: '+', label: 'Sites in network' }
  ]} />

  <!-- ===== TEMPLATE GALLERY ===== -->
  <section class="section">
    <div class="wrap">
      <div class="reveal mb-12">
        <div class="eyebrow">Our work</div>
        <h2>SEO Websites We've Built and Ranked</h2>
        <p class="text-[17px] mt-4 max-w-[480px]" style="color: var(--color-ink-2);">Selected live sites from our network. See the portfolio for each site's current search metric and build details.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 reveal">
        {caseStudies.slice(0, 4).map((item, i) => (
          <a
            href={`/case-studies/#${item.slug}`}
            class="group block rounded-[16px] overflow-hidden no-underline"
            style="box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); background: var(--color-paper); transition: transform 0.2s, box-shadow 0.2s;"
            onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='inset 0 0 0 1px var(--color-rule-2), 0 12px 40px rgba(30,41,59,0.12)';"
            onmouseout="this.style.transform=''; this.style.boxShadow='inset 0 0 0 1px var(--color-rule), 0 1px 3px rgba(30,41,59,0.08)';"
          >
            <!-- Chart preview -->
            <div class="px-5 pt-5 pb-3" style="background: linear-gradient(180deg, var(--color-bg-2), var(--color-paper));">
              <div class="flex items-start justify-between gap-2 mb-1">
                <div>
                  <h3 class="text-[15px] font-semibold tracking-[-0.02em]" style="color: var(--color-ink);">{item.name}</h3>
                  <span class="mono text-[11px]" style="color: var(--color-ink-3);">{item.url.replace('https://', '')}</span>
                </div>
                <span class="chip chip-ok flex-shrink-0">{item.metric}</span>
              </div>
              <GrowthChart data={item.growth} label="Impressions per month (k)" color={chartColors[i % chartColors.length]} height={108} />
            </div>
            <!-- Card body -->
            <div class="p-5" style="border-top: 1px solid var(--color-rule);">
              <p class="text-[13px] leading-[1.6] mb-4" style="color: var(--color-ink-2);">{item.description}</p>
              <div class="flex items-center justify-between gap-3">
                <div class="flex gap-2">
                  <span class="chip">{item.niche}</span>
                  <span class="chip">{item.pageCount} pages</span>
                </div>
                <span class="text-[13px] font-medium transition-transform duration-200 group-hover:translate-x-0.5" style="color: var(--violet-text);">Case study &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10 reveal flex gap-3 justify-center flex-wrap">
        <a href="/case-studies/" class="btn btn-primary">Read the case studies &rarr;</a>
        <a href="/portfolio/" class="btn btn-ghost">View all projects</a>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS (interactive timeline) ===== -->
  <section class="section" style="background: var(--color-bg-2);" id="processTrack">
    <div class="wrap">
      <div class="reveal text-center mb-14">
        <div class="eyebrow" style="justify-content: center;">How it works</div>
        <h2>How Your SEO Website Build Works</h2>
        <p class="text-[15px] mt-4 max-w-[480px] mx-auto" style="color: var(--color-ink-2);">Click each step to see exactly what happens and what you get.</p>
      </div>

      <div class="reveal">
        <InteractiveTimeline steps={[
          {
            num: '01',
            title: 'Send your brief',
            summary: 'A ten-minute form covering your niche, location, and services. We ask the right questions so nothing gets missed.',
            details: ['Business niche and target location', 'Core services or product categories', 'Competitor URLs (if known)', 'Preferred domain or existing domain'],
            duration: '10 min'
          },
          {
            num: '02',
            title: 'Keyword research & topic mapping',
            summary: 'We pull real search volume data from Ahrefs and GSC, then map every keyword cluster to a page with clear search intent.',
            details: ['Seed keyword expansion via Ahrefs', 'Search intent classification per cluster', 'Topic authority map with hub/spoke structure', 'Content brief per page with target H2s'],
            duration: 'Day 1-2'
          },
          {
            num: '03',
            title: 'Architecture & schema design',
            summary: 'URL hierarchy, internal linking strategy, and JSON-LD schema graph, designed before a single line of code is written.',
            details: ['Flat URL structure (max 2 levels deep)', 'JSON-LD @graph with 7-12 entity types', 'Breadcrumb and FAQ schema per page', 'Internal link map with anchor text plan'],
            duration: 'Day 2-3'
          },
          {
            num: '04',
            title: 'Content writing',
            summary: 'Every page written to micro-semantic standards. Answers first, zero fluff, keyword-bearing headings, specification sentences.',
            details: ['95%+ answer-first sentence structure', 'Zero LLM fluff words (delve, unlock, seamless)', 'Unique H2s per search intent', 'Entity-focused content with clear topical boundaries'],
            duration: 'Day 3-5'
          },
          {
            num: '05',
            title: 'Astro build & performance tuning',
            summary: 'Static HTML by default, AVIF images, preconnected fonts, and edge-cached delivery. Performance is audited before handover.',
            details: ['Astro static site generation', 'Tailwind 4 utility CSS', 'AVIF + WebP image pipeline', 'Cloudflare Pages edge deployment'],
            duration: 'Day 5-6'
          },
          {
            num: '06',
            title: 'Launch & index',
            summary: 'Deploy to your domain, submit sitemaps to Google and Bing, ping IndexNow, verify Core Web Vitals live. Done.',
            details: ['DNS configuration + SSL', 'GSC + Bing Webmaster Tools setup', 'XML sitemap + IndexNow submission', 'Live Lighthouse audit verification'],
            duration: 'Day 7'
          }
        ]} />
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section class="section">
    <div class="wrap">
      <div class="reveal text-center mb-14">
        <div class="eyebrow" style="justify-content: center;">Pricing</div>
        <h2>SEO Website Pricing</h2>
        <p class="text-[17px] mt-4 max-w-[520px] mx-auto" style="color: var(--color-ink-2);">Two tiers. Fixed price. No retainers, no hidden fees.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-[860px] mx-auto reveal">
        <!-- Essential -->
        <div class="pricing-card-wrap">
          <div class="mono text-[11px] uppercase mb-4" style="color: var(--color-ink-3); letter-spacing: 0.1em;">Essential</div>
          <div class="text-[52px] font-semibold tracking-[-0.04em] leading-none mb-2" style="color: var(--color-ink);">£1,500</div>
          <p class="text-[14px] mb-8" style="color: var(--color-ink-2);">Fixed price. Confirmed before work starts.</p>
          <ul class="space-y-2.5 text-left mb-10 pb-8" style="border-bottom: 1px solid var(--color-rule);">
            {essentialItems.map((item) => (
              <li class="flex items-center gap-2.5 text-[14px]" style="color: var(--color-ink-2);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/order/" class="btn btn-ghost w-full justify-center">Get free plan — Essential</a>
        </div>

        <!-- Pro (dark) -->
        <div class="pricing-card-dark relative" style="box-shadow: inset 0 0 0 1px rgba(251,191,36,0.2), 0 20px 60px rgba(30,41,59,0.2), 0 0 60px rgba(251,191,36,0.08);">
          <!-- Most popular badge -->
          <div class="absolute top-5 right-5 chip chip-accent">Most popular</div>
          <div class="mono text-[11px] uppercase mb-4" style="color: rgba(248,250,252,0.6); letter-spacing: 0.1em;">Pro</div>
          <div class="text-[52px] font-semibold tracking-[-0.04em] leading-none mb-2" style="color: var(--color-on-dark);">£3,000</div>
          <p class="text-[14px] mb-8" style="color: rgba(248,250,252,0.55);">Everything in Essential, plus full topical authority.</p>
          <ul class="space-y-2.5 text-left mb-10 pb-8" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
            {proItems.map((item) => (
              <li class="flex items-center gap-2.5 text-[14px]" style="color: rgba(248,250,252,0.7);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/order/" class="btn btn-accent w-full justify-center">Get free plan — Pro</a>
        </div>
      </div>

      <p class="text-center mt-8 text-[15px] reveal" style="color: var(--color-ink-2);">
        Need bespoke? <a href="/contact/" class="font-semibold" style="color: var(--color-accent-2);">Get a custom quote</a>, typically £6k to £15k.
      </p>
    </div>
  </section>

  <!-- ===== TRUST LOGOS ===== -->
  <section class="py-16" style="border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule);">
    <div class="wrap">
      <div class="flex items-center justify-center gap-3 mb-10">
        <div class="h-px flex-1 max-w-[80px]" style="background: linear-gradient(90deg, transparent, var(--color-rule));"></div>
        <div class="mono text-[11px] uppercase" style="color: var(--color-ink-3); letter-spacing: 0.1em;">44+ sites in our network &middot; performance-tested before handover</div>
        <div class="h-px flex-1 max-w-[80px]" style="background: linear-gradient(90deg, var(--color-rule), transparent);"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {trustNames.map((name, i) => (
          <div class="flex items-center justify-center gap-2 py-4 px-5 rounded-xl" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule); transition: box-shadow 0.2s, transform 0.2s;">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background: ${['#fbbf24','#7c3aed','#10b981','#3b82f6','#f59e0b','#8b5cf6','#059669','#2563eb'][i]};`}></span>
            <span class="mono text-[12px] font-medium" style="color: var(--color-ink-2);">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="section">
    <div class="wrap">
      <div class="reveal mb-12">
        <div class="eyebrow">Results</div>
        <h2>Verified Ranking Results From Our Network</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-5 reveal">
        {testimonials.map((t, i) => (
          <div class="card" style="padding: 32px 28px;">
            <!-- Score chips -->
            <div class="flex items-center gap-3 mb-6">
              {t.scoreBefore > 0 ? (
                <>
                  <span class="score-before">{t.scoreBefore}/100</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-ink-3)" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </>
              ) : (
                <span class="chip">New build</span>
              )}
              <span class="score-after">{t.scoreAfter}/100</span>
            </div>
            <p class="text-[14px] leading-[1.7] mb-6" style="color: var(--color-ink-2);">
              {t.quote}
            </p>
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full flex-shrink-0 flex items-center justify-center" style={`background: linear-gradient(135deg, ${['#fbbf24','#7c3aed','#10b981'][i]} 0%, ${['#7c3aed','#10b981','#fbbf24'][i]} 100%);`}>
