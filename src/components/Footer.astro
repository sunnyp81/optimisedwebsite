---
import { site } from '../data/site';
import { footerNav } from '../data/navigation';

const year = new Date().getFullYear();
---
<footer class="relative border-t border-line z-[2]">
  <div class="footer-glow"></div>

  <div class="max-w-[1100px] mx-auto px-10 pt-14 pb-7">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr] gap-10 pb-12">
      <div>
        <a href="/" class="font-extrabold text-text text-sm tracking-[-0.03em] inline-flex items-center no-underline">
          {site.name}<span class="w-[5px] h-[5px] rounded-full bg-brand ml-[1px]" style="box-shadow: 0 0 10px var(--color-brand-glow);"></span>
        </a>
        <p class="text-text-dimmer text-sm max-w-[280px] mt-3.5 leading-relaxed">
          SEO-optimised websites for UK businesses. Built in Astro, deployed on Cloudflare, structured to rank from day one.
        </p>
      </div>

      <div>
        <h4 class="text-[11px] font-bold text-text-dimmer uppercase tracking-[0.08em] mb-4">Services</h4>
        <ul class="space-y-2.5">
          {footerNav.services.map((item) => (
            <li><a href={item.href} class="text-text-dimmer text-sm no-underline hover:text-text-muted transition-colors duration-200">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-[11px] font-bold text-text-dimmer uppercase tracking-[0.08em] mb-4">Learn</h4>
        <ul class="space-y-2.5">
          {footerNav.learn.map((item) => (
            <li><a href={item.href} class="text-text-dimmer text-sm no-underline hover:text-text-muted transition-colors duration-200">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-[11px] font-bold text-text-dimmer uppercase tracking-[0.08em] mb-4">Company</h4>
        <ul class="space-y-2.5">
          {footerNav.company.map((item) => (
            <li><a href={item.href} class="text-text-dimmer text-sm no-underline hover:text-text-muted transition-colors duration-200">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-line pt-5 flex flex-wrap justify-between items-center gap-3 text-text-dimmer text-[13px]">
      <div>&copy; {year} {site.name}. All rights reserved.</div>
      <div class="flex gap-5">
        <a href="/privacy/" class="text-text-dimmer no-underline hover:text-text-muted transition-colors duration-200">Privacy</a>
        <a href="/terms/" class="text-text-dimmer no-underline hover:text-text-muted transition-colors duration-200">Terms</a>
      </div>
    </div>
  </div>
</footer>
