---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTA from '../components/CTA.astro';
import GrowthChart from '../components/GrowthChart.astro';
import { site } from '../data/site';
import { caseStudies } from '../data/caseStudies';

const chartColors = ['#10b981', '#7c3aed', '#3b82f6', '#f59e0b', '#ef4444'];

const schemaNodes = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/case-studies/#page`,
    name: 'SEO Website Case Studies',
    description: 'Case studies of SEO-optimised websites built by OptimisedWebsite. Architecture decisions, schema implementation, and first-party Search Console results.',
    url: `${site.url}/case-studies/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: caseStudies.length,
      itemListElement: caseStudies.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: item.name,
          url: `${site.url}/case-studies/${item.slug}/`,
          description: item.description,
          creator: { '@id': `${site.url}/#organization` },
        },
      })),
    },
  },
];
---
<Base
  title="SEO Website Case Studies | OptimisedWebsite"
  description="Case studies of SEO-optimised websites built by OptimisedWebsite. Architecture decisions, schema implementation, and first-party Search Console results."
  canonicalPath="/case-studies/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Case Studies', href: '/case-studies/' },
    ]} />

    <section class="py-10">
      <div class="section-tag">Case Studies</div>
      <h1 class="section-title">SEO Website <span class="gradient-text">Case Studies</span></h1>
      <p class="section-desc max-w-2xl">
        Five sites from our own network, each grown from a standing start. Every case study covers the challenge, the architecture and schema we shipped, and the first-party Search Console numbers that followed.
      </p>
      <p class="text-[13px] mt-4 max-w-2xl" style="color: var(--color-ink-3);">
        These are owned and operated portfolio properties, not client campaigns. Every figure is our own Search Console data, disclosed as such on each case study page.
      </p>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <section class="pb-16 reveal">
      <div class="grid md:grid-cols-2 gap-5">
        {caseStudies.map((study, i) => (
          <a
            href={`/case-studies/${study.slug}/`}
            class="group block rounded-[16px] overflow-hidden no-underline"
            style="box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); background: var(--color-paper);"
          >
            <div class="px-6 pt-6 pb-3" style="background: linear-gradient(180deg, var(--color-bg-2), var(--color-paper));">
              <div class="flex items-start justify-between gap-2 mb-1">
                <div>
                  <h2 class="text-[17px] font-semibold tracking-[-0.02em]" style="color: var(--color-ink);">{study.name}</h2>
                  <span class="mono text-[11px]" style="color: var(--color-ink-3);">{study.url.replace('https://', '')}</span>
                </div>
                <span class="chip chip-ok flex-shrink-0">{study.metric}</span>
              </div>
              <GrowthChart data={study.growth} label={study.growthLabel} color={chartColors[i % chartColors.length]} height={120} />
            </div>
            <div class="p-6" style="border-top: 1px solid var(--color-rule);">
              <p class="text-[13px] leading-[1.6] mb-4" style="color: var(--color-ink-2);">{study.description}</p>
              <div class="flex items-center justify-between gap-3">
                <div class="flex gap-2">
                  <span class="chip">{study.niche}</span>
                  <span class="chip">{study.pageCount} pages</span>
                </div>
                <span class="text-[13px] font-medium" style="color: var(--violet-text);">Read case study &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="py-16 text-center">
      <p class="mb-6 text-lg" style="color: var(--color-ink-2);">Want a written diagnosis of your own site first?</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <CTA href="/free-website-growth-review/" label="Get a Free Growth Review" analyticsEvent="cta_click" analyticsLabel="case-studies-hub" />
        <CTA href="/pricing/" label="See Pricing" variant="secondary" />
      </div>
    </section>
  </div>
</Base>
