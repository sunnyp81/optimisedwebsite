---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';

const schemaNodes = [
  {
    '@type': 'ContactPage',
    '@id': `${site.url}/contact/#page`,
    name: 'Contact OptimisedWebsite',
    url: `${site.url}/contact/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@id': `${site.url}/#organization`,
      contactPoint: {
        '@type': 'ContactPoint',
        email: site.email,
        contactType: 'customer service',
        availableLanguage: 'English'
      }
    }
  }
];
---
<Base
  title="Contact Us | OptimisedWebsite"
  description="Get in touch with OptimisedWebsite. Email hello@optimisedwebsite.com or use the contact form below."
  canonicalPath="/contact/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[700px] mx-auto px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Contact', href: '/contact/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">Contact</div>
      <h1 class="section-title">Contact Us</h1>
      <p class="mt-4 text-lg text-text-muted leading-relaxed">
        Have a question about our builds, pricing, or process? Send us a message below or email <a href={`mailto:${site.email}`} class="text-brand hover:text-brand-light font-medium">{site.email}</a> directly. We reply within 24 hours on working days.
      </p>
    </section>

    <section class="py-10" id="contact-form-section">
      <form id="contact-form" class="space-y-6" novalidate>
        <div>
          <label for="contact-name" class="block text-sm font-semibold text-text mb-1">Name <span class="text-red-500">*</span></label>
          <input type="text" id="contact-name" name="name" required autocomplete="name" class="w-full bg-bg-2 border border-line rounded-[12px] px-4 py-3 text-text focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="contact-email" class="block text-sm font-semibold text-text mb-1">Email <span class="text-red-500">*</span></label>
          <input type="email" id="contact-email" name="email" required autocomplete="email" class="w-full bg-bg-2 border border-line rounded-[12px] px-4 py-3 text-text focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="contact-message" class="block text-sm font-semibold text-text mb-1">Message <span class="text-red-500">*</span></label>
          <textarea id="contact-message" name="message" rows="5" required class="w-full bg-bg-2 border border-line rounded-[12px] px-4 py-3 text-text focus:outline-none focus:ring-2 focus:ring-brand"></textarea>
        </div>

        <input type="hidden" name="source" value="optimisedwebsite.com" />

        <!-- Honeypot -->
        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="btn-glow">
          Send Message
        </button>
      </form>

      <div id="contact-success" class="hidden py-10">
        <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Message sent</h2>
        <p class="text-text-muted leading-relaxed">We will reply within 24 hours. Check your inbox (and spam folder) for our response.</p>
      </div>
    </section>
  </div>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successDiv = document.getElementById('contact-success') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    // Honeypot check
    if (data.get('website')) return;

    const body: Record<string, string> = {};
    data.forEach((v, k) => { if (k !== 'website') body[k] = v as string; });

    try {
      const res = await fetch('https://aaa-intake.sunnypat81.workers.dev', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(`${res.status}`);
      form.classList.add('hidden');
      successDiv.classList.remove('hidden');
    } catch {
      alert('Something went wrong. Please email hello@optimisedwebsite.com directly.');
    }
  });
</script>
