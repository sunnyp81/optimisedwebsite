---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';

const schemaNodes = [
  {
    '@type': 'Service',
    '@id': `${site.url}/order/#service`,
    name: 'Free SEO Website Build Plan',
    description: 'Request a free SEO website build plan. Tell us about your business and we will reply within 24 hours with proposed scope, timeline, and price.',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United Kingdom' }
  }
];
---
<Base
  title="Get Your Free SEO Website Build Plan | OptimisedWebsite"
  description="Tell us about your business and get a free build plan: proposed page count, timeline, and fixed price within 24 hours. No obligation to proceed."
  canonicalPath="/order/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[700px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Free Build Plan', href: '/order/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">Free Build Plan</div>
      <h1 class="section-title">Get Your Free SEO Website Build Plan</h1>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink-2);">
        Tell us about your business below. We review every submission manually and reply within 24 hours with a proposed page count, timeline, and fixed price between &pound;1,500 and &pound;3,000. No payment and no obligation to proceed — it's a free plan, not an order. Prefer email? Send your brief to <a href={`mailto:${site.email}`} class="font-medium" style="color: var(--color-accent-2);" data-analytics-event="email_click" data-analytics-label="order-intro">{site.email}</a> instead.
      </p>
    </section>

    <section class="py-10" id="order-form-section">
      <form id="order-form" class="space-y-6">
        <div>
          <label for="name" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Name <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Email <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="phone" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Phone <span class="font-normal" style="color: var(--color-ink-2);">(optional)</span></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="niche" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Niche / Industry <span class="text-red-500">*</span></label>
          <input type="text" id="niche" name="niche" required placeholder="e.g. Home insurance, Personal training, SaaS" class="w-full rounded-[12px] px-4 py-3 placeholder:text-[#6b7280] focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="audience" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Target Audience <span class="font-normal" style="color: var(--color-ink-2);">(optional)</span></label>
          <input type="text" id="audience" name="audience" placeholder="e.g. UK homeowners, B2B decision makers" class="w-full rounded-[12px] px-4 py-3 placeholder:text-[#6b7280] focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="domain" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Domain <span class="font-normal" style="color: var(--color-ink-2);">(optional)</span></label>
          <input type="text" id="domain" name="domain" placeholder="e.g. example.co.uk" class="w-full rounded-[12px] px-4 py-3 placeholder:text-[#6b7280] focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="competitors" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Competitors <span class="font-normal" style="color: var(--color-ink-2);">(optional)</span></label>
          <textarea id="competitors" name="competitors" rows="3" placeholder="List competitor websites, one per line" class="w-full rounded-[12px] px-4 py-3 placeholder:text-[#6b7280] focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);"></textarea>
        </div>

        <div>
          <label for="budget" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Budget</label>
          <select id="budget" name="budget" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);">
            <option value="1500-2000">&pound;1,500 to &pound;2,000</option>
            <option value="2000-2500">&pound;2,000 to &pound;2,500</option>
            <option value="2500-3000">&pound;2,500 to &pound;3,000</option>
          </select>
        </div>

        <input type="hidden" name="source" value="optimisedwebsite.com" />
        <input type="hidden" name="form_type" value="order" />

        <!-- Honeypot: submissions that fill this visually hidden field are discarded. -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" id="order-submit" class="btn-glow">
          Request My Free Build Plan
        </button>

        <div id="order-status" role="status" aria-live="polite" aria-atomic="true" class="mt-4 text-[14px]"></div>

        <div class="mt-4 flex flex-wrap gap-4 text-[12px]" style="color: var(--color-ink-3);">
          <span class="flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            We reply within 24 hours
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            No payment, no obligation
          </span>
          <span class="flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Your data is never shared
          </span>
        </div>
      </form>

      <div id="order-success" class="hidden py-10" tabindex="-1">
        <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Request received</h2>
        <p class="leading-relaxed" style="color: var(--color-ink-2);">We will review your brief and reply within 24 hours with your proposed page count, timeline, and price. Check your inbox (and spam folder) for our response.</p>
      </div>
    </section>
  </div>

  <script>
  const form = document.getElementById('order-form') as HTMLFormElement;
  const submitBtn = document.getElementById('order-submit') as HTMLButtonElement;
  const statusEl = document.getElementById('order-status') as HTMLDivElement;
  const successDiv = document.getElementById('order-success') as HTMLDivElement;

  const gtag = (...args: unknown[]) => {
    const w = window as unknown as { gtag?: (...a: unknown[]) => void };
    if (typeof w.gtag === 'function') w.gtag(...args);
  };

  let startedTracked = false;
  form.addEventListener('focusin', () => {
    if (!startedTracked) {
      startedTracked = true;
      gtag('event', 'form_start', { form_id: 'order-form' });
    }
  }, { once: true });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    // Honeypot check — silently drop, no error shown to the (likely bot) submitter
    if (data.get('website')) return;

    const body = Object.fromEntries(data.entries()) as Record<string, string>;
    body.landing_page = location.pathname;
    body.referrer = document.referrer || '';
    const params = new URLSearchParams(location.search);
    (['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'] as const).forEach((key) => {
      const value = params.get(key);
      if (value) body[key] = value;
    });

    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-busy', 'true');
    statusEl.setAttribute('role', 'status');
    statusEl.textContent = 'Sending your brief…';

    try {
      const res = await fetch('/api/intake', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await res.json().catch(() => ({ ok: false }));
      if (!res.ok || !result.ok) throw new Error(`${res.status}`);

      statusEl.textContent = '';
      form.classList.add('hidden');
      successDiv.classList.remove('hidden');
      successDiv.focus();
      gtag('event', 'generate_lead', { form_id: 'order-form' });
    } catch {
      statusEl.setAttribute('role', 'alert');
      statusEl.textContent = '';
      statusEl.append('Something went wrong sending your brief. Please try again, or email ');
      const link = document.createElement('a');
      link.href = 'mailto:hello@optimisedwebsite.com';
      link.className = 'font-medium';
      link.style.color = 'var(--color-accent-2)';
      link.textContent = 'hello@optimisedwebsite.com';
      link.setAttribute('data-analytics-event', 'email_click');
      link.setAttribute('data-analytics-label', 'order-form-error');
      statusEl.append(link, ' directly.');
      submitBtn.disabled = false;
      submitBtn.removeAttribute('aria-busy');
      gtag('event', 'form_error', { form_id: 'order-form' });
    }
  });
  </script>
</Base>
