---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { portfolio } from '../data/portfolio';

const faqs = [
  {
    q: 'Why Astro and not WordPress?',
    a: 'Astro outputs pure static HTML. No JavaScript runtime, no database, no plugin chain. Lighthouse 100, sub-second loads, zero maintenance. WordPress fights technical debt; Astro sites spend that time ranking.'
  },
  {
    q: 'Do you offer ongoing SEO retainers?',
    a: 'No. We build the foundation — architecture, schema, content, technical SEO — then hand it over. Structured to rank without agency fees.'
  },
  {
    q: 'What if I already have a domain?',
    a: 'We deploy to it. You keep DNS, hosting, and source code. Nothing locked to us.'
  },
  {
    q: 'Do you write the content?',
    a: 'Yes — included. We research your niche, map topic clusters, and write every page. You review on staging before launch.'
  },
  {
    q: 'What do I need to provide?',
    a: 'Your niche, location, and services. A ten-minute brief. We handle everything else.'
  },
  {
    q: 'How long does delivery actually take?',
    a: 'Seven days from brief to live. For Pro builds (50 pages), up to fourteen days. We set a deadline before work starts and hit it.'
  }
];

const marqueItems = [
  'Lighthouse 100/100', 'First paint < 0.5s', 'AVIF + WebP fallbacks',
  'Edge-cached globally', 'Zero JS by default', 'WCAG 2.2 AA',
  'Core Web Vitals green', '100% uptime', 'No tracking, no banners',
  'From £1,500', '7-day delivery', 'Source code yours forever'
];

const steps = [
  {
    num: '01',
    title: 'Send your brief',
    desc: 'Niche, location, services. A ten-minute form. We ask the right questions so nothing gets missed.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`
  },
  {
    num: '02',
    title: 'We research & build',
    desc: 'Topic mapping, schema design, copywriting, Astro build. You get a live staging link to review.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><polyline points="8 6 3 12 8 18"/><polyline points="16 6 21 12 16 18"/><line x1="13.5" y1="5" x2="10.5" y2="19"/></svg>`
  },
  {
    num: '03',
    title: 'Ship in 7 days',
    desc: 'Deploy to your domain. Cloudflare edge hosting. Audits run live. Sitemaps submitted. Done.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`
  }
];

const essentialItems = [
  'Up to 15 pages', '5 service hubs', 'Bespoke design system',
  'Lighthouse 100/100', 'All copywriting included', 'Entity-linked JSON-LD schema',
  'Cloudflare edge hosting', '7-day delivery', '30 days of polish'
];

const proItems = [
  'Up to 50 pages', 'Full topical authority map', 'CMS integration',
  'Multi-locale support', 'Custom SVG illustrations', 'Lifetime Cloudflare hosting',
  '90 days polish included', '1 free redesign at 12 months', 'Priority support'
];

const testimonials = [
  {
    scoreBefore: 42,
    scoreAfter: 100,
    quote: "We went from invisible to ranking top 3 for our main service terms within six weeks. The schema work alone changed how Google describes our business.",
    author: "Sarah M.",
    role: "Owner, Home Services Company"
  },
  {
    scoreBefore: 58,
    scoreAfter: 100,
    quote: "Every page loads in under half a second. Our bounce rate dropped 34% in the first month. This is what a properly built site feels like.",
    author: "James R.",
    role: "Director, Legal Services Firm"
  },
  {
    scoreBefore: 31,
    scoreAfter: 100,
    quote: "I thought £1,500 was expensive until I saw what we were missing. We recovered the cost in clicks within the first 90 days.",
    author: "Priya T.",
    role: "Founder, Wellness Clinic"
  }
];

const techStack = [
  { name: 'Astro 5', desc: 'Zero-JS static output', icon: '⟡' },
  { name: 'Tailwind 4', desc: 'Utility-first CSS', icon: '◈' },
  { name: 'Cloudflare Pages', desc: 'Global edge delivery', icon: '☁' },
  { name: 'JSON-LD Schema', desc: '7–12 entity types per site', icon: '{}' },
  { name: 'AVIF / WebP', desc: 'Next-gen image formats', icon: '◉' },
  { name: 'Plausible', desc: 'Privacy-first analytics', icon: '~' }
];

const compareRows = [
  { label: 'Lighthouse score', us: '100/100', diy: '55–75', agency: '60–80' },
  { label: 'Page weight', us: '<100 KB', diy: '2–8 MB', agency: '1–4 MB' },
  { label: 'First paint', us: '0.4s', diy: '3–8s', agency: '2–5s' },
  { label: 'Delivery', us: '7 days', diy: 'Never', agency: '6–12 wks' },
  { label: 'Cost', us: '£1,500', diy: '£0 + time', agency: '£5–30k' },
  { label: 'You own the code', us: true, diy: false, agency: false },
  { label: 'Trackers injected', us: false, diy: true, agency: true },
  { label: 'Edits after launch', us: 'Included (30d)', diy: 'You do it', agency: '£££/hr' }
];

const trustNames = [
  'WaterHard UK', 'BestVibrationPlates', 'Calculator.place', 'TowRating.net',
  'FixError.dev', 'DeadHangs.com', 'SolarHQ.uk', 'HeatPumpChecker'
];

const schemaNodes = [
  {
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#service`,
    name: site.name,
    description: site.description,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    priceRange: site.priceRange
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a }
    }))
  }
];
---
<Base
  title={`${site.name} — SEO-Optimised Website Builds for UK Businesses`}
  description={site.description}
  canonicalPath="/"
  schemaNodes={schemaNodes}
>

  <!-- ===== HERO ===== -->
  <section class="relative min-h-screen flex items-center pt-[80px] pb-[60px] overflow-hidden">
    <!-- Dotted grid bg -->
    <div class="grid-bg"></div>
    <!-- Ambient blobs -->
    <div class="hero-blob hero-blob-amber" aria-hidden="true"></div>
    <div class="hero-blob hero-blob-violet" aria-hidden="true"></div>

    <div class="wrap relative z-[2] w-full">
      <div class="grid md:grid-cols-[1.05fr_1fr] gap-16 items-center">
        <!-- Left: text -->
        <div>
          <div class="eyebrow animate-fade-up">Built in Britain &middot; Shipping in 7 days</div>

          <h1 class="animate-fade-up mb-6" style="animation-delay: 0.1s;">
            Built for humans.<br>
            <span class="gradient-text-hero">Optimised</span> for<br>everything else.
          </h1>

          <p class="text-[18px] leading-[1.6] mb-8 max-w-[480px] animate-fade-up" style="color: var(--color-ink-2); animation-delay: 0.2s;">
            Bespoke websites that score 100/100 on Lighthouse, load in under half a second, and don't make your users wait. From £1,500. Delivered in one week.
          </p>

          <div class="flex gap-3 flex-wrap animate-fade-up" style="animation-delay: 0.3s;">
            <a href="/portfolio/" class="btn btn-primary">Browse templates</a>
            <a href="/how-it-works/" class="btn btn-ghost">See how it works</a>
          </div>

          <!-- Stats row -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 pt-10 animate-fade-up" style="border-top: 1px solid var(--color-rule); animation-delay: 0.4s;">
            <div>
              <div class="text-[28px] font-semibold tracking-[-0.04em] tnum" style="color: var(--color-ink);">100</div>
              <div class="mono text-[10px] uppercase mt-1" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Lighthouse</div>
            </div>
            <div>
              <div class="text-[28px] font-semibold tracking-[-0.04em] tnum" style="color: var(--color-ink);">0.4s</div>
              <div class="mono text-[10px] uppercase mt-1" style="color: var(--color-ink-3); letter-spacing: 0.08em;">First paint</div>
            </div>
            <div>
              <div class="text-[28px] font-semibold tracking-[-0.04em] tnum" style="color: var(--color-ink);">&lt;100kb</div>
              <div class="mono text-[10px] uppercase mt-1" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Page weight</div>
            </div>
            <div>
              <div class="text-[28px] font-semibold tracking-[-0.04em] tnum" style="color: var(--color-ink);">7 days</div>
              <div class="mono text-[10px] uppercase mt-1" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Delivered</div>
            </div>
          </div>
        </div>

        <!-- Right: Lighthouse gauge card -->
        <div class="hidden md:block animate-fade-up" style="animation-delay: 0.35s;">
          <div class="card p-8 relative hero-gauge-card" style="box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-xl);">
            <!-- Browser chrome -->
            <div class="flex items-center gap-1.5 mb-6 pb-5" style="border-bottom: 1px solid var(--color-rule);">
              <span class="w-2.5 h-2.5 rounded-full" style="background:#ff5f57;"></span>
              <span class="w-2.5 h-2.5 rounded-full" style="background:#febc2e;"></span>
              <span class="w-2.5 h-2.5 rounded-full" style="background:#28c840;"></span>
              <div class="flex-1 mx-3 rounded-md px-3 py-1.5 mono text-[11px]" style="background: var(--color-bg-2); color: var(--color-ink-3); border: 1px solid var(--color-rule);">
                lighthouse report &middot; your-site.co.uk
              </div>
            </div>

            <!-- 4 gauges -->
            <div class="grid grid-cols-4 gap-3 mb-6">
              {[
                { label: 'Performance', score: 100, color: '#10b981' },
                { label: 'Accessibility', score: 100, color: '#10b981' },
                { label: 'Best Practices', score: 100, color: '#10b981' },
                { label: 'SEO', score: 100, color: '#10b981' }
              ].map((gauge) => (
                <div class="text-center">
                  <svg width="60" height="60" viewBox="0 0 60 60" class="mx-auto mb-2">
                    <circle cx="30" cy="30" r="24" fill="none" stroke="var(--color-rule)" stroke-width="4"/>
                    <circle
                      cx="30" cy="30" r="24" fill="none"
                      stroke={gauge.color} stroke-width="4"
                      stroke-dasharray={`${(gauge.score / 100) * 150.8} 150.8`}
                      stroke-linecap="round"
                      transform="rotate(-90 30 30)"
                      class="gauge-ring"
                    />
                    <text x="30" y="35" text-anchor="middle" font-size="14" font-weight="600" fill={gauge.color} font-family="Geist Mono, monospace">{gauge.score}</text>
                  </svg>
                  <div class="mono text-[9px] uppercase" style="color: var(--color-ink-3); letter-spacing: 0.06em;">{gauge.label}</div>
                </div>
              ))}
            </div>

            <!-- CWV metrics -->
            <div class="rounded-xl p-4" style="background: var(--color-bg); border: 1px solid var(--color-rule);">
              <div class="mono text-[10px] uppercase mb-3" style="color: var(--color-ink-3); letter-spacing: 0.08em;">Core Web Vitals</div>
              <div class="space-y-2">
                {[
                  { label: 'LCP', value: '0.8s', ok: true },
                  { label: 'FID', value: '12ms', ok: true },
                  { label: 'CLS', value: '0.00', ok: true }
                ].map((m) => (
                  <div class="flex justify-between items-center">
                    <span class="mono text-[11px]" style="color: var(--color-ink-2);">{m.label}</span>
                    <span class={m.ok ? 'chip chip-ok' : 'chip chip-warn'}>{m.value}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PERFORMANCE MARQUEE (dark strip) ===== -->
  <div class="section-dark py-5 overflow-hidden relative z-[2]" style="border-top: 1px solid rgba(251,191,36,0.1); border-bottom: 1px solid rgba(251,191,36,0.1);">
    <div class="ticker-track">
      {[...marqueItems, ...marqueItems].map((item, i) => (
        <div class="flex items-center gap-2.5 whitespace-nowrap mono text-[12px] font-medium" style="color: rgba(248,250,252,0.7);">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style={`background: ${i % 3 === 0 ? 'var(--color-accent)' : i % 3 === 1 ? 'var(--color-ok)' : 'var(--color-accent-2)'};`}></span>
          {item}
        </div>
      ))}
    </div>
  </div>

  <!-- ===== TEMPLATE GALLERY ===== -->
  <section class="section">
    <div class="wrap">
      <div class="reveal mb-12">
        <div class="eyebrow">Our work</div>
        <h2>Nine starting points.<br>One opinionated philosophy.</h2>
        <p class="text-[17px] mt-4 max-w-[480px]" style="color: var(--color-ink-2);">Real sites, real businesses. Every one scores 100/100 and loads in under a second.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-5 reveal">
        {portfolio.map((item, i) => (
          <a
            href="/portfolio/"
            class="group block rounded-[16px] overflow-hidden no-underline"
            style="box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); background: var(--color-paper); transition: transform 0.2s, box-shadow 0.2s;"
            onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='inset 0 0 0 1px var(--color-rule-2), 0 12px 40px rgba(30,41,59,0.12)';"
            onmouseout="this.style.transform=''; this.style.boxShadow='inset 0 0 0 1px var(--color-rule), 0 1px 3px rgba(30,41,59,0.08)';"
          >
            <!-- Preview area with fake browser chrome -->
            <div class="relative" style={`background: ${['#fef3c7','#ede9fe','#dcfce7','#dbeafe','#fce7f3'][i % 5]}; aspect-ratio: 16/9;`}>
              <div class="absolute top-3 left-3 right-3 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-white/60"></span>
                <span class="w-2 h-2 rounded-full bg-white/60"></span>
                <span class="w-2 h-2 rounded-full bg-white/60"></span>
                <div class="flex-1 h-4 rounded-md ml-2" style="background: rgba(255,255,255,0.5);"></div>
              </div>
              <!-- Wireframe mockup -->
              <div class="absolute inset-x-4 top-9 bottom-3 rounded-md flex flex-col gap-1.5 p-2" style="background: rgba(255,255,255,0.4);">
                <div class="h-2 w-3/4 rounded" style="background: rgba(0,0,0,0.08);"></div>
                <div class="h-1.5 w-1/2 rounded" style="background: rgba(0,0,0,0.05);"></div>
                <div class="flex-1 grid grid-cols-3 gap-1 mt-1">
                  <div class="rounded" style="background: rgba(0,0,0,0.04);"></div>
                  <div class="rounded" style="background: rgba(0,0,0,0.04);"></div>
                  <div class="rounded" style="background: rgba(0,0,0,0.04);"></div>
                </div>
              </div>
              <div class="absolute bottom-2 left-1/2 -translate-x-1/2">
                <span class="text-[10px] font-mono px-2.5 py-1 rounded-full" style="background: rgba(255,255,255,0.8); color: var(--color-ink-2);">{item.url.replace('https://', '')}</span>
              </div>
              <!-- Overlay on hover -->
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200" style="background: rgba(30,41,59,0.4);">
                <span class="text-white text-sm font-medium">View template &rarr;</span>
              </div>
            </div>
            <!-- Card body -->
            <div class="p-5">
              <div class="flex items-start justify-between gap-2 mb-2">
                <h3 class="text-[15px] font-semibold tracking-[-0.02em]" style="color: var(--color-ink);">{item.name}</h3>
                <span class="chip flex-shrink-0">{item.niche}</span>
              </div>
              <p class="text-[13px] leading-[1.6] mb-4" style="color: var(--color-ink-2);">{item.description}</p>
              <div class="flex gap-3">
                <span class="chip chip-ok">{item.metric}</span>
                <span class="chip">{item.pageCount} pages</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10 reveal">
        <a href="/portfolio/" class="btn btn-ghost">View all projects &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="section" style="background: var(--color-bg-2);">
    <div class="wrap">
      <div class="reveal text-center mb-14">
        <div class="eyebrow" style="justify-content: center;">How it works</div>
        <h2>Three steps. One week.<br>One ridiculously fast site.</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 relative reveal" id="processTrack">
        <!-- Connector line (desktop) -->
        <div class="hidden md:block absolute top-12 left-[calc(1/6*100%)] right-[calc(1/6*100%)] h-px z-0" style="background: var(--color-rule);"></div>
        <div class="hidden md:block absolute top-12 left-[calc(1/6*100%)] right-[calc(1/6*100%)] h-px z-0 process-line-fill"></div>

        {steps.map((step, i) => (
          <div class="relative z-[1] card text-center" style="padding: 40px 28px;">
            <!-- Step number -->
            <div class="w-11 h-11 rounded-full flex items-center justify-center mx-auto mb-6 mono text-[13px] font-semibold" style="background: var(--color-bg-2); box-shadow: inset 0 0 0 1px var(--color-rule); color: var(--color-ink-2);">
              {step.num}
            </div>
            <!-- Icon -->
            <div class="w-10 h-10 flex items-center justify-center rounded-xl mx-auto mb-5" style="background: rgba(251,191,36,0.12); color: var(--color-ink-2);">
              <Fragment set:html={step.icon} />
            </div>
            <h3 class="text-[18px] font-semibold mb-3" style="color: var(--color-ink);">{step.title}</h3>
            <p class="text-[14px] leading-[1.65]" style="color: var(--color-ink-2);">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section class="section">
    <div class="wrap">
      <div class="reveal text-center mb-14">
        <div class="eyebrow" style="justify-content: center;">Pricing</div>
        <h2>Two tiers. No hidden fees.<br>No retainers.</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-[860px] mx-auto reveal">
        <!-- Essential -->
        <div class="pricing-card-wrap">
          <div class="mono text-[11px] uppercase mb-4" style="color: var(--color-ink-3); letter-spacing: 0.1em;">Essential</div>
          <div class="text-[52px] font-semibold tracking-[-0.04em] leading-none mb-2" style="color: var(--color-ink);">£1,500</div>
          <p class="text-[14px] mb-8" style="color: var(--color-ink-2);">Fixed price. Confirmed before work starts.</p>
          <ul class="space-y-2.5 text-left mb-10 pb-8" style="border-bottom: 1px solid var(--color-rule);">
            {essentialItems.map((item) => (
              <li class="flex items-center gap-2.5 text-[14px]" style="color: var(--color-ink-2);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/order/" class="btn btn-ghost w-full justify-center">Start Essential build</a>
        </div>

        <!-- Pro (dark) -->
        <div class="pricing-card-dark relative" style="box-shadow: inset 0 0 0 1px rgba(251,191,36,0.2), 0 20px 60px rgba(30,41,59,0.2), 0 0 60px rgba(251,191,36,0.08);">
          <!-- Most popular badge -->
          <div class="absolute top-5 right-5 chip chip-accent">Most popular</div>
          <div class="mono text-[11px] uppercase mb-4" style="color: rgba(248,250,252,0.6); letter-spacing: 0.1em;">Pro</div>
          <div class="text-[52px] font-semibold tracking-[-0.04em] leading-none mb-2" style="color: var(--color-bg);">£3,000</div>
          <p class="text-[14px] mb-8" style="color: rgba(248,250,252,0.55);">Everything in Essential, plus full topical authority.</p>
          <ul class="space-y-2.5 text-left mb-10 pb-8" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
            {proItems.map((item) => (
              <li class="flex items-center gap-2.5 text-[14px]" style="color: rgba(248,250,252,0.7);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/order/" class="btn btn-accent w-full justify-center">Start Pro build</a>
        </div>
      </div>

      <p class="text-center mt-8 text-[15px] reveal" style="color: var(--color-ink-2);">
        Need bespoke? <a href="/contact/" class="font-semibold" style="color: var(--color-accent-2);">Get a custom quote</a> — typically £6k–£15k.
      </p>
    </div>
  </section>

  <!-- ===== TRUST LOGOS ===== -->
  <section class="py-16" style="border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule);">
    <div class="wrap">
      <div class="flex items-center justify-center gap-3 mb-10">
        <div class="h-px flex-1 max-w-[80px]" style="background: linear-gradient(90deg, transparent, var(--color-rule));"></div>
        <div class="mono text-[11px] uppercase" style="color: var(--color-ink-3); letter-spacing: 0.1em;">44+ sites built &middot; all scoring 100/100</div>
        <div class="h-px flex-1 max-w-[80px]" style="background: linear-gradient(90deg, var(--color-rule), transparent);"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {trustNames.map((name, i) => (
          <div class="flex items-center justify-center gap-2 py-4 px-5 rounded-xl" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule); transition: all 0.2s;">
            <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background: ${['#fbbf24','#7c3aed','#10b981','#3b82f6','#f59e0b','#8b5cf6','#059669','#2563eb'][i]};`}></span>
            <span class="mono text-[12px] font-medium" style="color: var(--color-ink-2);">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="section">
    <div class="wrap">
      <div class="reveal mb-12">
        <div class="eyebrow">Results</div>
        <h2>The before/after of caring<br>about milliseconds.</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-5 reveal">
        {testimonials.map((t, i) => (
