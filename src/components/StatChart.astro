---
// Accessible CSS bar chart (real-pixel text at every width), no JS library. Bars use theme-aware CSS
// custom properties so light/dark both stay AA-contrast. A real <table>
// beneath the chart carries the same figures for screen readers, no-CSS
// contexts and exact-value citation (the SVG is decorative/aria-hidden).
interface StatRow {
  label: string;
  value: number;
}
interface Props {
  title: string;
  source: string;
  sourceUrl: string;
  date: string;
  unit?: string;
  rows: StatRow[];
}
const { title, source, sourceUrl, date, unit = '', rows: rawRows } = Astro.props;

// Guard against an empty array (nothing to plot) and negative values
// (this chart only supports non-negative magnitudes, e.g. percentages).
const rows = rawRows.filter((r) => Number.isFinite(r.value) && r.value >= 0);
// Percentages are drawn on a 0-100 scale so bar length matches the share; other units scale to the largest value.
const max = unit.trim() === '%' ? 100 : Math.max(...rows.map((r) => r.value), 0.0001);
const formatValue = (v: number) => (Number.isInteger(v) ? v.toString() : String(parseFloat(v.toFixed(2))));

const bars = rows.map((r) => ({
  label: r.label,
  display: `${formatValue(r.value)}${unit}`,
  pct: Math.max((r.value / max) * 100, 0.5),
}));

// Unique id so multiple charts on one page never collide.
const uid = `stat-chart-${Math.random().toString(36).slice(2, 8)}`;
---
{rows.length > 0 && (
<figure class="stat-chart" data-stat-chart aria-labelledby={`${uid}-cap`}>
  <figcaption id={`${uid}-cap`} class="stat-chart-caption">
    <span class="stat-chart-title">{title}</span>
  </figcaption>

  <div class="stat-chart-bars">
    {bars.map((b, i) => (
      <div class="stat-chart-row">
        <span class="stat-chart-label">{b.label}</span>
        <span class="stat-chart-track" aria-hidden="true"><span class="stat-chart-fill" style={`width: ${b.pct}%; --i: ${i};`}></span></span>
        <span class="stat-chart-value tnum">{b.display}</span>
      </div>
    ))}
  </div>

  <p class="stat-chart-source">
    Source: <a href={sourceUrl}>{source}</a>, {date}
  </p>

  <details class="stat-chart-details">
    <summary>View data table</summary>
    <table class="stat-chart-table">
      <caption class="sr-only">{title}: data table</caption>
      <thead>
        <tr>
          <th scope="col">Metric</th>
          <th scope="col">Value</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td>{r.label}</td>
            <td class="tnum">{formatValue(r.value)}{unit}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>
)}

<style>
  .stat-chart {
    margin: 1.75rem 0;
    padding: 22px 22px 16px;
    border-radius: 18px;
    background:
      radial-gradient(80% 120% at 100% 0%, color-mix(in srgb, var(--violet-text) 9%, transparent), transparent 65%),
      var(--color-paper);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--violet-text) 16%, var(--color-rule)), var(--shadow-sm);
  }
  .stat-chart-caption { margin-bottom: 14px; }
  .stat-chart-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 650;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .stat-chart-bars { display: grid; gap: 12px; }
  .stat-chart-row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    font-family: var(--font-sans);
    font-size: 13.5px;
  }
  .stat-chart-label { color: var(--color-ink-2); overflow-wrap: anywhere; line-height: 1.3; }
  .stat-chart-track {
    position: relative;
    height: 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--violet-text) 9%, var(--color-bg));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--violet-text) 10%, transparent);
  }
  .stat-chart-fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--violet-text) 55%, var(--color-paper)), var(--violet-text));
    box-shadow: 0 0 14px -2px color-mix(in srgb, var(--violet-text) 55%, transparent);
    transform-origin: left center;
  }
  .stat-chart-fill::after {
    content: "";
    position: absolute;
    right: -2px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 0 0 0 2px var(--violet-text);
  }
  .stat-chart.js-anim .stat-chart-fill { transform: scaleX(0); }
  .stat-chart.js-anim .stat-chart-fill::after { opacity: 0; }
  .stat-chart.drawn .stat-chart-fill {
    transform: scaleX(1);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 90ms);
  }
  .stat-chart.drawn .stat-chart-fill::after { opacity: 1; transition: opacity 0.3s ease calc(0.7s + var(--i) * 90ms); }
  .stat-chart-value {
    color: var(--color-ink);
    font-weight: 700;
    min-width: 3.5ch;
    text-align: right;
  }
  @media (max-width: 400px) {
    .stat-chart-row { grid-template-columns: minmax(0, 6.5rem) minmax(0, 1fr) auto; gap: 10px; font-size: 12.5px; }
    .stat-chart { padding: 16px 14px 14px; }
  }
  .stat-chart-source { font-size: 12px; color: var(--color-ink-3); margin: 14px 0 0; }
  .stat-chart-source a { color: var(--violet-text); text-decoration: underline; text-underline-offset: 2px; }
  .stat-chart-details { margin-top: 12px; border-top: 1px solid var(--color-rule); padding-top: 10px; }
  .stat-chart-details summary { font-size: 12px; font-weight: 600; color: var(--color-ink-3); cursor: pointer; user-select: none; }
  .stat-chart-details summary:hover, .stat-chart-details summary:focus-visible { color: var(--violet-text); }
  .stat-chart-table { width: 100%; margin-top: 10px; border-collapse: collapse; font-size: 13px; }
  .stat-chart-table th, .stat-chart-table td {
    text-align: left; padding: 6px 10px 6px 0; border-bottom: 1px solid var(--color-rule); color: var(--color-ink-2);
  }
  .stat-chart-table th { font-size: 12px; color: var(--color-ink-3); font-weight: 600; }
  .stat-chart-table td:last-child, .stat-chart-table th:last-child { text-align: right; color: var(--color-ink); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-stat-chart]:not(.js-anim)').forEach((fig) => {
      const r = fig.getBoundingClientRect();
      if (r.top < innerHeight && r.bottom > 0) return;
      fig.classList.add('js-anim');
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { fig.classList.add('drawn'); io.disconnect(); }
      }, { threshold: 0.3 });
      io.observe(fig);
    });
  }
</script>
