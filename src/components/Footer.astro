---
import { site } from '../data/site';
import { footerNav } from '../data/navigation';

const year = new Date().getFullYear();
---
<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    <div>
      <a href="/" class="text-lg font-bold text-white">{site.name}</a>
      <p class="mt-3 text-sm leading-relaxed">{site.description}</p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Services</h3>
      <ul class="space-y-2">
        {footerNav.services.map((item) => (
          <li><a href={item.href} class="text-sm hover:text-white transition-colors">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Learn</h3>
      <ul class="space-y-2">
        {footerNav.learn.map((item) => (
          <li><a href={item.href} class="text-sm hover:text-white transition-colors">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Company</h3>
      <ul class="space-y-2">
        {footerNav.company.map((item) => (
          <li><a href={item.href} class="text-sm hover:text-white transition-colors">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-gray-800">
    <div class="max-w-6xl mx-auto px-4 py-4 text-center text-xs text-gray-500">
      &copy; {year} {site.name}. All rights reserved.
    </div>
  </div>
</footer>
