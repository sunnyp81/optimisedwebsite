---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';

const schemaNodes = [
  {
    '@type': 'Service',
    '@id': `${site.url}/order/#service`,
    name: 'SEO Website Build — Order',
    description: 'Order an SEO-optimised website build. Fill in your brief and we will confirm scope within 24 hours.',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United Kingdom' }
  }
];
---
<Base
  title="Order Your SEO Website | OptimisedWebsite"
  description="Fill in your brief to order an SEO-optimised website. We confirm scope within 24 hours and deliver within 5-7 working days."
  canonicalPath="/order/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-3xl mx-auto px-4">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Order', href: '/order/' }
    ]} />

    <section class="py-10">
      <h1 class="text-3xl md:text-4xl font-bold text-brand">Order Your SEO Website</h1>
      <p class="mt-4 text-lg text-text-muted leading-relaxed">
        Fill in the brief below. We review every submission manually and confirm scope, timeline, and price within 24 hours. No payment is taken until you approve the plan.
      </p>
    </section>

    <section class="py-10" id="order-form-section">
      <form id="order-form" class="space-y-6" novalidate>
        <div>
          <label for="name" class="block text-sm font-semibold text-text mb-1">Name <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" class="w-full border border-gray-300 rounded-md px-4 py-2 text-text focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-text mb-1">Email <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" class="w-full border border-gray-300 rounded-md px-4 py-2 text-text focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="phone" class="block text-sm font-semibold text-text mb-1">Phone <span class="text-text-muted font-normal">(optional)</span></label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" class="w-full border border-gray-300 rounded-md px-4 py-2 text-text focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="niche" class="block text-sm font-semibold text-text mb-1">Niche / Industry <span class="text-red-500">*</span></label>
          <input type="text" id="niche" name="niche" required placeholder="e.g. Home insurance, Personal training, SaaS" class="w-full border border-gray-300 rounded-md px-4 py-2 text-text focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="audience" class="block text-sm font-semibold text-text mb-1">Target Audience <span class="text-text-muted font-normal">(optional)</span></label>
          <input type="text" id="audience" name="audience" placeholder="e.g. UK homeowners, B2B decision makers" class="w-full border border-gray-300 rounded-md px-4 py-2 text-text focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="domain" class="block text-sm font-semibold text-text mb-1">Domain <span class="text-text-muted font-normal">(optional)</span></label>
          <input type="text" id="domain" name="domain" placeholder="e.g. example.co.uk" class="w-full border border-gray-300 rounded-md px-4 py-2 text-text focus:outline-none focus:ring-2 focus:ring-brand" />
        </div>

        <div>
          <label for="competitors" class="block text-sm font-semibold text-text mb-1">Competitors <span class="text-text-muted font-normal">(optional)</span></label>
          <textarea id="competitors" name="competitors" rows="3" placeholder="List competitor websites, one per line" class="w-full border border-gray-300 rounded-md px-4 py-2 text-text focus:outline-none focus:ring-2 focus:ring-brand"></textarea>
        </div>

        <div>
          <label for="budget" class="block text-sm font-semibold text-text mb-1">Budget</label>
          <select id="budget" name="budget" class="w-full border border-gray-300 rounded-md px-4 py-2 text-text focus:outline-none focus:ring-2 focus:ring-brand">
            <option value="1500-2000">&pound;1,500 &ndash; &pound;2,000</option>
            <option value="2000-2500">&pound;2,000 &ndash; &pound;2,500</option>
            <option value="2500-3000">&pound;2,500 &ndash; &pound;3,000</option>
          </select>
        </div>

        <input type="hidden" name="source" value="optimisedwebsite.com" />

        <!-- Honeypot -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="inline-block px-6 py-3 rounded-md font-semibold bg-brand text-white hover:bg-brand-light transition-colors">
          Submit Brief
        </button>
      </form>

      <div id="order-success" class="hidden py-10">
        <h2 class="text-2xl font-bold text-brand mb-4">Brief received</h2>
        <p class="text-text-muted leading-relaxed">We will review your brief and reply within 24 hours to confirm scope, timeline, and price. Check your inbox (and spam folder) for our response.</p>
      </div>
    </section>
  </div>
</Base>

<script>
  const form = document.getElementById('order-form') as HTMLFormElement;
  const successDiv = document.getElementById('order-success') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    // Honeypot check
    if (data.get('website')) return;

    const body: Record<string, string> = {};
    data.forEach((v, k) => { if (k !== 'website') body[k] = v as string; });

    try {
      const res = await fetch('https://aaa-intake.sunnypat81.workers.dev', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(`${res.status}`);
      form.classList.add('hidden');
      successDiv.classList.remove('hidden');
    } catch {
      alert('Something went wrong. Please email hello@optimisedwebsite.com directly.');
    }
  });
</script>
