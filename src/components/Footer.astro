---
import { site } from '../data/site';
import { footerNav } from '../data/navigation';

const year = new Date().getFullYear();
---
<footer class="relative z-[2]" style="background: #0f172a;">
  <!-- Top glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[200px] pointer-events-none" style="background: radial-gradient(ellipse 60% 80% at 50% 0%, rgba(251,191,36,0.08) 0%, transparent 60%);"></div>

  <!-- CTA strip -->
  <div class="relative" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
    <div class="wrap py-12 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-[20px] font-semibold tracking-[-0.02em]" style="color: #f8fafc;">Ready to rank?</h2>
        <p class="text-[14px] mt-1" style="color: rgba(248,250,252,0.55);">From brief to live site in 7 days. No retainers.</p>
      </div>
      <div class="flex gap-3">
        <a href="/order/" class="btn btn-accent text-[13px] font-semibold h-[40px] px-5">Get your free plan</a>
        <a href="/contact/" class="text-[13px] font-medium no-underline px-4 h-[40px] inline-flex items-center rounded-full transition-all duration-200" style="color: rgba(248,250,252,0.7); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);" onmouseover="this.style.background='rgba(255,255,255,0.05)'; this.style.color='#f8fafc';" onmouseout="this.style.background='transparent'; this.style.color='rgba(248,250,252,0.7)';">Talk to us</a>
      </div>
    </div>
  </div>

  <!-- Main footer grid -->
  <div class="wrap pt-14 pb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr] gap-10 pb-12" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
      <!-- Brand column -->
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 no-underline mb-5">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="24" height="24" rx="6" fill="#fbbf24"/>
            <polyline points="7,19 12,14 16,16 21,9" stroke="#7c3aed" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span class="text-[15px] font-semibold tracking-[-0.025em]" style="color: #f8fafc;">{site.name}</span>
        </a>
        <p class="text-[13px] leading-[1.7] max-w-[280px]" style="color: rgba(248,250,252,0.55);">
          SEO-optimised websites for UK businesses. Built in Astro, deployed on Cloudflare, structured to rank from day one.
        </p>
        <!-- Metrics strip -->
        <div class="flex gap-4 mt-6 pt-5" style="border-top: 1px solid rgba(255,255,255,0.06);">
          <div>
            <div class="text-[18px] font-semibold font-mono" style="color: #fbbf24;">44</div>
            <div class="text-[10px] font-mono uppercase mt-0.5" style="color: rgba(248,250,252,0.55); letter-spacing: 0.06em;">Sites in network</div>
          </div>
          <div>
            <div class="text-[18px] font-semibold font-mono" style="color: #10b981;">Audited</div>
            <div class="text-[10px] font-mono uppercase mt-0.5" style="color: rgba(248,250,252,0.55); letter-spacing: 0.06em;">Before handover</div>
          </div>
          <div>
            <div class="text-[18px] font-semibold font-mono" style="color: #7c3aed;">7d</div>
            <div class="text-[10px] font-mono uppercase mt-0.5" style="color: rgba(248,250,252,0.55); letter-spacing: 0.06em;">Delivery</div>
          </div>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-[11px] font-mono font-semibold uppercase mb-5" style="color: rgba(248,250,252,0.6); letter-spacing: 0.1em;">Services</h3>
        <ul class="space-y-3">
          {footerNav.services.map((item) => (
            <li>
              <a href={item.href} class="text-[13px] no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.65);" onmouseover="this.style.color='#fbbf24'" onmouseout="this.style.color='rgba(248,250,252,0.65)'">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Learn -->
      <div>
        <h3 class="text-[11px] font-mono font-semibold uppercase mb-5" style="color: rgba(248,250,252,0.6); letter-spacing: 0.1em;">Learn</h3>
        <ul class="space-y-3">
          {footerNav.learn.map((item) => (
            <li>
              <a href={item.href} class="text-[13px] no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.65);" onmouseover="this.style.color='#fbbf24'" onmouseout="this.style.color='rgba(248,250,252,0.65)'">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-[11px] font-mono font-semibold uppercase mb-5" style="color: rgba(248,250,252,0.6); letter-spacing: 0.1em;">Company</h3>
        <ul class="space-y-3">
          {footerNav.company.map((item) => (
            <li>
              <a href={item.href} class="text-[13px] no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.65);" onmouseover="this.style.color='#fbbf24'" onmouseout="this.style.color='rgba(248,250,252,0.65)'">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <div class="text-[12px] font-mono" style="color: rgba(248,250,252,0.55);">&copy; {year} {site.name} &middot; Built in Britain</div>
      <div class="flex items-center gap-5">
        <a href="/privacy/" class="text-[12px] no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.6);" onmouseover="this.style.color='rgba(248,250,252,0.9)'" onmouseout="this.style.color='rgba(248,250,252,0.6)'">Privacy</a>
        <a href="/terms/" class="text-[12px] no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.6);" onmouseover="this.style.color='rgba(248,250,252,0.9)'" onmouseout="this.style.color='rgba(248,250,252,0.6)'">Terms</a>
        <a href="/glossary/" class="text-[12px] no-underline transition-colors duration-200" style="color: rgba(248,250,252,0.6);" onmouseover="this.style.color='rgba(248,250,252,0.9)'" onmouseout="this.style.color='rgba(248,250,252,0.6)'">Glossary</a>
        <button type="button" data-open-consent class="text-[12px] font-sans transition-colors duration-200" style="color: rgba(248,250,252,0.6); background: none; border: none; padding: 0; cursor: pointer;" onmouseover="this.style.color='rgba(248,250,252,0.9)'" onmouseout="this.style.color='rgba(248,250,252,0.6)'">Cookie preferences</button>
      </div>
    </div>
  </div>
</footer>
