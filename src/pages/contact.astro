---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';

const schemaNodes = [
  {
    '@type': 'ContactPage',
    '@id': `${site.url}/contact/#page`,
    name: 'Contact OptimisedWebsite',
    url: `${site.url}/contact/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@id': `${site.url}/#organization`,
      contactPoint: {
        '@type': 'ContactPoint',
        email: site.email,
        contactType: 'customer service',
        availableLanguage: 'English'
      }
    }
  }
];
---
<Base
  title="Contact Us | OptimisedWebsite"
  description="Get in touch with OptimisedWebsite. Email hello@optimisedwebsite.com or use the contact form below."
  canonicalPath="/contact/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[700px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Contact', href: '/contact/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">Contact</div>
      <h1 class="section-title">Contact Us</h1>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink-2);">
        Have a question about our builds, pricing, or process? Send us a message below or email <a href={`mailto:${site.email}`} class="font-medium" style="color: var(--color-accent-2);" data-analytics-event="email_click" data-analytics-label="contact-intro">{site.email}</a> directly. We reply within 24 hours on working days.
      </p>
    </section>

    <section class="py-10" id="contact-form-section">
      <form id="contact-form" class="space-y-6">
        <div>
          <label for="contact-name" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Name <span class="text-red-500">*</span></label>
          <input type="text" id="contact-name" name="name" required autocomplete="name" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="contact-email" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Email <span class="text-red-500">*</span></label>
          <input type="email" id="contact-email" name="email" required autocomplete="email" class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);" />
        </div>

        <div>
          <label for="contact-message" class="block text-sm font-semibold mb-1" style="color: var(--color-ink);">Message <span class="text-red-500">*</span></label>
          <textarea id="contact-message" name="message" rows="5" required class="w-full rounded-[12px] px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); color: var(--color-ink);"></textarea>
        </div>

        <input type="hidden" name="source" value="optimisedwebsite.com" />
        <input type="hidden" name="form_type" value="contact" />

        <!-- Honeypot: submissions that fill this visually hidden field are discarded. -->
        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" id="contact-submit" class="btn-glow">
          Send Message
        </button>

        <div id="contact-status" role="status" aria-live="polite" aria-atomic="true" class="mt-4 text-[14px]"></div>
      </form>

      <div id="contact-success" class="hidden py-10" tabindex="-1">
        <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Message sent</h2>
        <p class="leading-relaxed" style="color: var(--color-ink-2);">We will reply within 24 hours. Check your inbox (and spam folder) for our response.</p>
      </div>
    </section>
  </div>

  <script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
  const statusEl = document.getElementById('contact-status') as HTMLDivElement;
  const successDiv = document.getElementById('contact-success') as HTMLDivElement;

  const gtag = (...args: unknown[]) => {
    const w = window as unknown as { gtag?: (...a: unknown[]) => void };
    if (typeof w.gtag === 'function') w.gtag(...args);
  };

  let startedTracked = false;
  form.addEventListener('focusin', () => {
    if (!startedTracked) {
      startedTracked = true;
      gtag('event', 'form_start', { form_id: 'contact-form' });
    }
  }, { once: true });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    // Honeypot check — silently drop, no error shown to the (likely bot) submitter
    if (data.get('website')) return;

    const body = Object.fromEntries(data.entries()) as Record<string, string>;
    body.landing_page = location.pathname;
    body.referrer = document.referrer || '';
    const params = new URLSearchParams(location.search);
    (['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'] as const).forEach((key) => {
      const value = params.get(key);
      if (value) body[key] = value;
    });

    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-busy', 'true');
    statusEl.setAttribute('role', 'status');
    statusEl.textContent = 'Sending your message…';

    try {
      const res = await fetch('/api/intake', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await res.json().catch(() => ({ ok: false }));
      if (!res.ok || !result.ok) throw new Error(`${res.status}`);

      statusEl.textContent = '';
      form.classList.add('hidden');
      successDiv.classList.remove('hidden');
      successDiv.focus();
      gtag('event', 'generate_lead', { form_id: 'contact-form' });
    } catch {
      statusEl.setAttribute('role', 'alert');
      statusEl.textContent = '';
      statusEl.append('Something went wrong sending your message. Please try again, or email ');
      const link = document.createElement('a');
      link.href = 'mailto:hello@optimisedwebsite.com';
      link.className = 'font-medium';
      link.style.color = 'var(--color-accent-2)';
      link.textContent = 'hello@optimisedwebsite.com';
      link.setAttribute('data-analytics-event', 'email_click');
      link.setAttribute('data-analytics-label', 'contact-form-error');
      statusEl.append(link, ' directly.');
      submitBtn.disabled = false;
      submitBtn.removeAttribute('aria-busy');
      gtag('event', 'form_error', { form_id: 'contact-form' });
    }
  });
  </script>
</Base>
