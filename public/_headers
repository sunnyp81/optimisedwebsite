/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Content-hashed assets (CSS, fonts) are immutable: cache for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Client design previews: keep out of every search index
/showcase/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: private, no-store

# Reading School of Martial Arts design previews: keep out of every search index
/rsoma-1/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/rsoma-2/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# This concept has a 'find my nearest clinic' button, which needs the visitor's location after a tap
/showcase/myhealthcare-clinic/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
