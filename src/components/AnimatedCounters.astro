---
interface Props {
  counters: { value: number; suffix: string; label: string }[];
}
const { counters } = Astro.props;
---
<div class="counter-strip reveal" id="counterStrip">
  <div class="wrap">
    <div class="counter-grid">
      {counters.map((c, i) => (
        <div class="counter-item">
          <div class="counter-value">
            <span class="counter-num" data-target={c.value} data-suffix={c.suffix}>0</span><span class="counter-suffix">{c.suffix}</span>
          </div>
          <div class="counter-label">{c.label}</div>
          <div class="counter-bar">
            <div class="counter-bar-fill" style={`animation-delay: ${i * 0.15}s;`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .counter-strip {
    padding: 4rem 0;
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, rgba(251,191,36,0.06) 0%, transparent 70%),
      var(--color-bg);
  }
  .counter-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }
  @media (max-width: 640px) {
    .counter-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  .counter-value {
    font-family: var(--font-display), serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1;
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
  }
  .counter-suffix {
    font-size: 0.6em;
    color: var(--color-accent);
    font-weight: 600;
  }
  .counter-label {
    font-family: var(--font-mono), monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-3);
    margin-top: 0.5rem;
  }
  .counter-bar {
    width: 40px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-rule);
    margin: 0.75rem auto 0;
    overflow: hidden;
  }
  .counter-bar-fill {
    width: 0%;
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .counter-strip.counted .counter-bar-fill {
    width: 100%;
  }
</style>

<script>
  const strip = document.getElementById('counterStrip');
  if (strip) {
    const nums = strip.querySelectorAll('.counter-num');
    let fired = false;
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting && !fired) {
          fired = true;
          strip.classList.add('counted');
          nums.forEach(el => {
            const target = parseFloat((el as HTMLElement).dataset.target || '0');
            const isDecimal = target % 1 !== 0;
            const duration = 2000;
            const start = performance.now();
            const tick = (now: number) => {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = eased * target;
              (el as HTMLElement).textContent = isDecimal
                ? current.toFixed(1)
                : Math.round(current).toLocaleString();
              if (progress < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
          obs.disconnect();
        }
      });
    }, { threshold: 0.3 });
    obs.observe(strip);
  }
</script>
