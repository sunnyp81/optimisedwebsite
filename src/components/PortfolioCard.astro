---
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  item: PortfolioItem;
}

const { item } = Astro.props;
---
<article class="rounded-[16px] p-6 transition-all duration-300" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);"
  onmouseover="this.style.boxShadow='inset 0 0 0 1px rgba(124,58,237,0.3), 0 4px 16px rgba(30,41,59,0.1)'; this.style.transform='translateY(-2px)';"
  onmouseout="this.style.boxShadow='inset 0 0 0 1px var(--color-rule), 0 1px 3px rgba(30,41,59,0.08)'; this.style.transform='';">
  <div class="flex items-start justify-between gap-4 mb-3">
    <h2 class="text-xl font-bold" style="color: var(--color-ink);">{item.name}</h2>
    <span class="shrink-0 text-xs font-medium px-2 py-1 rounded-full" style="background: rgba(124,58,237,0.1); border: 1px solid rgba(124,58,237,0.25); color: var(--color-accent-2);">{item.niche}</span>
  </div>
  <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">{item.description}</p>
  <div class="flex flex-wrap gap-4 text-sm mb-4" style="color: var(--color-ink-2);">
    <span><strong style="color: var(--color-ink);">{item.pageCount}</strong> pages</span>
    <span><strong style="color: var(--color-ink);">{item.metric}</strong></span>
  </div>
  <a href={item.url} target="_blank" rel="noopener noreferrer" class="font-medium transition-colors" style="color: var(--color-accent-2);">
    View live site &rarr;
  </a>
</article>
