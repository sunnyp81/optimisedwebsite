---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
  size?: 'default' | 'large';
  fullWidth?: boolean;
}

const { href, label, variant = 'primary', size = 'default', fullWidth = false } = Astro.props;

const sizeClasses = size === 'large' ? 'px-7 py-3.5 text-base' : 'px-5 py-3 text-[15px]';
const widthClass = fullWidth ? 'w-full justify-center' : '';

const styles = variant === 'primary'
  ? `btn-glow rounded-full tracking-tight transition-all duration-200 ${sizeClasses} ${widthClass}`
  : `btn-glass rounded-full tracking-tight transition-all duration-200 ${sizeClasses} ${widthClass}`;
---
<a href={href} class={`inline-flex items-center gap-2 no-underline ${styles}`}>
  {label}
  {variant === 'primary' && <span class="arr">&rarr;</span>}
</a>
