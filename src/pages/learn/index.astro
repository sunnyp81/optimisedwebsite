---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const articles = await getCollection('learn');
articles.sort((a, b) => a.data.title.localeCompare(b.data.title));

const schemaNodes = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/learn/#webpage`,
    name: 'Learn About SEO Websites',
    description: 'Guides and articles covering SEO-optimised website strategy, technical setup, content architecture, and ranking factors.',
    url: `${site.url}/learn/`,
    isPartOf: { '@id': `${site.url}/#website` },
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'ItemList',
    '@id': `${site.url}/learn/#itemlist`,
    name: 'SEO Website Guides',
    numberOfItems: articles.length,
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.data.title,
      url: `${site.url}/learn/${a.id}/`,
    })),
  },
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Learn', href: '/learn/' },
];
---
<Base
  title="Learn About SEO Websites | OptimisedWebsite"
  description="Guides and articles covering SEO-optimised website strategy, technical setup, content architecture, and ranking factors."
  canonicalPath="/learn/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <section class="py-12">
      <div class="section-tag">Learn</div>
      <h1 class="section-title">Learn About SEO Websites</h1>
      <p class="section-desc max-w-3xl">
        Practical guides on building, structuring, and ranking an SEO-optimised website. Each article covers a specific topic in depth so you can make informed decisions about your online presence.
      </p>
    </section>

    <section class="pb-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 reveal">
      {articles.map((article) => (
        <a
          href={`/learn/${article.id}/`}
          class="block rounded-[16px] p-6 no-underline transition-all duration-300 group"
          style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);"
          onmouseover="this.style.boxShadow='inset 0 0 0 1px rgba(124,58,237,0.3), 0 4px 16px rgba(30,41,59,0.1)'; this.style.transform='translateY(-2px)';"
          onmouseout="this.style.boxShadow='inset 0 0 0 1px var(--color-rule), 0 1px 3px rgba(30,41,59,0.08)'; this.style.transform='';"
        >
          <h2 class="text-[16px] font-bold mb-2" style="color: var(--color-ink);">{article.data.title}</h2>
          <p class="text-[14px] leading-[1.6]" style="color: var(--color-ink-2);">{article.data.metaDescription}</p>
        </a>
      ))}
    </section>

    <div class="py-8 flex flex-wrap gap-3">
      <CTA href="/free-website-growth-review/" label="Get a Free Growth Review" analyticsEvent="cta_click" analyticsLabel="learn-hub" />
      <CTA href="/compare/" label="Compare Options" variant="secondary" />
    </div>
  </div>
</Base>
