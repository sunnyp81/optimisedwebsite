---
import { site } from '../data/site';

interface Props {
  nodes?: Record<string, unknown>[];
}

const { nodes = [] } = Astro.props;

const graph = [
  {
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    logo: `${site.url}/favicon.svg`,
    image: `${site.url}/og-default.png`,
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    contactPoint: {
      '@type': 'ContactPoint',
      email: site.email,
      contactType: 'sales',
    },
    knowsAbout: [
      {
        '@type': 'Thing',
        name: 'Search engine optimization',
        sameAs: [
          'https://en.wikipedia.org/wiki/Search_engine_optimization',
          'https://www.wikidata.org/wiki/Q180711',
        ],
      },
      {
        '@type': 'Thing',
        name: 'Web design',
        sameAs: [
          'https://en.wikipedia.org/wiki/Web_design',
          'https://www.wikidata.org/wiki/Q189210',
        ],
      },
      {
        '@type': 'Thing',
        name: 'Structured data',
        sameAs: [
          'https://en.wikipedia.org/wiki/Structured_data',
          'https://www.wikidata.org/wiki/Q26813700',
        ],
      },
      {
        '@type': 'Thing',
        name: 'Schema.org',
        sameAs: [
          'https://en.wikipedia.org/wiki/Schema.org',
          'https://www.wikidata.org/wiki/Q1409226',
        ],
      },
      'Topical Authority',
      'Content Architecture',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    publisher: { '@id': `${site.url}/#organization` },
  },
  ...nodes,
];

const schema = { '@context': 'https://schema.org', '@graph': graph };
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
