---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';

const schemaNodes = [
  {
    '@type': 'AboutPage',
    '@id': `${site.url}/about/#page`,
    name: 'About OptimisedWebsite',
    description: 'OptimisedWebsite is run by Sunny Patel, an SEO consultant based in Reading, UK. 44+ sites built with static-first architecture and SEO planned from the outset.',
    url: `${site.url}/about/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${site.url}/#organization` }
  },
  {
    '@type': 'Person',
    '@id': `${site.url}/about/#founder`,
    name: 'Sunny Patel',
    jobTitle: 'SEO Consultant & Founder',
    url: `${site.url}/about/`,
    worksFor: { '@id': `${site.url}/#organization` },
    knowsAbout: ['SEO', 'Technical SEO', 'Schema Markup', 'Astro', 'Cloudflare Pages', 'Topical Authority']
  }
];
---
<Base
  title="About OptimisedWebsite | Sunny Patel, SEO Consultant"
  description="OptimisedWebsite is run by Sunny Patel — an SEO consultant in Reading, UK. 44+ static-first sites built with SEO planned from the outset. From £1,500."
  canonicalPath="/about/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">About</div>
      <h1 class="section-title">Built by Sunny Patel</h1>
      <div class="grid md:grid-cols-[200px_1fr] gap-8 mt-8 items-start">
        <div class="w-[200px] h-[200px] rounded-2xl flex items-center justify-center" style="background: linear-gradient(135deg, #fbbf24 0%, #7c3aed 100%);">
          <span class="text-[64px] font-bold" style="color: white;">SP</span>
        </div>
        <div>
          <p class="text-lg leading-relaxed mb-4" style="color: var(--color-ink-2);">
            I'm Sunny Patel — an SEO consultant based in Reading, UK. I build websites that rank. Not redesigns, not template installs, not WordPress themes with plugins bolted on.
          </p>
          <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
            Over the last two years I've built 44+ sites across health, automotive, home services, developer tools, food, and SaaS verticals. Each build is performance-tested before handover and structured for topical authority from day one.
          </p>
          <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
            I run an SEO consultancy serving UK businesses. OptimisedWebsite is the productised arm: fixed-price builds with a 7-day turnaround.
          </p>
          <div class="flex flex-wrap gap-4 mt-6">
            <div class="text-center">
              <div class="text-[24px] font-bold" style="color: var(--color-ink);">44+</div>
              <div class="text-[11px] uppercase font-mono" style="color: var(--color-ink-3);">Sites built</div>
            </div>
            <div class="text-center">
              <div class="text-[24px] font-bold" style="color: var(--color-ink);">Launch</div>
              <div class="text-[11px] uppercase font-mono" style="color: var(--color-ink-3);">Performance-tested</div>
            </div>
            <div class="text-center">
              <div class="text-[24px] font-bold" style="color: var(--color-ink);">7 days</div>
              <div class="text-[11px] uppercase font-mono" style="color: var(--color-ink-3);">Delivery</div>
            </div>
            <div class="text-center">
              <div class="text-[24px] font-bold" style="color: var(--color-ink);">Reading</div>
              <div class="text-[11px] uppercase font-mono" style="color: var(--color-ink-3);">Based in</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-10">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Why SEO-First Matters</h2>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        Most websites retrofit SEO after design is complete — adding meta tags, fixing headings, writing alt text. The result looks polished but lacks the structural foundations search engines need to rank content properly.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        SEO-first reverses that sequence. Keyword research, topical mapping, internal linking architecture, and schema planning all happen before a single line of HTML is written. Every URL, every heading, and every internal link exists because the data justified it.
      </p>
    </section>

    <section class="py-10">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">What You Get</h2>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        Every page carries its own JSON-LD schema block within a site-wide @graph — Organisation, WebSite, Service, Article, FAQPage, HowTo, and BreadcrumbList types deployed where the data supports them. Sites are built on Astro and deployed to Cloudflare's edge network. Astro outputs static HTML by default, and client-side JavaScript is added only where it serves a clear purpose.
      </p>
      <p class="leading-relaxed" style="color: var(--color-ink-2);">
        You own everything. The GitHub repository, the domain, the hosting account, and the content. No proprietary CMS. No vendor lock-in. No recurring platform fee. Walk away and manage the site yourself — I hand over a complete codebase.
      </p>
    </section>

    <section class="py-10">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Satisfaction Guarantee</h2>
      <p class="leading-relaxed mb-4" style="color: var(--color-ink-2);">
        You review on a live staging link before anything goes live. Revisions are included: 30 days for Essential builds, 90 days for Pro. If the final site doesn't meet the agreed brief, I rebuild the pages in question at no extra cost. You're never locked in — source code is yours from day one.
      </p>
    </section>

    <section class="py-12 text-center">
      <div class="flex flex-wrap gap-3 justify-center">
        <CTA href="/portfolio/" label="View Portfolio" />
        <CTA href="/order/" label="Get a Free Build Plan" variant="secondary" />
      </div>
    </section>
  </div>
</Base>
