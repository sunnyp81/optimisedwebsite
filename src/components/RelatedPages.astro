---
interface Props {
  pages: { slug: string; title: string; collection: string }[];
}

const { pages } = Astro.props;
---
{pages.length > 0 && (
  <nav aria-label="Related articles" class="py-10 border-t border-line mt-10">
    <h2 class="text-xl font-bold tracking-[-0.02em] mb-5">Related Articles</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {pages.map((page) => (
        <a href={`/${page.collection}/${page.slug}/`} class="block bg-bg-2 border border-line rounded-[16px] p-5 hover:border-brand-border transition-all duration-300">
          <span class="font-bold text-text">{page.title}</span>
        </a>
      ))}
    </div>
  </nav>
)}
