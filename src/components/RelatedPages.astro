---
interface Props {
  pages: { slug: string; title: string; collection: string }[];
}

const { pages } = Astro.props;
---
{pages.length > 0 && (
  <nav aria-label="Related articles" class="py-10 mt-10" style="border-top: 1px solid var(--color-rule);">
    <h2 class="text-xl font-bold tracking-[-0.02em] mb-5" style="color: var(--color-ink);">Related Articles</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {pages.map((page) => (
        <a
          href={`/${page.collection}/${page.slug}/`}
          class="block rounded-[16px] p-5 no-underline transition-all duration-300"
          style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);"
          onmouseover="this.style.boxShadow='inset 0 0 0 1px rgba(124,58,237,0.3), 0 4px 16px rgba(30,41,59,0.1)'; this.style.transform='translateY(-2px)';"
          onmouseout="this.style.boxShadow='inset 0 0 0 1px var(--color-rule), 0 1px 3px rgba(30,41,59,0.08)'; this.style.transform='';"
        >
          <span class="font-bold text-[15px]" style="color: var(--color-ink);">{page.title}</span>
        </a>
      ))}
    </div>
  </nav>
)}
