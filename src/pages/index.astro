  <!-- ===== SOCIAL PROOF TOAST ===== -->
  <div class="toast hide-mobile" id="toast" aria-live="polite">
    <div class="w-9 h-9 rounded-[10px] flex items-center justify-center flex-shrink-0" style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.25); color: #059669;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    </div>
    <div class="min-w-0">
      <div class="text-[13px] font-semibold whitespace-nowrap overflow-hidden text-ellipsis" style="color: var(--color-ink);" id="toastTitle"></div>
      <div class="text-[12px] mt-px" style="color: var(--color-ink-3);" id="toastSub"></div>
    </div>
    <button id="toastClose" type="button" aria-label="Dismiss" class="ml-1 flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center transition-colors" style="color: var(--color-ink-3); pointer-events: auto;" onmouseover="this.style.background='rgba(124,58,237,0.1)'; this.style.color='var(--color-ink)';" onmouseout="this.style.background='transparent'; this.style.color='var(--color-ink-3)';">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
    </button>
  </div>

  <script>
  // Social proof toast
  const toasts = [
    { title: 'waterhard.uk', sub: '1,082 clicks/mo · pos 8.0' },
    { title: 'shecookssheeats.co.uk', sub: '85.8k impressions/mo · 211 pages' },
    { title: 'deadhangs.com', sub: '437 clicks/mo · pos 7.6' },
    { title: 'rentalyield.uk', sub: '37.9k impressions/mo · growing' },
    { title: 'bestvibrationplates.co.uk', sub: '135 pages · 6.7k impr/mo' },
  ];
  const toast = document.getElementById('toast');
  const tTitle = document.getElementById('toastTitle');
  const tSub = document.getElementById('toastSub');
  const tClose = document.getElementById('toastClose');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (toast && tTitle && tSub && window.innerWidth > 960 && !reduceMotion) {
    let ti = 0;
    let timer = 0;
    let dismissed = false;
    const hide = () => toast.classList.remove('show');
    const showToast = () => {
      // Stop after one full pass so it does not nag indefinitely
      if (dismissed || ti >= toasts.length) { window.clearInterval(timer); return; }
      tTitle.textContent = toasts[ti].title;
      tSub.textContent = toasts[ti].sub;
      toast.classList.add('show');
      setTimeout(hide, 5000);
      ti += 1;
    };
    tClose?.addEventListener('click', () => { dismissed = true; window.clearInterval(timer); hide(); });
    setTimeout(showToast, 4000);
    timer = window.setInterval(showToast, 8000);
  }

  // Animate gauges when hero enters viewport
  const gaugeRings = document.querySelectorAll('.gauge-ring');
  const heroObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        gaugeRings.forEach(ring => {
          const el = ring as SVGCircleElement;
          const final = el.getAttribute('stroke-dasharray')?.split(' ')[0] || '0';
          el.style.strokeDasharray = `0 150.8`;
          setTimeout(() => {
            el.style.strokeDasharray = `${final} 150.8`;
          }, 200);
        });
        heroObs.disconnect();
      }
    });
  }, { threshold: 0.2 });
  const gaugeCard = gaugeRings[0]?.closest('section');
  if (gaugeCard) heroObs.observe(gaugeCard);
  </script>
