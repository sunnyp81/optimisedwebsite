<script>
  // Process timeline
  const pt = document.getElementById('processTrack');
  if (pt) {
    const pObs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { pt.classList.add('visible'); pObs.unobserve(pt); } });
    }, { threshold: 0.05 });
    pObs.observe(pt);
  }

  // Social proof toast
  const toasts = [
    { title: 'bestvibrationplates.co.uk', sub: '135 pages · Lighthouse 100' },
    { title: 'waterhard.uk', sub: '49 pages · 1,191 clicks/mo' },
    { title: 'calculator.place', sub: '60 pages · 450 unique H2s' },
    { title: 'towrating.net', sub: '832 pages · Full schema' },
    { title: 'fixerror.dev', sub: '125 pages · AI crawler ready' },
  ];
  const toast = document.getElementById('toast');
  const tTitle = document.getElementById('toastTitle');
  const tSub = document.getElementById('toastSub');
  if (toast && tTitle && tSub && window.innerWidth > 960) {
    let ti = 0;
    const showToast = () => {
      tTitle.textContent = toasts[ti].title;
      tSub.textContent = toasts[ti].sub;
      toast.classList.add('show');
      setTimeout(() => { toast.classList.remove('show'); }, 5000);
      ti = (ti + 1) % toasts.length;
    };
    setTimeout(showToast, 4000);
    setInterval(showToast, 12000);
  }

  // Animate gauges when hero enters viewport
  const gaugeRings = document.querySelectorAll('.gauge-ring');
  const heroObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        gaugeRings.forEach(ring => {
          const el = ring as SVGCircleElement;
          const final = el.getAttribute('stroke-dasharray')?.split(' ')[0] || '0';
          el.style.strokeDasharray = `0 150.8`;
          setTimeout(() => {
            el.style.strokeDasharray = `${final} 150.8`;
          }, 200);
        });
        heroObs.disconnect();
      }
    });
  }, { threshold: 0.2 });
  const gaugeCard = gaugeRings[0]?.closest('section');
  if (gaugeCard) heroObs.observe(gaugeCard);
</script>
