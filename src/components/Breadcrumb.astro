---
import { site } from '../data/site';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const schemaItems = items.map((item, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: item.label,
  item: `${site.url}${item.href}`,
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems,
};
---
<nav aria-label="Breadcrumb" class="text-sm text-text-dimmer py-4">
  <ol class="flex flex-wrap gap-1.5">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-text-dimmer">/</span>}
        {i === items.length - 1 ? (
          <span aria-current="page" class="text-text-muted">{item.label}</span>
        ) : (
          <a href={item.href} class="hover:text-brand transition-colors duration-200">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
