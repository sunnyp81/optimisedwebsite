---
interface Props { class?: string; }
const { class: extra = '' } = Astro.props;
---
<div class={`gcard ${extra}`.trim()} data-tilt>
  <div class="gcard-beams" aria-hidden="true">
    <span class="gcard-beam gcard-beam-t"></span>
    <span class="gcard-beam gcard-beam-r"></span>
    <span class="gcard-beam gcard-beam-b"></span>
    <span class="gcard-beam gcard-beam-l"></span>
  </div>
  <slot />
</div>

<script>
  if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    const MAX = 4;
    document.querySelectorAll<HTMLElement>('.gcard[data-tilt]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        el.style.setProperty('--ry', (px * MAX * 2).toFixed(2) + 'deg');
        el.style.setProperty('--rx', (-py * MAX * 2).toFixed(2) + 'deg');
      });
      el.addEventListener('pointerleave', () => {
        el.style.setProperty('--rx', '0deg');
        el.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>
