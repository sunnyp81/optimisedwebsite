---
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  item: PortfolioItem;
}

const { item } = Astro.props;
---
<article class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
  <div class="flex items-start justify-between gap-4 mb-3">
    <h2 class="text-xl font-bold text-brand">{item.name}</h2>
    <span class="shrink-0 text-xs font-medium bg-brand/10 text-brand px-2 py-1 rounded">{item.niche}</span>
  </div>
  <p class="text-text-muted leading-relaxed mb-4">{item.description}</p>
  <div class="flex flex-wrap gap-4 text-sm text-text-muted mb-4">
    <span><strong class="text-text">{item.pageCount}</strong> pages</span>
    <span><strong class="text-text">{item.metric}</strong></span>
  </div>
  <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-brand hover:text-brand-light font-medium transition-colors">
    View live site &rarr;
  </a>
</article>
