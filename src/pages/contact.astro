---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import GlassCard from '../components/GlassCard.astro';
import { site } from '../data/site';

const schemaNodes = [
  {
    '@type': 'ContactPage',
    '@id': `${site.url}/contact/#page`,
    name: 'Contact OptimisedWebsite',
    url: `${site.url}/contact/`,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@id': `${site.url}/#organization`,
      contactPoint: {
        '@type': 'ContactPoint',
        email: site.email,
        contactType: 'customer service',
        availableLanguage: 'English'
      }
    }
  }
];
---
<Base
  title="Contact Us | OptimisedWebsite"
  description="Get in touch with OptimisedWebsite. Email hello@optimisedwebsite.com or use the contact form below."
  canonicalPath="/contact/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[700px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Contact', href: '/contact/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">Contact</div>
      <h1 class="section-title">Contact Us</h1>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink-2);">
        Have a question about our builds, pricing, or process? Send us a message below or email <a href={`mailto:${site.email}`} class="font-medium underline" style="color: var(--violet-text);" data-analytics-event="email_click" data-analytics-label="contact-intro">{site.email}</a> directly. We reply within 24 hours on working days.
      </p>
    </section>

    <section class="py-10" id="contact-form-section">
      <GlassCard>
      <form id="contact-form" class="space-y-6">
        <div class="gf-field">
          <label for="contact-name" class="gf-label">Name <span class="text-red-500">*</span></label>
          <div class="gf-wrap">
            <span class="gf-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
            <input class="gf-control" type="text" id="contact-name" name="name" required autocomplete="name" />
          </div>
        </div>

        <div class="gf-field">
          <label for="contact-email" class="gf-label">Email <span class="text-red-500">*</span></label>
          <div class="gf-wrap">
            <span class="gf-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg></span>
            <input class="gf-control" type="email" id="contact-email" name="email" required autocomplete="email" />
          </div>
        </div>

        <div class="gf-field">
          <label for="contact-message" class="gf-label">Message <span class="text-red-500">*</span></label>
          <div class="gf-wrap">
            <textarea class="gf-control" id="contact-message" name="message" rows="5" required maxlength="2000"></textarea>
          </div>
        </div>

        <input type="hidden" name="source" value="optimisedwebsite.com" />
        <input type="hidden" name="form_type" value="contact" />

        <!-- Honeypot: submissions that fill this visually hidden field are discarded. -->
        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" id="contact-submit" class="gf-submit" disabled>
          <span>Send Message</span>
          <svg class="gf-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          <span class="gf-spinner" aria-hidden="true"></span>
        </button>
        <p class="gf-note">We reply within 24 hours on working days. <a href="/privacy/">Privacy</a></p>

        <noscript><p class="gf-note">This form needs JavaScript. Email <a href="mailto:hello@optimisedwebsite.com">hello@optimisedwebsite.com</a> instead.</p></noscript>
        <div id="contact-status" role="status" aria-live="polite" aria-atomic="true" class="mt-4 text-[14px]"></div>
      </form>

      <div id="contact-success" class="hidden py-10" tabindex="-1">
        <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Message sent</h2>
        <p class="leading-relaxed" style="color: var(--color-ink-2);">We will reply within 24 hours. Check your inbox (and spam folder) for our response.</p>
      </div>
      </GlassCard>
    </section>
  </div>

  <script>
  import { attributionFields, hasConsent } from '../scripts/attribution';
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
  submitBtn.disabled = false;
  const statusEl = document.getElementById('contact-status') as HTMLDivElement;
  const successDiv = document.getElementById('contact-success') as HTMLDivElement;

  const gtag = (...args: unknown[]) => {
    const w = window as unknown as { gtag?: (...a: unknown[]) => void };
    if (typeof w.gtag === 'function') w.gtag(...args);
  };

  let startedTracked = false;
  form.addEventListener('focusin', () => {
    if (!startedTracked) {
      startedTracked = true;
      gtag('event', 'form_start', { form_id: 'contact-form' });
    }
  }, { once: true });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    // Honeypot check — silently drop, no error shown to the (likely bot) submitter
    if (data.get('website')) return;

    const body = Object.fromEntries(data.entries()) as Record<string, string>;
    body.landing_page = location.pathname;
    Object.assign(body, attributionFields('contact'));

    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-busy', 'true');
    statusEl.setAttribute('role', 'status');
    statusEl.textContent = 'Sending your message…';

    try {
      const res = await fetch('/api/intake', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        referrerPolicy: 'origin',
        body: JSON.stringify(body),
      });
      const result = await res.json().catch(() => ({ ok: false }));
      if (!res.ok || !result.ok) throw new Error(`${res.status}`);

      statusEl.textContent = '';
      form.classList.add('hidden');
      successDiv.classList.remove('hidden');
      successDiv.focus();
      if (hasConsent()) gtag('event', 'generate_lead', { form_id: 'contact-form' });
    } catch {
      statusEl.setAttribute('role', 'alert');
      statusEl.textContent = '';
      statusEl.append('Something went wrong sending your message. Please try again, or email ');
      const link = document.createElement('a');
      link.href = 'mailto:hello@optimisedwebsite.com';
      link.className = 'font-medium';
      link.style.color = 'var(--violet-text)';
      link.style.textDecoration = 'underline';
      link.textContent = 'hello@optimisedwebsite.com';
      link.setAttribute('data-analytics-event', 'email_click');
      link.setAttribute('data-analytics-label', 'contact-form-error');
      statusEl.append(link, ' directly.');
      submitBtn.disabled = false;
      submitBtn.removeAttribute('aria-busy');
      gtag('event', 'form_error', { form_id: 'contact-form' });
    }
  });
  </script>
</Base>
