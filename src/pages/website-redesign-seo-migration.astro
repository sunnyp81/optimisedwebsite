---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { priceLevels } from '../data/pricing';

const replacement = priceLevels[0];
const migration = priceLevels[2];
const fromPrice = (l: { low: number }) => `£${l.low.toLocaleString('en-GB')}`;

const deliverables = [
  { title: 'Pre-launch URL inventory', desc: 'Every currently indexed URL is crawled and exported before any work starts, so nothing gets missed once the new site goes live.' },
  { title: 'URL mapping rules', desc: 'Each old URL is checked against the new site. Where a genuine equivalent page exists, it gets a 301 redirect. Where none exists, we decide deliberately whether that URL should 404, 410, or point somewhere relevant.' },
  { title: 'Staging crawl and review', desc: 'The new site is crawled on a staging URL and checked against the mapping plan before anything goes live, catching broken links and mapping gaps early.' },
  { title: 'Launch controls', desc: 'DNS, redirects, and the new site are switched over in a controlled order, so there is no window where old URLs return errors before the new redirects are active.' },
  { title: 'Redirect testing', desc: 'Every mapped redirect is tested after launch to confirm it resolves to the right page with a 301, not a chain, a loop, or a soft 404.' },
  { title: 'Canonical and internal-link updates', desc: 'Canonical tags and internal links are updated to point at the new URLs directly, rather than relying on a redirect chain to carry link equity.' },
  { title: 'Sitemap submission', desc: 'The new sitemap, containing the new site\'s indexable URLs, is submitted to Google Search Console and Bing Webmaster Tools once the new site is live.' },
  { title: 'Post-launch monitoring window', desc: 'Search Console coverage and position data checked at day 14 and day 30 so issues are caught early, not months later.' },
];

const faqs = [
  { q: 'Can I redesign a ranking site without losing SEO?', a: 'Yes. Keep every URL that earns traffic or 301-redirect it to a page that answers the same question. Test the redirects on staging before launch. Some short-term ranking movement is normal after any site move. No agency can honestly promise none.' },
  { q: 'Will I lose rankings during the migration?', a: 'Google has said publicly that migrations carry some short-term ranking volatility, and no agency can honestly promise otherwise. Our process, redirect mapping, staging review, and launch controls, is built to minimise that volatility, not eliminate it. See Google\'s own guidance on site moves with URL changes further down this page for the detail behind that.' },
  { q: 'How do you handle old URLs?', a: 'We crawl and export every currently indexed URL before starting, then map each one against the new site. Where a genuine equivalent page exists, it gets a 301 redirect. Redirecting a URL to an irrelevant page can itself get flagged as a soft 404, so we do not redirect everything by default. Content that has genuinely been removed and has no equivalent is allowed to return a 404 or 410 where that is the accurate outcome.' },
  { q: 'Can I keep my current URL structure?', a: 'Yes, if it is already working. We only recommend changing URL structure where the current one is actively working against you, for example duplicate content or unclear hierarchy. Any change is discussed and agreed before it happens.' },
  { q: 'How long does a migration take?', a: 'Migration time depends on the size of the existing site. A small replacement of up to 25 pages takes 1 to 2 weeks. A site of 25 to 100 pages takes 3 to 5 weeks when it qualifies for Level 2. Any site where every address has to be kept or redirected is a Level 3 migration. A full migration of 100 pages to several hundred or more than 5 premises takes 6 to 12 weeks. Every migration includes Search Console checks at day 14 and day 30.' },
  { q: 'What happens to pages you decide not to redirect?', a: 'If a page has no genuine equivalent on the new site, we do not force a redirect to an unrelated page just to avoid a 404. Depending on the page, it either returns a proper 404 or 410, or, if the content still has value, it is rebuilt on the new site and redirected once it exists.' },
  { q: 'Do you submit every old URL to Google again after launch?', a: 'No. The old URLs are redirected, not resubmitted. What gets submitted after launch is the new sitemap, listing the new site\'s indexable URLs, so Google can find and re-crawl them through the redirects already in place.' },
  { q: 'What is an SEO migration?', a: 'An SEO migration is the planning and testing that keeps the pages earning search traffic findable when a site changes. It covers the URL inventory, the redirect map, staging tests, the launch switch and checks after launch. It matters most when a redesign changes page addresses or the domain.' },
  { q: 'Do I need SEO support if my URLs are not changing?', a: 'Less of it, but some. A redesign that keeps every address can still lose rankings if titles, headings or content that rank are cut or if a noindex rule from staging goes live. Comparing old and new page content and crawling staging before launch catches both.' },
];

const schemaNodes = [
  {
    '@type': 'Service',
    '@id': `${site.url}/website-redesign-seo-migration/#service`,
    name: 'Website Redesign and SEO Migration',
    description: 'Website redesign and SEO migration for UK businesses with an existing indexed site: full redirect mapping, staging review, and new-sitemap submission.',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'GBP',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: '1500', maxPrice: '15000', priceCurrency: 'GBP' },
    },
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/website-redesign-seo-migration/#faq`,
    mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
  },
];
---
<Base
  title="Redesign a Ranking Site Without Losing SEO | OptimisedWebsite"
  description="How to redesign a ranking site without losing SEO: keep or redirect every URL that earns traffic and test on staging first. Replacement from £1,500, full migration from £6,000."
  canonicalPath="/website-redesign-seo-migration/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Website Redesign & SEO Migration', href: '/website-redesign-seo-migration/' },
    ]} />

    <section class="py-12">
      <div class="section-tag">Redesign & Migration</div>
      <h1 class="section-title">How to Redesign a Ranking Website Without Losing SEO</h1>
      <p class="mt-4 text-lg leading-relaxed max-w-3xl" style="color: var(--color-ink-2);">
        Keep every URL that earns traffic or 301-redirect it to a page that answers the same question. Test the redirects on a staging copy before launch. This service is for businesses replacing an existing indexed site. Old URLs are inventoried and mapped before work starts. The new site's indexable URLs go into a fresh sitemap at launch. A monitoring window catches issues early. A small replacement starts from {fromPrice(replacement)}. A migration that must keep or redirect every address starts from {fromPrice(migration)}.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <CTA href="/order/?offer=website-redesign-seo-migration" label="Request a Build Plan" analyticsEvent="cta_click" analyticsLabel="migration-hero-build-plan" />
        <CTA href="/free-website-growth-review/" label="Get a Free Growth Review" variant="secondary" analyticsEvent="cta_click" analyticsLabel="migration-hero" />
        <CTA href="/pricing/" label="See Pricing" variant="secondary" />
      </div>
      <p class="text-[13px] mt-6" style="color: var(--color-ink-3);">
        OptimisedWebsite is run by <a href="/about/" style="color: var(--color-accent-2); font-weight: 500;">Sunny Patel</a>, an independent SEO consultant based in Reading with more than 16 years in SEO.
      </p>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4" style="color: var(--color-ink);">Small Replacement or Full Migration?</h2>
      <p class="leading-relaxed max-w-3xl mb-8" style="color: var(--color-ink-2);">
        The size of your current site and whether every old address has to survive decide the level. Prices come from the same ladder as the pricing page.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-[16px] p-7" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);">
          <div class="mono text-[11px] uppercase mb-2" style="color: var(--color-ink-3); letter-spacing: 0.1em;">{replacement.level}: small replacement</div>
          <div class="text-2xl font-bold mb-3" style="color: var(--color-ink);">From {fromPrice(replacement)}</div>
          <ul class="space-y-2 text-sm leading-relaxed" style="color: var(--color-ink-2);">
            <li>{replacement.fits}</li>
            <li>{replacement.pages}, delivered in {replacement.timescale}</li>
            <li>Keyword research, page plan, all copy written for you and launch on your domain</li>
            <li>{replacement.payment}</li>
          </ul>
        </div>
        <div class="rounded-[16px] p-7" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-accent-2), var(--shadow-sm);">
          <div class="mono text-[11px] uppercase mb-2" style="color: var(--color-ink-3); letter-spacing: 0.1em;">{migration.level}: full migration</div>
          <div class="text-2xl font-bold mb-3" style="color: var(--color-ink);">From {fromPrice(migration)}</div>
          <ul class="space-y-2 text-sm leading-relaxed" style="color: var(--color-ink-2);">
            <li>An existing site where every address has to be kept or redirected</li>
            <li>{migration.pages}, delivered in {migration.timescale}</li>
            <li>Every current address kept or redirected and tested</li>
            <li>Staged launch and 30 days of redirect monitoring</li>
          </ul>
        </div>
      </div>
      <p class="text-[13px] mt-6" style="color: var(--color-ink-3);">
        {priceLevels[1].level} is the middle step, from {fromPrice(priceLevels[1])}. {replacement.movesUp} {priceLevels[1].movesUp} The build plan confirms the level and a fixed price before any work starts.
      </p>
      <div class="mt-6">
        <CTA href="/order/?offer=website-redesign-seo-migration" label="Request a Build Plan" analyticsEvent="cta_click" analyticsLabel="migration-compare-build-plan" />
      </div>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4" style="color: var(--color-ink);">How We Protect Existing Rankings</h2>
      <p class="leading-relaxed max-w-3xl mb-6" style="color: var(--color-ink-2);">
        An SEO migration keeps the pages that earn search traffic findable when a website redesign changes the site. It runs in five stages. The old site stays live and unchanged until the launch switch.
      </p>
      <figure class="mb-8" style="overflow-x: auto;">
        <svg viewBox="0 0 720 200" role="img" aria-labelledby="mig-t mig-d" style="width: 100%; min-width: 560px; height: auto; display: block; color: var(--color-ink);">
          <title id="mig-t">SEO migration timeline for a website redesign</title>
          <desc id="mig-d">Five stages in order: inventory every old URL, map each URL to an outcome, test redirects on staging, switch the site and redirects together on launch day, then check Search Console at day 14 and day 30.</desc>
          <line x1="40" y1="120" x2="680" y2="120" stroke="var(--color-rule)" stroke-width="4" />
          <rect x="20" y="40" width="124" height="48" rx="10" fill="var(--color-accent-2)" opacity="0.15" />
          <text x="82" y="62" text-anchor="middle" font-size="15" font-weight="700" fill="currentColor">1. Inventory</text>
          <text x="82" y="80" text-anchor="middle" font-size="12" fill="currentColor">every old URL</text>
          <rect x="158" y="40" width="124" height="48" rx="10" fill="var(--color-accent-2)" opacity="0.15" />
          <text x="220" y="62" text-anchor="middle" font-size="15" font-weight="700" fill="currentColor">2. Map</text>
          <text x="220" y="80" text-anchor="middle" font-size="12" fill="currentColor">keep, 301 or remove</text>
          <rect x="296" y="40" width="124" height="48" rx="10" fill="var(--color-accent-2)" opacity="0.15" />
          <text x="358" y="62" text-anchor="middle" font-size="15" font-weight="700" fill="currentColor">3. Staging</text>
          <text x="358" y="80" text-anchor="middle" font-size="12" fill="currentColor">crawl and redirects</text>
          <rect x="434" y="40" width="124" height="48" rx="10" fill="var(--color-accent)" opacity="0.35" />
          <text x="496" y="62" text-anchor="middle" font-size="15" font-weight="700" fill="currentColor">4. Launch</text>
          <text x="496" y="80" text-anchor="middle" font-size="12" fill="currentColor">site and redirects</text>
          <rect x="572" y="40" width="128" height="48" rx="10" fill="var(--color-accent-2)" opacity="0.15" />
          <text x="636" y="62" text-anchor="middle" font-size="15" font-weight="700" fill="currentColor">5. Monitor</text>
          <text x="636" y="80" text-anchor="middle" font-size="12" fill="currentColor">day 14 and day 30</text>
          <circle cx="82" cy="120" r="6" fill="var(--color-accent-2)" />
          <circle cx="220" cy="120" r="6" fill="var(--color-accent-2)" />
          <circle cx="358" cy="120" r="6" fill="var(--color-accent-2)" />
          <circle cx="496" cy="120" r="9" fill="var(--color-accent)" />
          <circle cx="636" cy="120" r="6" fill="var(--color-accent-2)" />
          <text x="220" y="155" text-anchor="middle" font-size="13" fill="currentColor">Old site live and unchanged</text>
          <text x="496" y="155" text-anchor="middle" font-size="13" fill="currentColor">Day 0</text>
          <text x="636" y="155" text-anchor="middle" font-size="13" fill="currentColor">New site live</text>
        </svg>
        <figcaption class="text-[13px] mt-2 text-center" style="color: var(--color-ink-3);">The five stages of a migration, from the old URL inventory to the day 30 check.</figcaption>
      </figure>
      <div class="grid md:grid-cols-2 gap-4">
        {deliverables.map((d, i) => (
          <div class="rounded-[16px] p-7" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);">
            <div class="flex items-start gap-4">
              <span class="font-extrabold text-lg mt-0.5" style="color: var(--color-accent-2);">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-bold mb-1.5" style="color: var(--color-ink);">{d.title}</h3>
                <p class="text-[14px] leading-relaxed" style="color: var(--color-ink-2);">{d.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="text-[13px] mt-6" style="color: var(--color-ink-3);">
        Migrations carry inherent short-term ranking volatility that Google itself acknowledges, see <a href="https://developers.google.com/search/docs/crawling-indexing/site-move-with-url-changes" target="_blank" rel="noopener noreferrer" style="color: var(--color-accent-2); font-weight: 500;">Google's guidance on site moves with URL changes</a>. This process is built to minimise that volatility, not promise it away.
      </p>
    </section>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4" style="color: var(--color-ink);">Google's Rules for a Site Move and What We Do</h2>
      <p class="leading-relaxed max-w-3xl mb-6" style="color: var(--color-ink-2);">
        Google publishes its own guidance for moving a site with URL changes. Each step of our process follows it. Source: <a href="https://developers.google.com/search/docs/crawling-indexing/site-move-with-url-changes" target="_blank" rel="noopener noreferrer" style="color: var(--color-accent-2); font-weight: 500;">Google Search Central, site moves with URL changes</a>, checked 20 November 2026.
      </p>
      <div class="rounded-[16px] p-7" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); overflow-x: auto;">
        <table class="w-full text-sm leading-relaxed" style="color: var(--color-ink-2); border-collapse: collapse; min-width: 520px;">
          <thead>
            <tr>
              <th class="text-left font-bold pb-3 pr-6" style="color: var(--color-ink); border-bottom: 2px solid var(--color-rule);">Google's guidance</th>
              <th class="text-left font-bold pb-3" style="color: var(--color-ink); border-bottom: 2px solid var(--color-rule);">What we do</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="py-3 pr-6 align-top" style="border-bottom: 1px solid var(--color-rule);">Map the old site's URLs to the new site's URLs.</td>
              <td class="py-3 align-top" style="border-bottom: 1px solid var(--color-rule);">Old URLs are listed from a crawl, the sitemap, Search Console and analytics. Each one gets an outcome before the build starts.</td>
            </tr>
            <tr>
              <td class="py-3 pr-6 align-top" style="border-bottom: 1px solid var(--color-rule);">Use permanent redirects such as 301 or 308 and point each one straight at the final URL.</td>
              <td class="py-3 align-top" style="border-bottom: 1px solid var(--color-rule);">Each mapped redirect is tested on staging and again after launch for chains and loops.</td>
            </tr>
            <tr>
              <td class="py-3 pr-6 align-top" style="border-bottom: 1px solid var(--color-rule);">Do not redirect many old URLs to one unrelated page such as the homepage.</td>
              <td class="py-3 align-top" style="border-bottom: 1px solid var(--color-rule);">A URL with no genuine equivalent returns a 404 or 410 or is rebuilt first.</td>
            </tr>
            <tr>
              <td class="py-3 pr-6 align-top" style="border-bottom: 1px solid var(--color-rule);">Update internal links, canonical tags and sitemaps to the new URLs.</td>
              <td class="py-3 align-top" style="border-bottom: 1px solid var(--color-rule);">Links and canonicals point at new URLs directly and the new sitemap is submitted at launch.</td>
            </tr>
            <tr>
              <td class="py-3 pr-6 align-top">Keep redirects for as long as possible and generally at least 1 year.</td>
              <td class="py-3 align-top">Redirects are monitored for 30 days on a full migration.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[13px] mt-6" style="color: var(--color-ink-3);">
        Google also says a small to medium-sized site can take a few weeks for most pages to move, and that the time varies.
      </p>
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4" style="color: var(--color-ink);">What Counts as a Genuine URL Match?</h2>
      <p class="leading-relaxed max-w-3xl mb-3" style="color: var(--color-ink-2);">
        A redirect only helps if it sends a visitor and a search engine to a page that actually answers the same question as the old one. Redirecting every old URL to your new homepage, or to whichever page seems closest, can get treated as a soft 404 because the destination does not match the intent of the original page.
      </p>
      <p class="leading-relaxed max-w-3xl" style="color: var(--color-ink-2);">
        So each old URL gets one of three outcomes: a 301 redirect to a genuine equivalent, a rebuild on the new site if the content still has value but needs updating, or a proper 404 or 410 if the content has been deliberately removed and nothing on the new site replaces it. Forcing every URL into a redirect is not the goal, matching intent is.
      </p>
      <p class="leading-relaxed max-w-3xl mt-3" style="color: var(--color-ink-2);">
        Mistakes here are slow to undo. Our <a href="/learn/website-redesign-statistics/">website redesign statistics</a> show a median recovery time of 304 days across 1,052 domain migrations in a SALT.agency study published in June 2026.
      </p>
    </section>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4" style="color: var(--color-ink);">Redesign, New Platform or New Domain: What Changes for SEO</h2>
      <p class="leading-relaxed max-w-3xl mb-6" style="color: var(--color-ink-2);">
        A redesign needs redirect work when page addresses change. A platform or hosting change can keep every address. The more that changes at once, the more there is to map and test.
      </p>
      <div class="rounded-[16px] p-7" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm); overflow-x: auto;">
        <table class="w-full text-sm leading-relaxed" style="color: var(--color-ink-2); border-collapse: collapse; min-width: 560px;">
          <thead>
            <tr>
              <th class="text-left font-bold pb-3 pr-6" style="color: var(--color-ink); border-bottom: 2px solid var(--color-rule);">Type of change</th>
              <th class="text-left font-bold pb-3 pr-6" style="color: var(--color-ink); border-bottom: 2px solid var(--color-rule);">What moves</th>
              <th class="text-left font-bold pb-3" style="color: var(--color-ink); border-bottom: 2px solid var(--color-rule);">SEO work needed</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="py-3 pr-6 align-top font-semibold" style="color: var(--color-ink); border-bottom: 1px solid var(--color-rule);">New design, same addresses</td>
              <td class="py-3 pr-6 align-top" style="border-bottom: 1px solid var(--color-rule);">Layout and copy</td>
              <td class="py-3 align-top" style="border-bottom: 1px solid var(--color-rule);">Compare old and new content for pages that rank. Crawl staging before launch.</td>
            </tr>
            <tr>
              <td class="py-3 pr-6 align-top font-semibold" style="color: var(--color-ink); border-bottom: 1px solid var(--color-rule);">New design, new addresses</td>
              <td class="py-3 pr-6 align-top" style="border-bottom: 1px solid var(--color-rule);">Layout, copy and URLs</td>
              <td class="py-3 align-top" style="border-bottom: 1px solid var(--color-rule);">All of the above plus a redirect map with every row tested.</td>
            </tr>
            <tr>
              <td class="py-3 pr-6 align-top font-semibold" style="color: var(--color-ink); border-bottom: 1px solid var(--color-rule);">New platform</td>
              <td class="py-3 pr-6 align-top" style="border-bottom: 1px solid var(--color-rule);">Templates and often metadata. URLs only if they change</td>
              <td class="py-3 align-top" style="border-bottom: 1px solid var(--color-rule);">Content comparison plus checks on canonicals, noindex rules and the sitemap. A redirect map if URLs change.</td>
            </tr>
            <tr>
              <td class="py-3 pr-6 align-top font-semibold" style="color: var(--color-ink);">New domain</td>
              <td class="py-3 pr-6 align-top">Every address on the site</td>
              <td class="py-3 align-top">A full redirect map plus the Change of Address tool in Search Console once the redirects are live.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="leading-relaxed max-w-3xl mt-6" style="color: var(--color-ink-2);">
        Mapping the URLs yourself? The free <a href="/learn/redirect-map-template/">redirect map template</a> has the columns we use and a worked example.
      </p>
    </section>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4" style="color: var(--color-ink);">What Happens on Launch Day</h2>
      <p class="leading-relaxed max-w-3xl" style="color: var(--color-ink-2);">
        Redirects are tested on staging before the domain is switched over, so they are active from the moment the new site goes live rather than added afterwards. Once live, the new sitemap, listing the new site's indexable URLs, is submitted to Google Search Console and Bing Webmaster Tools, and the post-launch monitoring window starts immediately so coverage and position changes are visible from day one, not discovered a month later.
      </p>
      <p class="leading-relaxed max-w-3xl mt-3" style="color: var(--color-ink-2);">
        Running the switch in-house instead? The <a href="/learn/website-redesign-seo-checklist/">website redesign SEO checklist</a> lists every pre-launch, launch-day and post-launch step with a pass test for each.
      </p>
    </section>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4" style="color: var(--color-ink);">Already Redesigned and Lost Rankings?</h2>
      <p class="leading-relaxed max-w-3xl" style="color: var(--color-ink-2);">
        A bad migration can often be repaired. Common causes are missing redirects, redirect chains, lost content and a noindex or canonical mistake on the new pages. The guide to <a href="/learn/recover-rankings-after-site-migration/">recovering rankings after a site migration</a> walks through the five checks in order.
      </p>
      <p class="leading-relaxed max-w-3xl mt-3" style="color: var(--color-ink-2);">
        Recovery is not guaranteed and it starts only after Google recrawls the corrected URLs. The build plan request below takes the old and new addresses if you want the diagnosis done for you.
      </p>
    </section>

    <section class="py-12 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-6" style="color: var(--color-ink);">Who This Fits</h2>
