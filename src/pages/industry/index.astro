---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';
import { industries } from '../../data/industries';

const schemaNodes = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/industry/#page`,
    name: 'SEO Websites by Industry',
    description: 'SEO-optimised website builds tailored to specific industry verticals. Each build uses the architecture, schema, and content patterns that rank in your niche.',
    isPartOf: { '@id': `${site.url}/#website` },
    provider: { '@id': `${site.url}/#organization` }
  },
  {
    '@type': 'ItemList',
    '@id': `${site.url}/industry/#list`,
    name: 'Industry Verticals',
    numberOfItems: industries.length,
    itemListElement: industries.map((ind, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: ind.name,
      url: `${site.url}/industry/${ind.slug}/`
    }))
  }
];
---
<Base
  title="SEO Websites by Industry | OptimisedWebsite"
  description="SEO-optimised website builds tailored to your industry. Health, automotive, ecommerce, hospitality, trades, SaaS, and more. Architecture and schema designed to rank in your vertical."
  canonicalPath="/industry/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Industries', href: '/industry/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">Industry verticals</div>
      <h1 class="section-title">SEO Websites by <span class="gradient-text">Industry</span></h1>
      <p class="section-desc max-w-3xl">
        Every niche has different ranking signals, content structures, and schema requirements. We build websites tailored to the search patterns in your industry — not generic templates with your logo swapped in.
      </p>
    </section>

    <section class="pb-20 grid md:grid-cols-2 lg:grid-cols-3 gap-5 reveal">
      {industries.map((ind) => (
        <a href={`/industry/${ind.slug}/`} class="feat-card group block">
          <h2 class="text-lg font-bold mb-2" style="color: var(--color-ink);">{ind.name}</h2>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--color-ink-2);">{ind.description}</p>
          <span class="text-xs font-semibold uppercase tracking-wide" style="color: var(--color-accent-2);">View details &rarr;</span>
        </a>
      ))}
    </section>

    <div class="signal-break"><div class="signal-line"><div class="signal-dot"></div></div></div>

    <section class="py-16 reveal">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">Same methodology. Tailored execution.</h2>
      <p class="leading-relaxed max-w-3xl mb-8" style="color: var(--color-ink-2);">
        Every industry build follows the same core process — keyword research, topical mapping, schema markup, and technical SEO. The difference is in the page structures, content patterns, and schema types we deploy for your vertical. A health brand needs BuyBox components and YMYL signals. A tradesperson needs location pages and LocalBusiness schema. We build what ranks in your niche.
      </p>
      <div class="flex flex-wrap gap-4">
        <CTA href="/seo-web-design/" label="How the build works" />
        <CTA href="/portfolio/" label="See portfolio" variant="secondary" />
      </div>
    </section>
  </div>
</Base>
