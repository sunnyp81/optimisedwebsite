---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTA from '../../components/CTA.astro';
import RelatedPages from '../../components/RelatedPages.astro';
import Byline from '../../components/Byline.astro';
import StatChart from '../../components/StatChart.astro';
import CiteBlock from '../../components/CiteBlock.astro';
import { site } from '../../data/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('learn');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
// Resolve relatedSlugs across BOTH collections so learn can surface compare
// articles (and vice-versa), matching the hub-and-spoke linking the site sells.
const related = [
  ...(await getCollection('learn')).map((a) => ({ a, collection: 'learn' as const })),
  ...(await getCollection('compare')).map((a) => ({ a, collection: 'compare' as const })),
];

const relatedPages = article.data.relatedSlugs
  .map((slug) => {
    const found = related.find((r) => r.a.id === slug);
    if (!found) return null;
    return { slug: found.a.id, title: found.a.data.title, collection: found.collection };
  })
  .filter(Boolean) as { slug: string; title: string; collection: string }[];

const schemaNodes: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    '@id': `${site.url}/learn/${article.id}/#article`,
    headline: article.data.h1,
    description: article.data.metaDescription,
    datePublished: article.data.datePublished,
    dateModified: article.data.dateModified,
    url: `${site.url}/learn/${article.id}/`,
    isPartOf: { '@id': `${site.url}/#website` },
    author: { '@id': `${site.url}/about/#founder` },
    publisher: { '@id': `${site.url}/#organization` },
    about: {
      '@type': 'Thing',
      name: 'SEO-optimised website',
      sameAs: [
        'https://en.wikipedia.org/wiki/Search_engine_optimization',
        'https://www.wikidata.org/wiki/Q180711',
      ],
    },
    mainEntityOfPage: `${site.url}/learn/${article.id}/`,
  },
];

if (article.data.faqs.length > 0) {
  schemaNodes.push({
    '@type': 'FAQPage',
    '@id': `${site.url}/learn/${article.id}/#faq`,
    mainEntity: article.data.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  });
}

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Learn', href: '/learn/' },
  { label: article.data.title, href: `/learn/${article.id}/` },
];

// Charts and the citation block render after the article body so the answer-first opening stays first.
const hasCharts = article.data.charts.length > 0;
const showCitation = article.data.citation;
const { glance, serviceCta } = article.data;
---
<Base
  title={article.data.metaTitle}
  description={article.data.metaDescription}
  canonicalPath={`/learn/${article.id}/`}
  schemaNodes={schemaNodes}
>
  <article class="max-w-[800px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={breadcrumbs} />
    <h1 class="section-title mb-4">{article.data.h1}</h1>
    <Byline />
    {glance && (
      <section class="rounded-[16px] p-6 md:p-7 mb-10" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-rule), var(--shadow-sm);" aria-labelledby="glance-h">
        <p id="glance-h" class="eyebrow violet mb-4">At a glance</p>
        {glance.image && (
          <figure class="mb-5">
            <img src={glance.image.src} alt={glance.image.alt} width="1200" height="675" loading="eager" decoding="async" class="block w-full h-auto rounded-[12px]" style="box-shadow: inset 0 0 0 1px var(--color-rule);" />
            <figcaption class="mt-2 text-[13px]" style="color: var(--color-ink-3);">{glance.image.caption}</figcaption>
          </figure>
        )}
        <ol class="space-y-3 list-none p-0 m-0">
          {glance.points.map((point, i) => (
            <li class="flex gap-4 text-[15px] leading-relaxed" style="color: var(--color-ink-2);">
              <span class="font-extrabold shrink-0" style="color: var(--color-accent-2);">{String(i + 1).padStart(2, '0')}</span>
              <span>{point}</span>
            </li>
          ))}
        </ol>
        {glance.action && (
          <div class="mt-5"><CTA href={glance.action.href} label={glance.action.label} variant="secondary" analyticsEvent="download_click" analyticsLabel={`glance-${article.id}`} /></div>
        )}
      </section>
    )}
    <div class:list={["prose prose-lg max-w-none", { "learn-steps": glance }]}>
      <Content />
    </div>
    {serviceCta && (
      <section class="rounded-[16px] p-6 md:p-7 mt-10" style="background: var(--color-paper); box-shadow: inset 0 0 0 1px var(--color-accent-2), var(--shadow-sm);">
        <p class="text-lg font-bold mb-4" style="color: var(--color-ink);">{serviceCta.heading}</p>
        <CTA href={serviceCta.href} label={serviceCta.label} analyticsEvent="cta_click" analyticsLabel={`learn-${article.id}-build-plan`} />
      </section>
    )}
    {hasCharts && (
      <div class="stat-charts-block">
        {article.data.charts.map((chart) => <StatChart {...chart} />)}
      </div>
    )}
    {showCitation && (
      <CiteBlock
        title={article.data.title}
        url={`${site.url}/learn/${article.id}/`}
        dateModified={article.data.dateModified}
        csvHref={`/downloads/${article.id}.csv`}
      />
    )}
    {article.data.faqs.length > 0 && <FAQSection faqs={article.data.faqs} />}
    <div class="flex flex-wrap gap-4 mt-10">
      <CTA href="/free-website-growth-review/" label="Get a Free Growth Review" analyticsEvent="cta_click" analyticsLabel="learn-article" />
      <CTA href={article.data.hubBacklink.href} label={article.data.hubBacklink.anchor} variant="secondary" />
    </div>
    <RelatedPages pages={relatedPages} />
  </article>
</Base>
