---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import CTA from '../components/CTA.astro';
import PriceLadder from '../components/PriceLadder.astro';
import MigrationPrices from '../components/MigrationPrices.astro';
import { ladderOffers } from '../data/pricing';
import { site } from '../data/site';

const deliverables = [
  {
    category: 'Keyword Research and Competitive Strategy',
    prose: 'Every build starts with competitive keyword research. We identify 50-200 viable target terms, cluster them by search intent, and map them into a hub-and-spoke site architecture.',
    items: [
      'Keyword research (50-200 terms, clustered by intent)',
      'Topical map with hub-and-spoke architecture',
      'Competitor gap analysis against top 3 ranking sites',
      'Content depth ratio targets per cluster',
      'Internal linking blueprint with anchor text rules'
    ]
  },
  {
    category: 'Content Writing for Every Page',
    prose: 'All copy is written from scratch against your target keywords. Each page has a unique H1, meta title under 60 characters, and heading hierarchy designed for both readers and crawlers.',
    items: [
      'Original, keyword-targeted content for every page in your plan',
      'Unique H1 and meta title/description per page',
      'Semantic heading structure (H1 > H2 > H3)',
      'FAQ sections where People Also Ask results exist',
      'Hub pages with spoke navigation',
      'About and Contact pages included'
    ]
  },
  {
    category: 'Technical SEO Setup and Schema Markup',
    prose: 'Schema markup covers 7 to 12 entity types per site including Organisation, WebSite, Article, FAQPage, and BreadcrumbList. Every page validates against Google’s Rich Results Test.',
    items: [
      'Per-page JSON-LD schema within @graph',
      'Entity-interconnected schema (Organisation, WebSite, Service, Article, FAQPage, HowTo, BreadcrumbList)',
      'Canonical URLs on every page',
      'XML sitemap and sitemap index',
      'robots.txt, llms.txt, and ai.txt configuration',
      'Heading hierarchy validation',
      'Semantic HTML5 landmarks',
      'Skip-to-content and focus-visible accessibility'
    ]
  },
  {
    category: 'Internal Linking Architecture',
    prose: 'Pages link to their parent hub using descriptive anchor text. This distributes ranking authority and helps crawlers discover your full site structure.',
    items: [
      'Hub-to-spoke links from every hub page',
      'Spoke-to-hub backlinks in every spoke',
      'Sibling cross-links between related spokes',
      'No links in first paragraph of body content',
      'Descriptive anchor text (no "click here" or naked URLs)',
      'Link density kept below 3% of word count'
    ]
  },
  {
    category: 'Site Performance and Edge Hosting',
    prose: 'Sites deploy to Cloudflare’s global edge network. Astro outputs static HTML by default, images are compressed, and client-side JavaScript is kept to features that justify it.',
    items: [
      'Cloudflare Pages CDN deployment (or Vercel)',
      'Static HTML: no server-side rendering overhead',
      'Core Web Vitals optimised (LCP, CLS, INP)',
      'OG images generated per page',
      'WebP/AVIF image formats where applicable',
      'Critical CSS inlined, no render-blocking resources',
      'Mobile-first responsive design',
      'Configurable brand colours, fonts, and logos'
    ]
  },
  {
    category: 'Deployment and Search Engine Submission',
    prose: 'We submit your sitemap to Google Search Console and Bing Webmaster Tools on launch day. IndexNow pings accelerate Bing discovery.',
    items: [
      'GitHub repository with full source code',
      'Google Search Console verification and sitemap submission',
      'Bing Webmaster Tools verification and IndexNow ping',
      'Schema validation report (zero errors)',
      'Page inventory spreadsheet with URLs, titles, word counts'
    ]
  },
  {
    category: 'Post-Launch Support and Revision Window',
    prose: 'Every level includes 30 days of revisions after launch and Search Console checks at day 14 and day 30. Full migrations add 30 days of redirect monitoring in Google and Bing after the move.',
    items: [
      '30 days of revisions for content tweaks and schema fixes',
      'GSC baseline snapshot at day 14 and day 30',
      'Keyword tracking setup with target positions'
    ]
  }
];

const faqs = [
  { q: 'Why is each level a price range?', a: 'Four requirements set the level: page count, number of premises, the size of any existing site, and any booking or CRM tool to connect. Within a level, the price depends on page count and research depth. You get one fixed price in a written build plan before work starts.' },
  { q: 'What moves a project up a level?', a: 'More than 25 pages, a second premises, or editing by your team moves a project from Level 1 to Level 2. More than 100 pages of new content, more than 5 premises, a booking or CRM hookup, or an existing site of more than 300 addresses moves it to Level 3. A 100 to 300 page site that moves with the same content is priced as a migration from £4,950.' },
  { q: 'How long does each level take?', a: 'A local site takes 1 to 2 weeks, a growth site 3 to 5 weeks, and a multi-location or large site 6 to 12 weeks. Migrating an existing site of up to 300 pages takes 2 to 8 weeks. The timescale is written into your build plan before work starts.' },
  { q: 'Are there any ongoing fees after delivery?', a: 'No fees are due to us after delivery. You pay once for the build and own the site outright, with no CMS licences or mandatory retainers. Cloudflare Pages and Vercel both offer free tiers that suit most static sites. A team editing system at Level 2 or Level 3 can carry a third-party running cost. Your build plan confirms that cost. Ongoing SEO support is available as a separate engagement if you want it.' },
  { q: 'What is not included in the price?', a: 'The price covers everything listed for your level. It does not include paid advertising setup, social media management, link building campaigns, photography, changes to third-party booking tools, or ongoing content writing beyond the initial build. These are quoted separately.' },
  { q: 'How do I pay?', a: 'Level 1 and Level 2 builds are paid in two halves: half to start and half on launch. Level 3 projects are paid in stages set out in your build plan. The usual split is half at design approval and half on launch. Payment for a migration is set out in your build plan. Payment is by bank transfer or card invoice.' }
];

const schemaNodes = [
  {
    '@type': 'Service',
    '@id': `${site.url}/pricing/#service`,
    name: 'SEO Website Build',
    description: 'Ground-up SEO-optimised website build with keyword research, topical mapping, content writing, schema markup, and deployment.',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    offers: ladderOffers(`${site.url}/pricing/`)
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/pricing/#faq`,
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a }
    }))
  }
];
---
<Base
  title="SEO Website Pricing: 3 Levels From £1,500 | OptimisedWebsite"
  description="SEO website pricing in three levels: local sites £1,500 to £3,000, growth sites £3,000 to £6,000, large sites £6,000 to £15,000. Migration from £2,000."
  canonicalPath="/pricing/"
  schemaNodes={schemaNodes}
>
  <div class="max-w-[1100px] mx-auto px-5 md:px-10 pt-28 pb-20">
    <Breadcrumb items={[
      { label: 'Home', href: '/' },
      { label: 'Pricing', href: '/pricing/' }
    ]} />

    <section class="py-12">
      <div class="section-tag">Pricing</div>
      <h1 class="section-title">SEO Website Pricing</h1>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-ink-2);">
        SEO website builds cost <strong style="color: var(--color-ink);">&pound;1,500 to &pound;15,000</strong> across three levels. The work the site needs sets the level. Your price is fixed in a written build plan before work starts.
      </p>
      <div class="mt-8">
        <PriceLadder headingTag="h2" />
      </div>
    </section>

    <section class="py-8" style="border-top: 1px solid var(--color-rule);">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">What Moves a Project Up a Level</h2>
      <p class="text-[15px] leading-[1.65] mb-6 max-w-3xl" style="color: var(--color-ink-2);">Four requirements set the level: pages, premises, the existing site and connected tools. Timescale follows from them.</p>
      <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Requirements by level">
        <table class="w-full text-left border-collapse min-w-[620px] text-[15px]">
          <thead>
            <tr style="border-bottom: 2px solid var(--color-rule);">
              <th class="py-3 pr-4 font-semibold">Requirement</th>
              <th class="py-3 pr-4 font-semibold">Level 1</th>
              <th class="py-3 pr-4 font-semibold">Level 2</th>
              <th class="py-3 font-semibold">Level 3</th>
            </tr>
          </thead>
          <tbody style="color: var(--color-ink-2);">
            <tr style="border-bottom: 1px solid var(--color-rule);"><th scope="row" class="py-3 pr-4 font-medium" style="color: var(--color-ink);">Pages</th><td class="py-3 pr-4">Up to 25</td><td class="py-3 pr-4">25 to 100</td><td class="py-3">100 pages of new content or more</td></tr>
            <tr style="border-bottom: 1px solid var(--color-rule);"><th scope="row" class="py-3 pr-4 font-medium" style="color: var(--color-ink);">Premises</th><td class="py-3 pr-4">One. Towns you travel to count as service areas</td><td class="py-3 pr-4">2 to 5</td><td class="py-3">More than 5</td></tr>
            <tr style="border-bottom: 1px solid var(--color-rule);"><th scope="row" class="py-3 pr-4 font-medium" style="color: var(--color-ink);">Existing site</th><td class="py-3 pr-4">New site or small replacement</td><td class="py-3 pr-4">Replacement with a short redirect list</td><td class="py-3">More than 300 addresses kept or redirected and tested</td></tr>
            <tr style="border-bottom: 1px solid var(--color-rule);"><th scope="row" class="py-3 pr-4 font-medium" style="color: var(--color-ink);">Connected tools</th><td class="py-3 pr-4">Contact form</td><td class="py-3 pr-4">Contact form and team editing</td><td class="py-3">Booking or CRM hookup, team editing with training</td></tr>
            <tr><th scope="row" class="py-3 pr-4 font-medium" style="color: var(--color-ink);">Timescale</th><td class="py-3 pr-4">1 to 2 weeks</td><td class="py-3 pr-4">3 to 5 weeks</td><td class="py-3">6 to 12 weeks</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="py-8" id="migration-prices" style="border-top: 1px solid var(--color-rule);">
      <h2 class="text-2xl font-bold tracking-[-0.02em] mb-4">How Much a Website Migration Costs</h2>
      <p class="text-[15px] leading-[1.65] mb-6 max-w-3xl" style="color: var(--color-ink-2);">A full migration costs from £2,000 including the new site. The price follows the size of your existing site.</p>
      <MigrationPrices />
    </section>

    <section class="pt-8">
      <h2 class="text-2xl font-bold tracking-[-0.02em]">What Every Level Includes</h2>
    </section>

    {deliverables.map(group => (
      <section class="py-8" style="border-top: 1px solid var(--color-rule);">
        <h3 class="text-xl font-bold tracking-[-0.02em] mb-4">{group.category}</h3>
        <p class="text-[15px] leading-[1.65] mb-6" style="color: var(--color-ink-2);">{group.prose}</p>
        <ul class="space-y-2 leading-relaxed" style="color: var(--color-ink-2);">
          {group.items.map(item => (
            <li class="flex gap-2"><span class="shrink-0" style="color: var(--color-accent-2);">&#10003;</span> {item}</li>
          ))}
        </ul>
      </section>
    ))}

    <section class="py-10 text-center">
      <p class="mb-4" style="color: var(--color-ink-2);">Every level includes every item listed above. Level 2 adds a full topic map, custom page templates and team editing. Level 3 adds full redirects, a booking or CRM hookup and training.</p>
      <CTA href="/order/" label="Get Your Free Build Plan" />
    </section>

    <FAQSection faqs={faqs} />
  </div>
</Base>
